}

.ee4v-asset-manager-three-pane--navigation .ee4v-asset-manager-three-pane__pane--left,
.ee4v-asset-manager-three-pane--main .ee4v-asset-manager-three-pane__pane--main,
.ee4v-asset-manager-three-pane--information .ee4v-asset-manager-three-pane__pane--right {
