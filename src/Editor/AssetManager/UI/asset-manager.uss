@import url("../../UI/Foundation/ui-design-tokens.uss");
@import url("../../UI/Components/Content/Icon/icon.uss");
@import url("../../UI/Components/Content/InfoCard/info-card.uss");
@import url("../../UI/Components/Collections/SearchableTreeView/searchable-tree-view.uss");
@import url("../../UI/Components/Inputs/InputField/input-field.uss");
@import url("../../UI/Components/Inputs/SearchField/search-field.uss");

.ee4v-asset-manager-control-field.ee4v-ui-form-input {
    align-self: stretch;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-control-field > .ee4v-ui-form-input__input {
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

.ee4v-asset-manager-control-field__input.ee4v-ui-input-field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__item-metadata-field {
    min-width: 0;
    align-self: stretch;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__item-metadata-field.ee4v-ui-form-input {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-asset-manager__item-metadata-field > .ee4v-ui-form-input__input {
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-asset-manager__item-metadata-field > .ee4v-ui-form-input__label,
.ee4v-asset-manager__item-metadata-field > .ee4v-asset-manager-control-field__label {
    align-self: flex-start;
    margin-right: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager__description-field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__description-field .ee4v-ui-input-field__field-container {
    min-height: 144px;
    height: 144px;
    max-height: 144px;
}

.ee4v-asset-manager-controls-story > * {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__icon-button.ee4v-ui-button {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    padding: var(--ee4v-space-none);
}

.ee4v-asset-manager {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--ee4v-color-panel);
    position: relative;
}

.ee4v-asset-manager__navigation {
    flex-grow: 1;
    min-height: 0;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    background-color: var(--ee4v-color-panel);
}

.ee4v-asset-manager__navigation-content {
    flex-grow: 1;
    min-height: 100%;
}

.ee4v-asset-manager__nav-primary {
    padding-bottom: var(--ee4v-space-xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager__collection-section {
    min-width: 0;
    margin-top: var(--ee4v-space-2xl);
}

.ee4v-asset-manager__collection-header {
    min-height: var(--ee4v-size-28);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button {
    min-height: var(--ee4v-size-24);
    margin: 0;
    padding: 0 var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:focus {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__collection-empty {
    padding: var(--ee4v-space-md) var(--ee4v-space-xl);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button  {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 32px;
    min-height: 32px;
    margin: 0 0 var(--ee4v-space-xs);
    padding: 0 var(--ee4v-space-lg);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__text {
    flex-direction: row;
    align-items: center;
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__title {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__icon {
    margin-right: var(--ee4v-space-lg);
    opacity: 0.65;
}

.ee4v-asset-manager__nav-button:hover .ee4v-ui-item-row__icon,
.ee4v-asset-manager__nav-button.ee4v-ui-navigation-item--selected .ee4v-ui-item-row__icon {
    opacity: 1;
}

.ee4v-asset-manager__collection-count {
    flex-shrink: 0;
    min-width: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-md);
    -unity-text-align: middle-right;
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button.ee4v-asset-manager__collection-row  {
    background-image: none;
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__collection-row:active {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__collection-row:focus {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__collection-row.ee4v-asset-manager__collection-dragging,
.ee4v-asset-manager__navigation .ee4v-asset-manager__collection-row.ee4v-asset-manager__collection-dragging:hover,
.ee4v-asset-manager__navigation .ee4v-asset-manager__collection-row.ee4v-asset-manager__collection-dragging:active {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__collection-insertion-line {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--ee4v-border-hairline);
    background-color: var(--ee4v-color-focus);
    display: none;
}

.ee4v-asset-manager__file-button .ee4v-ui-button__label {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    height: var(--ee4v-control-height-toolbar);
    min-height: var(--ee4v-control-height-toolbar);
    max-height: var(--ee4v-control-height-toolbar);
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    border-bottom-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__leading,
.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__actions {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__actions {
    justify-content: flex-end;
}

.ee4v-asset-manager__history-navigation {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ee4v-asset-manager__history-button {
    flex-shrink: 0;
    width: var(--ee4v-size-22);
    min-width: var(--ee4v-size-22);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__history-button:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__search {
    flex-shrink: 1;
    width: 160px;
    min-width: 100px;
    margin-left: var(--ee4v-space-sm);
    margin-right: var(--ee4v-space-xxs);
}

.ee4v-asset-manager__toolbar-actions {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.ee4v-asset-manager__toolbar Button {
    min-height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-xxs);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__grid-controls {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 162px;
    min-width: 162px;
    max-width: 162px;
}

.ee4v-asset-manager__grid-size-slider {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager__sort,
.ee4v-asset-manager__filter,
.ee4v-asset-manager__reload {
    flex-shrink: 0;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__sort:hover,
.ee4v-asset-manager__filter:hover,
.ee4v-asset-manager__reload:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__sort:active,
.ee4v-asset-manager__filter:active,
.ee4v-asset-manager__reload:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__filter--active.ee4v-ui-button,
.ee4v-asset-manager__filter--active.ee4v-ui-button:hover,
.ee4v-asset-manager__filter--active.ee4v-ui-button:active,
.ee4v-ui Button.ee4v-asset-manager__filter--active:focus {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    overflow: hidden;
}

.ee4v-asset-manager__file-list {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-manager__empty-state.ee4v-ui-empty-state {
    border-width: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__empty-state > .ee4v-ui-empty-state__actions {
    display: none;
}

.ee4v-asset-manager__tag-list {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager__tag-list-toolbar {
    min-width: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-asset-manager__tag-list-search.ee4v-ui-search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-asset-manager__tag-list-search.ee4v-ui-search-field:hover {
    border-color: var(--ee4v-color-border-default);
}

.ee4v-asset-manager__tag-list-search.ee4v-ui-search-field--focused,
.ee4v-asset-manager__tag-list-search.ee4v-ui-search-field--focused:hover {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__tag-list-metadata {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-asset-manager__tag-list-sort {
    flex-shrink: 0;
    flex-direction: row;
}

.ee4v-asset-manager__tag-sort-choice.ee4v-ui-button {
    min-height: var(--ee4v-size-24);
    margin: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-bottom-color: var(--ee4v-color-transparent);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__tag-sort-choice.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-transparent);
    border-bottom-color: var(--ee4v-color-border-active);
}

.ee4v-asset-manager__tag-sort-choice--selected.ee4v-ui-button,
.ee4v-asset-manager__tag-sort-choice--selected.ee4v-ui-button:hover {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__tag-sort-choice.ee4v-ui-button:focus {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__tag-list-scroll {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-manager__tag-list-scroll .unity-scroll-view__content-container {
    width: 100%;
    min-width: 0;
}

.ee4v-asset-manager__tag-pills,
.ee4v-asset-manager__tag-group-pills {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    align-items: flex-start;
    min-width: 0;
}

.ee4v-asset-manager__tag-pills {
    padding-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__tag-pills--grouped {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
}

.ee4v-asset-manager__tag-group {
    min-width: 0;
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-asset-manager__tag-group-heading {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-asset-manager__tag-pill-context {
    min-width: 0;
    flex-shrink: 2;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-asset-manager__tag-pill-count {
    flex-shrink: 0;
    min-width: 12px;
    margin-left: var(--ee4v-space-md);
    -unity-text-align: middle-right;
}

.ee4v-asset-manager__collection-popup-form {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-xl);
}

.ee4v-asset-manager__collection-popup-form .unity-scroll-view__content-container {
    width: 100%;
    min-width: 0;
}

.ee4v-asset-manager-filter-editor,
.ee4v-asset-manager__collection-popup-group,
.ee4v-asset-manager__collection-popup-condition {
    min-width: 0;
}

.ee4v-asset-manager__collection-popup-conditions-title {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-asset-manager__collection-icon-choices {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__collection-icon-choice.ee4v-ui-button {
    width: var(--ee4v-size-28);
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    margin-right: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-xs);
    padding: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-asset-manager__collection-icon-choice.ee4v-ui-button:focus {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__collection-icon-choice.ee4v-ui-button.ee4v-asset-manager__collection-icon-choice--selected,
.ee4v-asset-manager__collection-icon-choice.ee4v-ui-button.ee4v-asset-manager__collection-icon-choice--selected:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__collection-popup-group {
    margin-bottom: var(--ee4v-space-sm);
    padding: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager__collection-popup-group--root {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__collection-popup-group--nested {
    padding: var(--ee4v-space-lg);
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-panel);
}

.ee4v-asset-manager__collection-popup-group--nested > .ee4v-asset-manager__collection-popup-group-header {
    padding: var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-asset-manager__collection-popup-group-title {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-md);
    white-space: nowrap;
}

.ee4v-asset-manager__collection-popup-group-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__collection-popup-group-header > .ee4v-ui-action-bar__leading {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex-wrap: wrap;
}

.ee4v-asset-manager__collection-popup-condition-type > .ee4v-ui-form-input__input {
    width: auto;
}

.ee4v-asset-manager__collection-popup-group-inverted {
    flex-shrink: 0;
    align-self: center;
    margin-left: var(--ee4v-space-lg);
    margin-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager__collection-popup-remove-group {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    flex-shrink: 0;
    padding: var(--ee4v-space-none);
}

.ee4v-asset-manager__collection-popup-group-children {
    min-width: 0;
}

.ee4v-asset-manager__collection-popup-group-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--ee4v-space-md);
}

.ee4v-asset-manager__collection-popup-group-actions .ee4v-ui-button {
    margin: var(--ee4v-space-xs);
}

.ee4v-asset-manager__collection-popup-condition {
    margin-bottom: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-md);
    padding-bottom: var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-asset-manager__collection-popup-condition-controls {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-asset-manager__collection-popup-condition-type.ee4v-ui-form-input {
    flex-grow: 0;
    flex-shrink: 1;
    width: 154px;
    min-width: 0;
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__collection-popup-condition-inverted {
    flex-shrink: 0;
    align-self: flex-start;
    margin-left: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager__collection-popup-remove-condition {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    flex-shrink: 0;
    padding: var(--ee4v-space-none);
    margin-left: var(--ee4v-space-sm);
}

.ee4v-asset-manager-filter-editor__value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: var(--ee4v-space-md);
}

.ee4v-asset-manager-filter-editor__match-modes {
    flex-direction: row;
    flex-shrink: 0;
    padding: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager-filter-editor__match-modes .ee4v-ui-button {
    margin: 0;
    border-width: 0;
}

.ee4v-asset-manager-filter-editor__match-modes .ee4v-asset-manager-filter-editor__match--selected {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager-filter-editor__empty {
    align-items: center;
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
}

.ee4v-asset-manager-filter-editor__add-label {
    margin-right: var(--ee4v-space-md);
    white-space: nowrap;
