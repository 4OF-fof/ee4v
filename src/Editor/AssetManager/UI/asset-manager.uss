    min-width: 0;
    height: var(--ee4v-control-height-toolbar);
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
}

.ee4v-asset-manager-three-pane__body {
