@import url("../../UI/Foundation/ui-design-tokens.uss");
@import url("../../UI/Components/Content/Icon/icon.uss");
@import url("../../UI/Components/Content/InfoCard/info-card.uss");
@import url("../../UI/Components/Collections/SearchableTreeView/searchable-tree-view.uss");
@import url("../../UI/Components/Inputs/InputField/input-field.uss");
@import url("../../UI/Components/Inputs/SearchField/search-field.uss");

.ee4v-asset-manager-control-field.ee4v-ui-form-input {
    align-self: stretch;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-control-field > .ee4v-ui-form-input__input {
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

.ee4v-asset-manager-control-field__input.ee4v-ui-input-field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__item-metadata-field {
    min-width: 0;
    align-self: stretch;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__item-metadata-field.ee4v-ui-form-input {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-asset-manager__item-metadata-field > .ee4v-ui-form-input__input {
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-asset-manager__item-metadata-field > .ee4v-ui-form-input__label,
.ee4v-asset-manager__item-metadata-field > .ee4v-asset-manager-control-field__label {
    align-self: flex-start;
    margin-right: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__container {
    position: relative;
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    height: var(--ee4v-control-height-default);
    flex-direction: row;
    align-items: stretch;
    align-self: stretch;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    transition-property: border-bottom-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__container:hover {
    border-bottom-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager-control-field--enum.ee4v-asset-manager-control-field--focused .ee4v-asset-manager-control-field__container {
    border-bottom-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__input {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__input .unity-base-field__label,
.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__input .unity-text-field__label {
    display: none;
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__input .unity-base-field__input {
    min-height: 0;
    height: auto;
    max-height: 10000px;
    flex-grow: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    font-size: var(--ee4v-font-size-body);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-field--enum .ee4v-asset-manager-control-field__input .unity-text-element {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__description-field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__description-field .ee4v-ui-input-field__field-container {
    min-height: 144px;
    height: 144px;
    max-height: 144px;
}

.ee4v-asset-manager-tag-field {
    width: 100%;
    min-width: 0;
}

.ee4v-asset-manager-tag-field__tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: var(--ee4v-space-negative-xs);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-tag-field__tag {
    margin-right: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-tag-field__add.ee4v-ui-button {
    width: 100%;
    min-height: var(--ee4v-control-height-default);
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-asset-manager-tag-field__add.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-asset-manager-tag-picker__body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-xl);
}

.ee4v-asset-manager-tag-picker__search {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-asset-manager-tag-picker__content {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-manager-tag-picker__tags {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.ee4v-asset-manager-tag-picker__tag.ee4v-ui-tag-pill {
    height: var(--ee4v-size-24);
    min-height: var(--ee4v-size-24);
    margin-right: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
}

.ee4v-asset-manager-tag-picker__tag--create.ee4v-ui-tag-pill {
    background-color: var(--ee4v-color-tag-create);
}

.ee4v-asset-manager-tag-picker__tag--create.ee4v-ui-tag-pill:hover {
    background-color: var(--ee4v-color-tag-create-hover);
}

.ee4v-asset-manager-tag-picker__empty {
    width: 100%;
    margin-top: var(--ee4v-size-20);
    color: var(--ee4v-color-text-muted);
    -unity-text-align: middle-center;
}

.ee4v-asset-manager-grid-slider {
    flex-direction: row;
    align-items: center;
    width: 162px;
    min-width: 72px;
    height: var(--ee4v-control-height-default);
    min-height: var(--ee4v-control-height-default);
    max-height: var(--ee4v-control-height-default);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
}

.ee4v-asset-manager-grid-slider__endpoint {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    max-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-transparent);
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
}

.ee4v-asset-manager-grid-slider__endpoint:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager-grid-slider__endpoint:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager-grid-slider__slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: var(--ee4v-size-24);
    height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-md);
    margin-right: var(--ee4v-space-md);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-field__label {
    display: none;
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__input {
    min-width: 0;
    margin: var(--ee4v-space-none);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__tracker {
    height: var(--ee4v-size-2);
    min-height: var(--ee4v-size-2);
    max-height: var(--ee4v-size-2);
    border-width: 0;
    background-color: var(--ee4v-color-slider-track);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__dragger-border {
    display: none;
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__dragger {
    width: var(--ee4v-size-11);
    min-width: var(--ee4v-size-11);
    max-width: var(--ee4v-size-11);
    height: var(--ee4v-size-11);
    min-height: var(--ee4v-size-11);
    max-height: var(--ee4v-size-11);
    border-width: 0;
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-control-highlight);
}

.ee4v-asset-manager-grid-slider:hover .unity-base-slider__tracker {
    background-color: var(--ee4v-color-slider-track-hover);
}

.ee4v-asset-manager-grid-slider:hover .unity-base-slider__dragger {
    background-color: var(--ee4v-color-slider-knob-hover);
}

.ee4v-asset-manager-control-notice {
    min-width: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--ee4v-space-md);
    padding: var(--ee4v-space-md);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-emphasis);
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-info);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-control-notice__icon {
    width: var(--ee4v-size-18);
    min-width: var(--ee4v-size-18);
    margin-right: var(--ee4v-space-sm);
    flex-shrink: 0;
}

.ee4v-asset-manager-control-notice__text {
    min-width: 0;
    flex-grow: 1;
    white-space: normal;
}

.ee4v-asset-manager-controls-story > * {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager__icon-button.ee4v-ui-button {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    padding: var(--ee4v-space-none);
}

.ee4v-asset-manager {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--ee4v-color-panel);
    position: relative;
}

.ee4v-asset-manager__navigation {
    flex-grow: 1;
    min-height: 0;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    background-color: var(--ee4v-color-panel);
}

.ee4v-asset-manager__navigation-content {
    flex-grow: 1;
    min-height: 100%;
}

.ee4v-asset-manager__nav-primary {
    padding-bottom: var(--ee4v-space-xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager__collection-section {
    min-width: 0;
    margin-top: var(--ee4v-space-2xl);
}

.ee4v-asset-manager__collection-header {
    min-height: var(--ee4v-size-28);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button {
    min-height: var(--ee4v-size-24);
    margin: 0;
    padding: 0 var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:focus {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__collection-create.ee4v-ui-button:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__collection-empty {
    padding: var(--ee4v-space-md) var(--ee4v-space-xl);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 32px;
    min-height: 32px;
    margin: 0 0 var(--ee4v-space-xs);
    padding: 0 var(--ee4v-space-lg);
    border-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-emphasis);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-transparent);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button--selected,
.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button--selected:hover {
    border-left-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button:focus {
    border-bottom-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__text {
    flex-direction: row;
    align-items: center;
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__title {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__nav-button .ee4v-ui-item-row__icon {
    margin-right: var(--ee4v-space-lg);
    opacity: 0.65;
}

.ee4v-asset-manager__nav-button:hover .ee4v-ui-item-row__icon,
.ee4v-asset-manager__nav-button--selected .ee4v-ui-item-row__icon {
    opacity: 1;
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button.ee4v-asset-manager__collection-drop-before {
    border-top-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__navigation .ee4v-asset-manager__nav-button.ee4v-asset-manager__collection-drop-after {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__file-button .ee4v-ui-button__label {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    height: var(--ee4v-control-height-toolbar);
    min-height: var(--ee4v-control-height-toolbar);
    max-height: var(--ee4v-control-height-toolbar);
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    border-bottom-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__leading,
.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__actions {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-asset-manager__toolbar > .ee4v-ui-action-bar__actions {
    justify-content: flex-end;
}

.ee4v-asset-manager__history-navigation {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ee4v-asset-manager__history-button {
    flex-shrink: 0;
    width: var(--ee4v-size-22);
    min-width: var(--ee4v-size-22);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__history-button:hover,
.ee4v-asset-manager__breadcrumbs:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__breadcrumbs {
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    margin-left: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    border-radius: var(--ee4v-radius-lg);
    overflow: hidden;
}

.ee4v-asset-manager__breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-manager__breadcrumb-current {
    flex-shrink: 1;
    color: var(--ee4v-color-text-soft);
}

.ee4v-asset-manager__breadcrumb-tooltip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    min-height: var(--ee4v-size-28);
    padding: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-overlay-border);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-asset-manager__breadcrumb-tooltip-button {
    min-width: 0;
    min-height: var(--ee4v-size-20);
    margin: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-width: 0;
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__breadcrumb-tooltip-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__breadcrumb-tooltip-button .ee4v-ui-button__typography-label,
.ee4v-asset-manager__breadcrumb-tooltip-current {
    white-space: nowrap;
}

.ee4v-asset-manager__breadcrumb-tooltip-current {
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    color: var(--ee4v-color-text-soft);
}

.ee4v-asset-manager__breadcrumb-tooltip-separator {
    flex-shrink: 0;
    color: var(--ee4v-color-text-muted);
}

.ee4v-asset-manager__search {
    flex-shrink: 1;
    width: 160px;
    min-width: 100px;
    margin-left: var(--ee4v-space-sm);
    margin-right: var(--ee4v-space-xxs);
}

.ee4v-asset-manager__toolbar-actions {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.ee4v-asset-manager__toolbar Button,
.ee4v-asset-manager__actions Button {
    min-height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-xxs);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__grid-controls {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 162px;
    min-width: 162px;
    max-width: 162px;
}

.ee4v-asset-manager__grid-size-slider {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager__sort,
.ee4v-asset-manager__reload {
    flex-shrink: 0;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__sort:hover,
.ee4v-asset-manager__reload:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__sort:active,
.ee4v-asset-manager__reload:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__primary-action {
    border-color: var(--ee4v-color-selection);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__primary-action:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

