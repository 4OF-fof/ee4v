}

.ee4v-asset-manager__nav-button .ee4v-asset-manager-control-button__label,
.ee4v-asset-manager__file-button .ee4v-asset-manager-control-button__label,
.ee4v-asset-manager__list-row .ee4v-asset-manager-control-button__label {
