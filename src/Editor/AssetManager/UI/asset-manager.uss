}

.ee4v-asset-manager__toolbar {
    flex-grow: 1;
    min-width: 0;
    height: var(--ee4v-control-height-toolbar);
    flex-direction: row;
    align-items: center;
}

.ee4v-asset-manager__heading {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ee4v-asset-manager__title {
    flex-shrink: 1;
    min-width: 0;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-manager__detail-title {
    font-size: var(--ee4v-font-size-subtitle);
    -unity-font-style: bold;
}

.ee4v-asset-manager__count {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
    font-size: var(--ee4v-font-size-small);
    color: var(--ee4v-color-text-muted);
}

.ee4v-asset-manager__search {
    flex-shrink: 1;
    width: 160px;
    min-width: 100px;
    margin-left: var(--ee4v-space-sm);
    margin-right: var(--ee4v-space-xxs);
}

.ee4v-asset-manager__toolbar-actions {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.ee4v-asset-manager__toolbar Button,
.ee4v-asset-manager__actions Button {
    min-height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-xxs);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
}

.ee4v-asset-manager__grid-controls {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    width: 162px;
    min-width: 72px;
}

.ee4v-asset-manager__grid-size-slider {
    flex-shrink: 1;
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager__reload {
    flex-shrink: 0;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__reload:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__reload:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager__primary-action {
    border-color: var(--ee4v-color-selection);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-asset-manager__primary-action:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-tool-active-hover);
}

.ee4v-asset-manager__primary-action:active {
    background-color: var(--ee4v-color-tool-active);
}

.ee4v-asset-manager__danger-action {
    color: var(--ee4v-color-status-failed-text);
    border-color: var(--ee4v-color-error);
    background-color: var(--ee4v-color-error-surface-soft);
}

.ee4v-asset-manager__danger-action:hover,
.ee4v-asset-manager__danger-action:active {
    border-color: var(--ee4v-color-error);
    background-color: var(--ee4v-color-status-failed);
}

.ee4v-asset-manager__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    overflow: hidden;
}

.ee4v-asset-manager__content-scroll {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-manager__detail {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-xl);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__detail .unity-scroll-view__content-container > * {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-asset-grid,
.ee4v-asset-grid__list {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-grid__list,
.ee4v-asset-grid__list .unity-scroll-view__content-container {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-grid__list {
    border-width: 0;
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
}

.ee4v-asset-grid__row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: var(--ee4v-space-xs);
}

.ee4v-asset-grid__slot {
    flex-shrink: 0;
}

.ee4v-asset-grid__list .unity-scroller,
.ee4v-asset-grid__list .unity-scroll-view__vertical-scroller,
.ee4v-asset-grid__list .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-grid-card {
    flex-direction: column;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-2xl);
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-asset-grid-card:hover {
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-grid-card--selected {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection);
}

.ee4v-asset-grid-card__image-frame {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-strong);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-tab-idle);
}

.ee4v-asset-grid-card__image,
.ee4v-asset-grid-card__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-asset-grid-card__placeholder {
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-asset-grid-card__name {
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    margin-top: var(--ee4v-space-xs);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-grid-card--selected .ee4v-asset-grid-card__name {
    color: var(--ee4v-color-control-highlight);
}

.ee4v-asset-manager__thumbnail {
    width: 100%;
    max-width: 360px;
    height: 150px;
    align-self: center;
    align-items: center;
    justify-content: center;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-strong);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-tab-idle);
}

.ee4v-asset-manager__thumbnail Image {
    flex-grow: 1;
    width: 100%;
}

.ee4v-asset-manager__actions,
.ee4v-asset-manager__collection-bar {
    flex-direction: row;
    align-items: center;
}

.ee4v-asset-manager__collection-bar {
    margin-bottom: var(--ee4v-space-xl);
    padding: var(--ee4v-space-md);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager__collection-filter {
    flex-grow: 1;
    color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager__file-button,
.ee4v-asset-manager__list-row {
    min-height: var(--ee4v-size-22);
    margin-bottom: var(--ee4v-space-xs);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager__file-button:hover,
.ee4v-asset-manager__list-row:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager__list-row {
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
}

.ee4v-asset-manager__source-card {
    margin-bottom: var(--ee4v-space-lg);
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager__source-card-body > * {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-asset-manager__source-card-body {
    margin-top: var(--ee4v-space-lg);
}

.ee4v-asset-manager__source-title {
    font-size: var(--ee4v-font-size-subtitle);
    margin-bottom: var(--ee4v-space-xxs);
    -unity-font-style: bold;
}

.ee4v-asset-manager__source-description,
.ee4v-asset-manager__key {
    color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager__source-description {
    white-space: normal;
}

.ee4v-asset-manager__key-value {
    flex-direction: row;
}

.ee4v-asset-manager__key {
    width: 76px;
}

.ee4v-asset-manager__value {
    flex-grow: 1;
}

.ee4v-asset-manager__mono {
    font-size: var(--ee4v-font-size-small);
    white-space: normal;
}

.ee4v-asset-manager__status {
    min-height: var(--ee4v-size-24);
    flex-shrink: 0;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    color: var(--ee4v-color-text-secondary);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager__status--error {
    color: var(--ee4v-color-status-failed-text);
}
