@import url("../../UI/Foundation/ui-design-tokens.uss");
@import url("../../UI/Components/Content/Icon/icon.uss");

.ee4v-asset-manager-control-button {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    margin: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-control);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-asset-manager-control-button:hover {
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-control-hover);
}

.ee4v-asset-manager-control-button:active {
    background-color: var(--ee4v-color-control-pressed);
}

.ee4v-asset-manager-control-button:focus {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager-control-button:disabled {
    opacity: 0.5;
}

.ee4v-asset-manager-control-button__label {
    min-width: 0;
    flex-grow: 1;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-manager-control-button--icon-only {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    padding: var(--ee4v-space-none);
}

.ee4v-asset-manager-control-button--icon-only .ee4v-asset-manager-control-button__label {
    display: none;
}

.ee4v-asset-manager-control-field {
    align-self: stretch;
    min-width: 0;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-control-field__label {
    min-width: 0;
    min-height: var(--ee4v-size-18);
    margin-bottom: var(--ee4v-space-xxs);
    color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager-control-field__container {
    position: relative;
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    height: var(--ee4v-control-height-default);
    flex-direction: row;
    align-items: stretch;
    align-self: stretch;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-field);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-asset-manager-control-field__container:hover {
    border-color: var(--ee4v-color-border-active);
}

.ee4v-asset-manager-control-field--focused .ee4v-asset-manager-control-field__container {
    border-color: var(--ee4v-color-focus);
}

.ee4v-asset-manager-control-field__input {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
}

.ee4v-asset-manager-control-field__input .unity-base-field__label,
.ee4v-asset-manager-control-field__input .unity-text-field__label {
    display: none;
}

.ee4v-asset-manager-control-field__input .unity-base-field__input,
.ee4v-asset-manager-control-field__input .unity-base-text-field__input,
.ee4v-asset-manager-control-field__input .unity-text-field__input {
    min-height: 0;
    height: auto;
    max-height: 10000px;
    flex-grow: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    font-size: var(--ee4v-font-size-body);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-field__input .unity-text-element {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-field--multiline .ee4v-asset-manager-control-field__container {
    min-height: 72px;
    height: auto;
    padding-top: 5px;
    padding-bottom: 5px;
    overflow: hidden;
}

.ee4v-asset-manager-control-field--multiline .ee4v-asset-manager-control-field__input,
.ee4v-asset-manager-control-field--multiline .ee4v-asset-manager-control-field__input .unity-base-text-field__input,
.ee4v-asset-manager-control-field--multiline .ee4v-asset-manager-control-field__input .unity-text-field__input {
    min-height: 60px;
    height: auto;
    max-height: 10000px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.ee4v-asset-manager-control-field--multiline .ee4v-asset-manager-control-field__input .unity-text-element {
    -unity-text-align: upper-left;
}

.ee4v-asset-manager-control-field--multiline .unity-scroll-view,
.ee4v-asset-manager-control-field--multiline .unity-scroll-view__content-container {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-control-field--multiline .unity-scroll-view__vertical-scroller,
.ee4v-asset-manager-control-field--multiline .unity-scroller {
    width: var(--ee4v-size-8);
    min-width: var(--ee4v-size-8);
    background-color: var(--ee4v-color-transparent);
    border-width: 0;
}

.ee4v-asset-manager-control-field--multiline .unity-scroller__low-button,
.ee4v-asset-manager-control-field--multiline .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    min-height: 0;
    max-height: 0;
}

.ee4v-asset-manager-control-field--multiline .unity-scroller__slider,
.ee4v-asset-manager-control-field--multiline .unity-base-slider__tracker {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: var(--ee4v-color-transparent);
    border-width: 0;
}

.ee4v-asset-manager-control-field--multiline .unity-base-slider__dragger,
.ee4v-asset-manager-control-field--multiline .unity-base-slider__dragger-border,
.ee4v-asset-manager-control-field--multiline .unity-scroller__slider .unity-dragger {
    width: var(--ee4v-size-4);
    min-width: var(--ee4v-size-4);
    margin-left: var(--ee4v-space-xxs);
    margin-right: var(--ee4v-space-xxs);
    border-radius: var(--ee4v-radius-xs);
    border-width: 0;
    background-color: var(--ee4v-color-scroll-thumb);
}

.ee4v-asset-manager-control-search {
    flex-direction: row;
    align-items: center;
    min-height: var(--ee4v-control-height-default);
    height: var(--ee4v-control-height-default);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-field);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-asset-manager-control-search:hover {
    border-color: var(--ee4v-color-border-active);
}

.ee4v-asset-manager-control-search--focused,
.ee4v-asset-manager-control-search--focused:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-field);
}

.ee4v-asset-manager-control-search__icon {
    width: var(--ee4v-size-14);
    min-width: var(--ee4v-size-14);
    max-width: var(--ee4v-size-14);
    height: var(--ee4v-size-14);
    min-height: var(--ee4v-size-14);
    max-height: var(--ee4v-size-14);
    margin-left: var(--ee4v-size-1);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-asset-manager-control-search__input-host {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.ee4v-asset-manager-control-search__input {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-width: 0;
    min-height: 0;
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-asset-manager-control-search__input .unity-base-text-field__input,
.ee4v-asset-manager-control-search__input .unity-text-field__input,
.ee4v-asset-manager-control-search__input .unity-base-field__input {
    flex-grow: 1;
    align-self: stretch;
    min-height: 0;
    height: auto;
    max-height: 10000px;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    font-size: var(--ee4v-font-size-body);
    background-color: var(--ee4v-color-transparent);
    border-width: 0;
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-search__input .unity-text-element {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-search__input .unity-base-field__label,
.ee4v-asset-manager-control-search__input .unity-text-field__label {
    display: none;
}

.ee4v-asset-manager-control-search__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    min-width: 0;
    max-width: 100%;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-manager-control-search__clear {
    width: var(--ee4v-size-12);
    min-width: var(--ee4v-size-12);
    max-width: var(--ee4v-size-12);
    height: var(--ee4v-size-12);
    min-height: var(--ee4v-size-12);
    max-height: var(--ee4v-size-12);
    flex-shrink: 0;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
    opacity: 0.8;
}

.ee4v-asset-manager-control-search__clear:hover {
    background-color: var(--ee4v-color-surface-hover-strong);
    opacity: 1;
}

.ee4v-asset-manager-control-search__clear .ee4v-ui-icon {
    opacity: 0.8;
}

.ee4v-asset-manager-control-search__clear:hover .ee4v-ui-icon {
    opacity: 1;
}

.ee4v-asset-manager-grid-slider {
    flex-direction: row;
    align-items: center;
    width: 162px;
    min-width: 72px;
    height: var(--ee4v-size-31);
    min-height: var(--ee4v-size-31);
    max-height: var(--ee4v-size-31);
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
}

.ee4v-asset-manager-grid-slider__endpoint {
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    max-width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    min-height: var(--ee4v-size-16);
    max-height: var(--ee4v-size-16);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
}

.ee4v-asset-manager-grid-slider__endpoint:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager-grid-slider__endpoint:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager-grid-slider__slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: var(--ee4v-size-24);
    height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-md);
    margin-right: var(--ee4v-space-md);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-field__label {
    display: none;
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__input {
    min-width: 0;
    margin: var(--ee4v-space-none);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__tracker {
    height: var(--ee4v-size-2);
    min-height: var(--ee4v-size-2);
    max-height: var(--ee4v-size-2);
    border-width: 0;
    background-color: var(--ee4v-color-slider-track);
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__dragger-border {
    display: none;
}

.ee4v-asset-manager-grid-slider__slider .unity-base-slider__dragger {
    width: var(--ee4v-size-11);
    min-width: var(--ee4v-size-11);
    max-width: var(--ee4v-size-11);
    height: var(--ee4v-size-11);
    min-height: var(--ee4v-size-11);
    max-height: var(--ee4v-size-11);
    border-width: 0;
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-control-highlight);
}

.ee4v-asset-manager-grid-slider:hover .unity-base-slider__tracker {
    background-color: var(--ee4v-color-slider-track-hover);
}

.ee4v-asset-manager-grid-slider:hover .unity-base-slider__dragger {
    background-color: var(--ee4v-color-slider-knob-hover);
}

.ee4v-asset-manager-control-foldout {
    min-width: 0;
    margin-top: var(--ee4v-space-md);
    margin-bottom: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-subtle);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-subtle);
    overflow: hidden;
}

.ee4v-asset-manager-control-foldout__header {
    min-height: var(--ee4v-size-24);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-foldout__header .ee4v-asset-manager-control-button__label {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-control-foldout__header:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-manager-control-foldout__header:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-asset-manager-control-foldout__body {
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-sm);
    padding-bottom: var(--ee4v-space-md);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-control-notice {
    min-width: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--ee4v-space-md);
    padding: var(--ee4v-space-md);
    border-left-width: var(--ee4v-border-emphasis);
    border-left-color: var(--ee4v-color-info);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-control-notice__icon {
    width: var(--ee4v-size-18);
    min-width: var(--ee4v-size-18);
    margin-right: var(--ee4v-space-sm);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.ee4v-asset-manager-control-notice__text {
    min-width: 0;
    flex-grow: 1;
    white-space: normal;
}

.ee4v-asset-manager-controls-story > * {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager,
.ee4v-asset-manager-three-pane {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--ee4v-color-panel);
}

.ee4v-asset-manager-three-pane {
    flex-direction: row;
}

.ee4v-asset-manager-three-pane__pane {
    flex-shrink: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-three-pane__pane--left {
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    border-right-width: var(--ee4v-border-hairline);
    border-right-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-three-pane__pane--main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 320px;
}

.ee4v-asset-manager-three-pane__pane--right {
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-three-pane--navigation .ee4v-asset-manager-three-pane__pane--main,
.ee4v-asset-manager-three-pane--navigation .ee4v-asset-manager-three-pane__pane--right,
.ee4v-asset-manager-three-pane--main .ee4v-asset-manager-three-pane__pane--left,
.ee4v-asset-manager-three-pane--main .ee4v-asset-manager-three-pane__pane--right,
.ee4v-asset-manager-three-pane--information .ee4v-asset-manager-three-pane__pane--left,
.ee4v-asset-manager-three-pane--information .ee4v-asset-manager-three-pane__pane--main {
