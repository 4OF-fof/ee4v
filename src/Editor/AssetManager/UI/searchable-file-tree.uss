.ee4v-ui-searchable-tree-view.ee4v-asset-manager-file-tree {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-2xl);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-none);
    padding-top: var(--ee4v-space-md);
    padding-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-file-tree__heading {
    flex-grow: 1;
}

.ee4v-asset-manager-file-tree__register.ee4v-ui-button {
    min-height: var(--ee4v-size-24);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-asset-manager-file-tree .ee4v-ui-searchable-tree-view__tree {
    margin-top: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xs);
    border-top-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-file-tree .unity-tree-view__item-content {
    min-width: 0;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-asset-manager-file-tree__feedback {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
}

.ee4v-asset-manager-file-tree__row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 30px;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-sm);
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row--overview {
    margin-bottom: var(--ee4v-space-sm);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-file-tree__row--group .ee4v-asset-manager-file-tree__title {
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--new-section {
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
}

.ee4v-asset-manager-file-tree__icon {
    flex-shrink: 0;
    width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    margin-right: var(--ee4v-space-sm);
    -unity-background-image-tint-color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager-file-tree__target-toggle {
    flex-shrink: 0;
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    margin-right: var(--ee4v-space-sm);
}

.ee4v-asset-manager-file-tree__title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta {
    flex-shrink: 0;
    min-width: 0;
    max-width: 88px;
    margin-left: var(--ee4v-space-md);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta Label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__image-tooltip {
    align-items: center;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-md);
    padding-bottom: var(--ee4v-space-md);
    border-top-left-radius: var(--ee4v-radius-xl);
    border-top-right-radius: var(--ee4v-radius-xl);
    border-bottom-left-radius: var(--ee4v-radius-xl);
    border-bottom-right-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-asset-manager-file-tree__image-tooltip-image {
    flex-shrink: 0;
}

.ee4v-asset-manager-file-tree__image-tooltip-name {
    width: 100%;
    height: var(--ee4v-size-22);
    margin-top: var(--ee4v-space-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-center;
}

.ee4v-asset-manager-file-tree__image-tooltip-name Label {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-center;
}
