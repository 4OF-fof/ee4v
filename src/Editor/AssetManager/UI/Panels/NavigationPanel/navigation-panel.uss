.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--navigation {
    flex-direction: column;
}

.ee4v-asset-manager-panel__navigation-picker {
    flex-shrink: 0;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-lg);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-panel__section-header {
    height: var(--ee4v-size-24);
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-asset-manager-panel__section-title {
    min-width: 0;
    flex-grow: 1;
    color: var(--ee4v-color-text-soft);
    overflow: hidden;
}

.ee4v-asset-manager-panel__header-action {
    flex-shrink: 0;
}

.ee4v-asset-manager-panel__collections-scroll {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-asset-manager-panel__collections-content {
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-panel__collection-section {
    padding-top: var(--ee4v-space-lg);
}

.ee4v-asset-manager-panel__collection-section-toggle {
    height: var(--ee4v-size-24);
    min-height: var(--ee4v-size-24);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-panel__collection-section-toggle:hover,
.ee4v-asset-manager-panel__collection-section-toggle:focus,
.ee4v-asset-manager-panel__collection-section-toggle:checked {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-panel__collection-section-toggle .ee4v-asset-manager-panel__collection-section-disclosure,
.ee4v-asset-manager-panel__collection-section-toggle:hover .ee4v-asset-manager-panel__collection-section-disclosure,
.ee4v-asset-manager-panel__collection-section-toggle:focus .ee4v-asset-manager-panel__collection-section-disclosure,
.ee4v-asset-manager-panel__collection-section-toggle:checked .ee4v-asset-manager-panel__collection-section-disclosure {
    -unity-background-image-tint-color: var(--ee4v-color-text-muted);
}

.ee4v-asset-manager-panel__collection-section-header {
    flex-grow: 1;
    min-width: 0;
    align-items: center;
}

.ee4v-asset-manager-panel__collection-section-toggle > .ee4v-asset-manager-panel__collection-section-header,
.ee4v-asset-manager-panel__collection-section-toggle:hover > .ee4v-asset-manager-panel__collection-section-header,
.ee4v-asset-manager-panel__collection-section-toggle:focus > .ee4v-asset-manager-panel__collection-section-header,
.ee4v-asset-manager-panel__collection-section-toggle:checked > .ee4v-asset-manager-panel__collection-section-header {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-panel__collection-section-content {
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
}

.ee4v-asset-manager-panel__collection-error {
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-sm);
    color: var(--ee4v-color-error);
}

.ee4v-asset-manager-collection-list {
    flex-direction: column;
}

.ee4v-asset-manager-collection-list__button {
    margin-bottom: var(--ee4v-space-xxs);
}
