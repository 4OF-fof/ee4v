.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--infomation {
    padding-top: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    padding-left: var(--ee4v-space-xl);
}

.ee4v-asset-manager-panel__infomation-preview {
    width: 100%;
    max-width: 360px;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-panel__infomation-selection-mode {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: var(--ee4v-size-24);
    margin-top: var(--ee4v-space-xs);
}

.ee4v-asset-manager-panel__infomation-preview-text {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ee4v-asset-manager-panel__infomation-selection-count-suffix {
    margin-left: var(--ee4v-space-xxs);
}

.ee4v-asset-manager-panel__infomation-detail-content {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    margin-top: var(--ee4v-space-md);
    overflow: hidden;
}

.ee4v-asset-manager-asset-info {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-asset-info > .unity-scroll-view {
    flex-grow: 1;
}

.ee4v-asset-manager-asset-info > .unity-scroll-view > .unity-scroll-view__content-container {
    padding-right: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-asset-info__field {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-asset-manager-asset-info__label {
    margin-bottom: var(--ee4v-space-xs);
    color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager-tag-field {
    width: 100%;
    min-width: 0;
}

.ee4v-asset-manager-tag-field__tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: var(--ee4v-space-negative-xs);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-tag-field__chip {
    min-width: 0;
    min-height: var(--ee4v-size-24);
    flex-direction: row;
    align-items: center;
    margin-right: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-xxs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-subtle);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager-tag-field__chip-label {
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-manager-tag-field__remove.ee4v-ui-button {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-xxs);
    padding: var(--ee4v-space-none);
    border-radius: var(--ee4v-radius-xl);
}

.ee4v-asset-manager-tag-field__add.ee4v-ui-button {
    width: 100%;
    min-height: var(--ee4v-size-26);
}

.ee4v-asset-manager-tag-picker {
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-none);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-overlay-border);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-asset-manager-tag-picker__search {
    flex-shrink: 0;
    margin: var(--ee4v-space-sm);
}

.ee4v-asset-manager-tag-picker__content {
    flex-grow: 1;
    min-height: 0;
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-tag-picker__content > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: var(--ee4v-space-sm);
}

.ee4v-asset-manager-tag-picker__section {
    margin-bottom: var(--ee4v-space-sm);
    padding-bottom: var(--ee4v-space-sm);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-asset-manager-tag-picker__section-title {
    margin-bottom: var(--ee4v-space-xs);
    color: var(--ee4v-color-text-secondary);
}

.ee4v-asset-manager-tag-picker__row.ee4v-ui-button {
    width: 100%;
    min-height: var(--ee4v-size-26);
    margin-bottom: var(--ee4v-space-xxs);
    justify-content: flex-start;
}

.ee4v-asset-manager-tag-picker__row > .ee4v-ui-button__content {
    justify-content: flex-start;
}

.ee4v-asset-manager-tag-picker__row .ee4v-ui-button__label {
    -unity-text-align: middle-left;
}

.ee4v-asset-manager-tag-picker__empty {
    padding: var(--ee4v-space-lg);
    color: var(--ee4v-color-text-muted);
}

.ee4v-asset-manager-asset-info__metadata {
    margin-top: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-lg);
    padding: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-subtle);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-manager-asset-info__metadata-row {
    min-width: 0;
    flex-direction: row;
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-asset-manager-asset-info__metadata-label {
    width: 88px;
    min-width: 88px;
    color: var(--ee4v-color-text-muted);
}

.ee4v-asset-manager-asset-info__metadata-value {
    min-width: 0;
    flex-grow: 1;
    color: var(--ee4v-color-text-primary);
}

.ee4v-asset-manager-asset-info__feedback {
    min-height: var(--ee4v-size-20);
    margin-bottom: var(--ee4v-space-sm);
    color: var(--ee4v-color-success);
}

.ee4v-asset-manager-asset-info__feedback--error {
    color: var(--ee4v-color-error);
}

.ee4v-asset-manager-asset-info__actions {
    flex-direction: row;
    justify-content: flex-end;
}

.ee4v-asset-manager-asset-info__actions > .ee4v-ui-button {
    margin-left: var(--ee4v-space-sm);
}

.ee4v-asset-manager-file-tree {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    min-height: var(--ee4v-size-20);
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row--import-target,
.ee4v-asset-manager-file-tree__row--primary-file {
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-xs);
    border-left-width: var(--ee4v-border-emphasis);
    border-left-color: var(--ee4v-color-import-target);
    border-top-left-radius: var(--ee4v-radius-xs);
    border-top-right-radius: var(--ee4v-radius-xs);
    border-bottom-left-radius: var(--ee4v-radius-xs);
    border-bottom-right-radius: var(--ee4v-radius-xs);
    background-color: var(--ee4v-color-import-target-surface);
}

.ee4v-asset-manager-file-tree__row--group {
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    border-left-width: var(--ee4v-border-emphasis);
}

.ee4v-asset-manager-file-tree__row--variant-group {
    border-left-color: var(--ee4v-color-info);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-file-tree__row--version-group {
    border-left-color: var(--ee4v-color-file-group);
    background-color: var(--ee4v-color-file-group-surface);
}

.ee4v-asset-manager-file-tree__title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    color: var(--ee4v-color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__title Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__row--import-target .ee4v-asset-manager-file-tree__title,
.ee4v-asset-manager-file-tree__row--primary-file .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-import-target-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--variant-group .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-status-skipped-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--version-group .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-file-group-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__meta {
    flex-shrink: 0;
    max-width: 88px;
    margin-left: var(--ee4v-space-md);
    color: var(--ee4v-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__row--import-target .ee4v-asset-manager-file-tree__meta,
.ee4v-asset-manager-file-tree__row--primary-file .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-import-target-meta);
}

.ee4v-asset-manager-file-tree__meta--group {
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: var(--ee4v-radius-xl);
    border-top-right-radius: var(--ee4v-radius-xl);
    border-bottom-left-radius: var(--ee4v-radius-xl);
    border-bottom-right-radius: var(--ee4v-radius-xl);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--variant-group .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-status-skipped-text);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-file-tree__row--version-group .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-status-running-text);
    background-color: var(--ee4v-color-warning-surface-soft);
}

.ee4v-asset-manager-file-tree__meta--empty {
    display: none;
}
