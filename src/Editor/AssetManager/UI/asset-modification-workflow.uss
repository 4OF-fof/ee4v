@import url("../../UI/Foundation/ui-design-tokens.uss");

.ee4v-modification-workflow {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__primary-action.ee4v-ui-button {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-tool-active);
}

.ee4v-modification-workflow__primary-action.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-tool-active-hover);
}

.ee4v-modification-workflow__selection-page {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: var(--ee4v-space-3xl) var(--ee4v-space-4xl) var(--ee4v-space-2xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__selection-header-text {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-new.ee4v-ui-button {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__selection-back.ee4v-ui-button {
    width: 32px;
    min-width: 32px;
    height: 32px;
    min-height: 32px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-lg);
    padding: var(--ee4v-space-none);
}

.ee4v-modification-workflow__selection-title {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__selection-description {
    max-width: 720px;
}

.ee4v-modification-workflow__selection-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    max-width: 1120px;
    align-self: center;
    padding: var(--ee4v-space-3xl) var(--ee4v-space-4xl);
}

.ee4v-modification-workflow__selection-grid {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
}

.ee4v-modification-workflow__selection-card {
    width: 248px;
    min-height: 330px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xl);
    margin-bottom: var(--ee4v-space-xl);
    padding: var(--ee4v-space-lg);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__selection-card:hover {
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-modification-workflow__selection-preview.ee4v-asset-manager__prefab-preview {
    width: 216px;
    min-width: 216px;
    height: 184px;
    min-height: 184px;
    margin-right: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__selection-card-text {
    min-width: 0;
    min-height: 58px;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-card-title {
    margin-bottom: var(--ee4v-space-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-modification-workflow__selection-card-description {
    max-height: 38px;
    overflow: hidden;
}

.ee4v-modification-workflow__selection-choose.ee4v-ui-button {
    width: 100%;
    margin-top: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__selection-manager.ee4v-ui-button {
    align-self: center;
    margin-top: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__header {
    min-width: 0;
    flex-shrink: 0;
    padding: 3px var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__header-cards {
    min-width: 0;
    height: 34px;
    flex-direction: row;
    align-items: center;
}

.ee4v-modification-workflow__header-strip {
    min-width: 0;
    flex-grow: 1;
    height: 34px;
    margin-left: var(--ee4v-space-xxs);
}

.ee4v-modification-workflow__header-strip > .unity-scroll-view__content-and-vertical-scroll-container {
    height: 34px;
}

.ee4v-modification-workflow__header-strip > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    height: 34px;
    flex-direction: row;
    align-items: center;
}

.ee4v-modification-workflow__header-card {
    min-width: var(--ee4v-size-24);
    max-width: 160px;
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-right: var(--ee4v-space-xxs);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-xxs);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-soft);
    overflow: hidden;
    transition-property: background-color, border-bottom-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.ee4v-modification-workflow__header-card:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-modification-workflow__header-card--combined {
    min-width: 56px;
    max-width: 220px;
    height: 30px;
    min-height: 30px;
    margin-right: var(--ee4v-space-sm);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-pill);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-modification-workflow__header-card--combined:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-info-surface-strong);
}

.ee4v-modification-workflow__header-card--selected,
.ee4v-modification-workflow__header-card--selected:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-modification-workflow__header-card--combined.ee4v-modification-workflow__header-card--selected,
.ee4v-modification-workflow__header-card--combined.ee4v-modification-workflow__header-card--selected:hover {
    background-color: var(--ee4v-color-info-surface-strong);
    border-color: var(--ee4v-color-focus);
}

.ee4v-modification-workflow__header-card--hidden {
    opacity: 0.58;
}

.ee4v-modification-workflow__header-card-name {
    min-width: 0;
    flex-grow: 1;
    height: 24px;
    justify-content: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-modification-workflow__header-card-name > .unity-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-modification-workflow__header-card-visibility.ee4v-ui-button {
    width: 24px;
    min-width: 24px;
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xxs);
    padding: var(--ee4v-space-none);
    border-width: var(--ee4v-space-none);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-modification-workflow__header-card-visibility.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-modification-workflow__header-add.ee4v-ui-button {
    width: 34px;
    min-width: 34px;
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    padding: var(--ee4v-space-none);
    margin-left: var(--ee4v-space-xxs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-modification-workflow__header-add.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-modification-workflow__header-add.ee4v-ui-button:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-modification-workflow__header-change.ee4v-ui-button {
    min-height: 30px;
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__objects-title {
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-modification-workflow__objects-content {
    min-width: 0;
}

.ee4v-modification-workflow__objects-description {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__objects-search {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__objects-count {
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-modification-workflow__objects-list {
    min-width: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-panel);
    overflow: hidden;
}

.ee4v-modification-workflow__object-row {
    min-width: 0;
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    padding: var(--ee4v-space-xs) var(--ee4v-space-sm);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-modification-workflow__object-row--parent-hidden {
    opacity: 0.6;
}

.ee4v-modification-workflow__object-text {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__object-name,
.ee4v-modification-workflow__object-path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-modification-workflow__object-visibility {
    width: 30px;
    min-width: 30px;
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__object-visibility > .unity-base-field__label {
    display: none;
}
.ee4v-modification-workflow__body {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
}

.ee4v-modification-workflow__customizer-host {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
}

.ee4v-modification-workflow__face-expression-host,
.ee4v-modification-workflow__physbone-host {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__hidden {
    display: none;
}

.ee4v-modification-workflow__creation-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__creation-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    max-width: 1040px;
    align-self: center;
    padding: var(--ee4v-space-3xl) var(--ee4v-space-4xl);
}

.ee4v-modification-workflow__creation-source {
    max-width: 560px;
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__creation-layout {
    min-width: 0;
    flex-direction: row;
}

.ee4v-modification-workflow__creation-preview-column {
    min-width: 360px;
    flex-grow: 1;
    margin-right: var(--ee4v-space-2xl);
}

.ee4v-modification-workflow__creation-fields {
    width: 360px;
    min-width: 320px;
    flex-shrink: 0;
    padding: var(--ee4v-space-xl);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__creation-fields > .ee4v-asset-manager-control-field {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__creation-submit.ee4v-ui-button {
    align-self: flex-end;
    margin-top: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__category-rail {
    width: 148px;
    min-width: 148px;
    flex-shrink: 0;
    padding: var(--ee4v-space-xl) var(--ee4v-space-md);
    border-right-width: var(--ee4v-border-hairline);
    border-right-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__category-heading {
    margin: var(--ee4v-space-xs) var(--ee4v-space-md) var(--ee4v-space-lg);
}

.ee4v-modification-workflow__category-button.ee4v-ui-button {
    width: 100%;
    min-height: 40px;
    flex-shrink: 0;
    justify-content: flex-start;
    margin-bottom: var(--ee4v-space-sm);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-modification-workflow__category-button.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-modification-workflow__category-button--active.ee4v-ui-button,
.ee4v-modification-workflow__category-button--active.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-modification-workflow__category-button .ee4v-ui-button__content {
    justify-content: flex-start;
}

.ee4v-modification-workflow__preview-pane {
    min-width: 480px;
    min-height: 0;
    flex-grow: 1;
    padding: var(--ee4v-space-xl);
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__preview-toolbar {
    min-width: 0;
    min-height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-md);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-active);
    border-right-color: var(--ee4v-color-border-active);
    border-left-color: var(--ee4v-color-border-active);
    border-top-left-radius: var(--ee4v-radius-xl);
    border-top-right-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__preview-title {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__preview-viewport {
    min-width: 0;
    min-height: 420px;
    flex-grow: 1;
    overflow: hidden;
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-right-color: var(--ee4v-color-border-active);
    border-bottom-color: var(--ee4v-color-border-active);
    border-left-color: var(--ee4v-color-border-active);
    border-bottom-left-radius: var(--ee4v-radius-xl);
    border-bottom-right-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__preview.ee4v-asset-manager__prefab-scene-preview {
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
}

.ee4v-modification-workflow__controls-column {
    width: 460px;
    min-width: 420px;
    min-height: 0;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__appearance-header {
    min-width: 0;
    flex-shrink: 0;
    flex-direction: column;
    padding: var(--ee4v-space-2xl);
    padding-bottom: var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__appearance-header .ee4v-modification-workflow__shape-parts-tabs {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-modification-workflow__controls {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__controls-content {
    min-width: 0;
    padding: var(--ee4v-space-2xl);
}

.ee4v-modification-workflow__make-material-editable.ee4v-ui-button {
    width: 100%;
    margin-top: var(--ee4v-space-lg);
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__feedback {
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__part-selector {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__part-selector--standalone {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-modification-workflow__part-button.ee4v-ui-button {
    min-width: 88px;
    min-height: 32px;
    flex-basis: 88px;
    flex-grow: 1;
    margin-right: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-xs);
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__part-button--active.ee4v-ui-button,
.ee4v-modification-workflow__part-button--active.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-modification-workflow__shape-parts-tabs {
    min-width: 0;
    flex-direction: row;
    margin-bottom: var(--ee4v-space-xl);
    padding: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__shape-parts-tab.ee4v-ui-button {
    min-width: 0;
    min-height: 36px;
    flex-grow: 1;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-modification-workflow__shape-parts-tab--active.ee4v-ui-button,
.ee4v-modification-workflow__shape-parts-tab--active.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-modification-workflow__size-content,
.ee4v-modification-workflow__size-list,
.ee4v-modification-workflow__size-scale-group,
.ee4v-modification-workflow__size-axis-rows {
    min-width: 0;
}

.ee4v-modification-workflow__advanced-size {
    min-width: 0;
    margin-top: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__advanced-size-toggle.ee4v-ui-button {
    width: 100%;
    min-width: 0;
    min-height: 36px;
    justify-content: flex-start;
    margin-bottom: var(--ee4v-space-md);
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__advanced-size-toggle .ee4v-ui-button__content {
    justify-content: flex-start;
}

.ee4v-modification-workflow__size-group-title {
    min-height: var(--ee4v-size-28);
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-soft);
    color: var(--ee4v-color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ee4v-modification-workflow__size-role-title {
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-lg);
    -unity-font-style: bold;
}

.ee4v-modification-workflow__size-control {
    height: var(--ee4v-size-32);
    min-width: 0;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-modification-workflow__size-control:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-modification-workflow__size-control--child {
    padding-left: var(--ee4v-space-3xl);
}

.ee4v-modification-workflow__size-axis-toggle.ee4v-ui-button {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
    padding: var(--ee4v-space-none);
}

.ee4v-modification-workflow__size-axis-toggle.ee4v-ui-button:hover {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-modification-workflow__size-axis-indent {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-modification-workflow__size-control-name {
    width: 112px;
    min-width: 64px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-modification-workflow__size-control-row {
    min-width: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.ee4v-modification-workflow__size-slider {
    width: auto;
    min-width: 70px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: var(--ee4v-space-sm);
    margin-right: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__size-value {
    width: 64px;
    min-width: 64px;
    flex-shrink: 0;
}

.ee4v-modification-workflow__size-value > .unity-base-field__label {
    display: none;
}

.ee4v-modification-workflow__size-value > .unity-base-field__input {
    min-width: 0;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-modification-workflow__size-value:hover > .unity-base-field__input,
.ee4v-modification-workflow__size-value:focus > .unity-base-field__input {
    border-bottom-color: var(--ee4v-color-focus);
}

.ee4v-modification-workflow__size-unit {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xs);
}

.ee4v-modification-workflow__size-reset.ee4v-ui-button {
    min-width: 68px;
    min-height: var(--ee4v-size-24);
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xs);
}

.ee4v-modification-workflow__material-list {
    min-width: 0;
    margin-bottom: var(--ee4v-space-xl);
    padding: var(--ee4v-space-none);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-panel);
    overflow: hidden;
}

.ee4v-modification-workflow__material-item.ee4v-ui-navigation-item {
    width: 100%;
    min-height: 52px;
    margin-bottom: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-default);
    border-radius: 0;
}

.ee4v-modification-workflow__material-visibility-all {
    min-height: 38px;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__material-item.ee4v-ui-navigation-item:hover {
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-modification-workflow__material-item.ee4v-ui-navigation-item--selected,
.ee4v-modification-workflow__material-item.ee4v-ui-navigation-item--selected:hover {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-modification-workflow__material-visibility.ee4v-ui-button {
    width: var(--ee4v-size-28);
    min-width: var(--ee4v-size-28);
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    margin-left: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__material-editor-section {
    min-width: 0;
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__material-editor-surface {
    min-width: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-panel);
    overflow: hidden;
}

.ee4v-modification-workflow__material-editor-header {
    min-width: 0;
    margin-bottom: var(--ee4v-space-none);
    padding: var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-modification-workflow__material-editor {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    padding-top: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__material-editor-imgui {
    width: 100%;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-modification-workflow__empty-state {
    margin-top: var(--ee4v-space-lg);
    margin-bottom: var(--ee4v-space-xl);
}
