@import url("../../UI/Foundation/ui-design-tokens.uss");
@import url("Components/Workflow/workflow-header.uss");
@import url("Components/Workflow/workflow-editor-layout.uss");
@import url("Components/Workflow/workflow-category-rail.uss");
@import url("../../Feature/Avatar/AvatarInfo/UI/avatar-info.uss");
@import url("../Simulation/avatar-execution.uss");
@import url("../../Feature/Avatar/AvatarParts/avatar-parts.uss");
@import url("../../Feature/Avatar/AvatarMaterials/avatar-materials.uss");
@import url("../../Feature/Shared/AvatarEditing/avatar-editing.uss");

.ee4v-asset-prefab-picker__body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 20px;
}

.ee4v-asset-prefab-picker__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.ee4v-asset-prefab-picker__search {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-asset-prefab-picker__browser {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-prefab-picker__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-prefab-picker__options {
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 0;
}

.ee4v-asset-prefab-picker__card.ee4v-ui-navigation-item {
    flex-shrink: 0;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 8px;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-prefab-picker__card.ee4v-ui-navigation-item:hover,
.ee4v-asset-prefab-picker__card.ee4v-ui-navigation-item:focus {
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-asset-prefab-picker__card > .ee4v-ui-navigation-item__row {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-asset-prefab-picker__card .ee4v-ui-item-row__leading,
.ee4v-asset-prefab-picker__card .ee4v-ui-item-row__text {
    width: 100%;
}

.ee4v-asset-prefab-picker__card .ee4v-ui-item-row__title {
    min-height: 36px;
    max-height: 36px;
    margin-top: 10px;
    overflow: hidden;
    font-size: 13px;
    -unity-text-align: middle-left;
}

.ee4v-asset-prefab-picker__card .ee4v-ui-item-row__description {
    margin-top: 4px;
    -unity-text-align: middle-left;
}

.ee4v-asset-prefab-picker__thumbnail {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-soft);
    overflow: hidden;
}

.ee4v-asset-prefab-picker__image {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-asset-prefab-picker__mini-thumbnail {
    width: 48px;
    height: 48px;
}

.ee4v-asset-prefab-picker__source {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.ee4v-asset-prefab-picker__source--visible {
    display: flex;
}

.ee4v-asset-prefab-picker__item-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-prefab-picker__detail {
    display: none;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin-left: 20px;
}

.ee4v-asset-prefab-picker__browser--prefabs > .ee4v-asset-prefab-picker__content {
    width: 260px;
    min-width: 170px;
    flex-grow: 0;
    flex-shrink: 1;
    padding: 8px;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-asset-prefab-picker__browser--prefabs .ee4v-asset-prefab-picker__options {
    flex-direction: column;
    flex-wrap: nowrap;
}

.ee4v-asset-prefab-picker__browser--prefabs > .ee4v-asset-prefab-picker__detail {
    display: flex;
}

.ee4v-asset-prefab-picker__prefab-row.ee4v-ui-navigation-item {
    flex-shrink: 0;
    width: 100%;
    min-height: 52px;
    margin-bottom: 4px;
    padding: 8px;
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-asset-prefab-picker__row-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.ee4v-asset-prefab-picker__large-preview {
    flex-grow: 1;
    min-width: 0;
    min-height: 180px;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-field);
}

.ee4v-asset-prefab-picker__preview-status {
    margin-top: 12px;
    padding: 0 20px;
    -unity-text-align: middle-center;
}

.ee4v-asset-prefab-picker__detail-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 16px;
}

.ee4v-asset-prefab-picker__metadata {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 16px;
}

.ee4v-asset-prefab-picker__preview-name,
.ee4v-asset-prefab-picker__preview-path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-asset-prefab-picker__preview-name {
    font-size: 15px;
}

.ee4v-asset-prefab-picker__preview-path {
    margin-top: 4px;
}

.ee4v-asset-prefab-picker__add.ee4v-ui-button {
    flex-shrink: 0;
    min-height: 36px;
    padding: 0 16px;
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-tool-active);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-asset-prefab-picker__add.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-tool-active-hover);
}

.ee4v-asset-prefab-picker__empty {
    width: 100%;
    margin-top: 24px;
}

.ee4v-workspace__library,
.ee4v-workspace__library > .unity-two-pane-split-view {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--ee4v-color-panel);
}

.ee4v-modification-workflow__processing {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: var(--ee4v-space-3xl);
}

.ee4v-modification-workflow__processing > .ee4v-ui-status-overlay {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.ee4v-modification-workflow__primary-action.ee4v-ui-button {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-tool-active);
}

.ee4v-modification-workflow__primary-action.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-tool-active-hover);
}

.ee4v-modification-workflow__selection-page {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: var(--ee4v-space-3xl) var(--ee4v-space-4xl) var(--ee4v-space-2xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__selection-header-text {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__selection-back.ee4v-ui-button {
    width: 32px;
    min-width: 32px;
    height: 32px;
    min-height: 32px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-lg);
    padding: var(--ee4v-space-none);
}

.ee4v-modification-workflow__selection-title {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-modification-workflow__selection-description {
    max-width: 720px;
}

.ee4v-modification-workflow__selection-manager.ee4v-ui-button {
    align-self: center;
    margin-top: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__creation-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-modification-workflow__creation-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    max-width: 1040px;
    align-self: center;
    padding: var(--ee4v-space-3xl) var(--ee4v-space-4xl);
}

.ee4v-modification-workflow__creation-source {
    max-width: 560px;
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__creation-layout {
    min-width: 0;
    flex-direction: row;
}

.ee4v-modification-workflow__creation-preview-column {
    min-width: 360px;
    flex-grow: 1;
    margin-right: var(--ee4v-space-2xl);
}

.ee4v-modification-workflow__creation-fields {
    width: 360px;
    min-width: 320px;
    flex-shrink: 0;
    padding: var(--ee4v-space-xl);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-modification-workflow__creation-fields > .ee4v-asset-manager-control-field {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__creation-submit.ee4v-ui-button {
    align-self: flex-end;
    margin-top: var(--ee4v-space-lg);
}

.ee4v-modification-workflow__feedback {
    margin-bottom: var(--ee4v-space-xl);
}

.ee4v-modification-workflow__empty-state {
    margin-top: var(--ee4v-space-lg);
    margin-bottom: var(--ee4v-space-xl);
}
