.ee4v-workflow-story {
    min-width: 0;
    flex-shrink: 0;
}

.ee4v-workflow-story--workflow-editor-layout,
.ee4v-workflow-story--avatar-execution-view {
    min-width: 1120px;
    height: 620px;
    min-height: 620px;
    overflow: hidden;
}

.ee4v-workflow-story--workflow-category-rail {
    width: 240px;
    align-items: flex-start;
}

.ee4v-workflow-story--workflow-category-rail > .ee4v-ui-button {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-workflow-story--workflow-avatar-overview > .ee4v-ui-button {
    align-self: flex-start;
    margin-bottom: var(--ee4v-space-lg);
}
