{
  "settings": {
    "excludedItemNamePrefixes": {
      "label": "item一覧から除外する名前の接頭辞",
      "tooltip": "アバター直下のPrefabのうち、指定した接頭辞で名前が始まるものを上部のアイテム一覧から除外します（大文字・小文字は区別しません）。自動生成されたExpression Menu専用Prefabは常に除外されます。"
    },
    "datasource": { "label": "データソース", "tooltip": "アセット管理に使用するデータソースを、ee4v・BOOTH Library Manager・Eagleから選択します。" },
    "folderLibrary": { "label": "BOOTH Library Manager フォルダーライブラリ", "tooltip": "BOOTH Library Managerで管理しているItemフォルダーの保存先を指定します（初期値は空欄）。データソースがee4vの場合は「ee4v 共通データの保存先」が使用されます。" },
    "blmDatabase": { "label": "BOOTH Library Manager データベース", "tooltip": "BOOTH Library Managerのデータベースファイル（data.db）を指定します（読み取り専用）。初期値は %APPDATA%/pm.booth.library-manager/data.db です。" },
    "autoSyncDatasource": { "label": "起動時にデータソース同期", "tooltip": "Unity Editorの起動時に、選択中のデータソースを自動で同期します。" },
    "section": {
      "assetManager": {
        "paths": "AssetManager パス",
        "source": "AssetManager データソース",
        "view": "AssetManager 表示"
      }
    },
    "eagleLibraryPath": {
      "label": "Eagle ライブラリのパス",
      "tooltip": "AssetManagerと同期するEagleライブラリ（.libraryフォルダー）のパスを指定します。"
    },
    "eagleTargetRoot": {
      "label": "Eagle の同期対象ルート",
      "tooltip": "Eagleライブラリ内で同期対象とするルートフォルダー名またはパスを指定します（既定値: VRCAsset）。"
    },
    "ee4vGlobalPath": {
      "label": "ee4v 共通データの保存先",
      "tooltip": "AssetManagerのデータベースやBlendShapeプリセットなど、プロジェクト間で共有するee4vのデータを保存するフォルダーです（既定値: Documents/ee4v）。"
    },
    "applyProjectThumbnailOnImport": {
      "label": "Import時にサムネイルをProject Styleへ設定",
      "tooltip": "有効にすると、ImportしたフォルダーにProject Styleのアイコンが未設定の場合、Itemのサムネイル画像を初期アイコンとして自動設定します。設定後もProject Styleから変更できます。"
    },
    "excludedPartNamePrefixes": {
      "label": "パーツ一覧から除外する名前の接頭辞",
      "tooltip": "指定した接頭辞で名前が始まるGameObjectとその子階層をパーツ一覧から除外します（大文字・小文字は区別しません。既定値: Armature）。"
    }
  }
}
