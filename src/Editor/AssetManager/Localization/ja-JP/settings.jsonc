{
  "settings": {
    "datasource": { "label": "データソース", "tooltip": "ee4v・BOOTH Library Manager・Eagleから1つを選択します。" },
    "folderLibrary": { "label": "BOOTH Library Manager フォルダーライブラリ", "tooltip": "BOOTH Library Managerの登録Itemフォルダーの保存先を指定します。初期値は空欄です。ee4vは共通データの保存先を使用します。" },
    "blmDatabase": { "label": "BOOTH Library Manager データベース", "tooltip": "BOOTH Library Managerのdata.dbを指定します。初期値は%APPDATA%/pm.booth.library-manager/data.dbです。読取専用です。" },
    "autoSyncDatasource": { "label": "起動時にデータソース同期", "tooltip": "選択したデータソースだけをEditor起動時に同期します。" },
    "section": {
      "assetManager": {
        "paths": "AssetManager パス",
        "source": "AssetManager データソース",
        "view": "AssetManager 表示"
      }
    },
    "eagleLibraryPath": {
      "label": "Eagle ライブラリのパス",
      "tooltip": "AssetManager の同期に使う Eagle の .library フォルダーを指定します。"
    },
    "eagleTargetRoot": {
      "label": "Eagle の同期対象ルート",
      "tooltip": "Eagle ライブラリ内で同期対象にするフォルダー名またはパスです。既定値は VRCAsset です。"
    },
    "ee4vGlobalPath": {
      "label": "ee4v 共通データの保存先",
      "tooltip": "AssetManagerのDBやBlendShapeプリセットなど、ee4vの共通データを保存するフォルダーです。既定値はDocuments/ee4vです。"
    },
    "applyProjectThumbnailOnImport": {
      "label": "Import時にサムネイルをProject Styleへ設定",
      "tooltip": "有効にすると、Importしたフォルダーにアイコンが未設定の場合だけ、ItemのサムネイルをProject Styleの初期アイコンとして設定します。あとからProject Styleで変更できます。"
    },
    "excludedPartNamePrefixes": {
      "label": "パーツ一覧から除外する名前の接頭辞",
      "tooltip": "名前が指定した文字列で始まるGameObjectとその子孫をパーツ一覧から除外します。大文字と小文字は区別しません。既定値はArmatureです。"
    }
  }
}
