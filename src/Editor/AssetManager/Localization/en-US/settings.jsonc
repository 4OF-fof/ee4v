{
  "settings": {
    "datasource": { "label": "Datasource", "tooltip": "Select exactly one datasource: ee4v, BOOTH Library Manager or Eagle." },
    "folderLibrary": { "label": "BOOTH Library Manager folder library path", "tooltip": "Directory for BOOTH Library Manager registered item folders. Empty by default. ee4v uses the global data directory." },
    "blmDatabase": { "label": "BOOTH Library Manager database path", "tooltip": "Path to the BOOTH Library Manager data.db. Defaults to %APPDATA%/pm.booth.library-manager/data.db. Read only; never modified." },
    "autoSyncDatasource": { "label": "Sync datasource on startup", "tooltip": "Synchronize only the selected datasource at editor startup." },
    "section": {
      "assetManager": {
        "paths": "AssetManager paths",
        "source": "AssetManager sources",
        "view": "AssetManager view"
      }
    },
    "eagleLibraryPath": {
      "label": "Eagle library path",
      "tooltip": "Path to the Eagle .library directory used by AssetManager synchronization."
    },
    "eagleTargetRoot": {
      "label": "Eagle target root",
      "tooltip": "Folder name or path inside the Eagle library whose descendants are synchronized. The default is VRCAsset."
    },
    "ee4vGlobalPath": {
      "label": "ee4v global data path",
      "tooltip": "Directory for shared ee4v data, including the AssetManager database and BlendShape presets. The default is Documents/ee4v."
    },
    "applyProjectThumbnailOnImport": {
      "label": "Set thumbnails in Project Style on import",
      "tooltip": "When enabled, set an item's thumbnail as the initial Project Style icon for an imported folder only when it has no icon. You can change it later in Project Style."
    },
    "excludedPartNamePrefixes": {
      "label": "Part list excluded name prefixes",
      "tooltip": "Exclude GameObjects whose names start with any listed prefix, along with their descendants. Matching ignores case. The default is Armature."
    }
  }
}
