@import url("../Foundation/ui-design-tokens.uss");

.ee4v-ui {
    flex-grow: 1;
}

.ee4v-ui Label {
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui Button {
    color: var(--ee4v-color-text-primary);
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color, color, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui Button:focus {
    border-color: var(--ee4v-color-transparent);
}

.ee4v-popup-surface {
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-overlay-border);
}

.ee4v-ui-empty-state {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-xl);
    align-items: center;
    justify-content: center;
}

.ee4v-ui-empty-state__icon {
    margin-bottom: var(--ee4v-space-md);
    opacity: 0.65;
}

.ee4v-ui-empty-state__title {
    margin-bottom: var(--ee4v-space-xs);
    -unity-text-align: middle-center;
}

.ee4v-ui-empty-state__description {
    max-width: 360px;
    -unity-text-align: upper-center;
}

.ee4v-ui-empty-state__actions {
    flex-direction: row;
    margin-top: var(--ee4v-space-md);
}

.ee4v-ui-section-header {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-section-header__text {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-ui-section-header__description {
    margin-top: var(--ee4v-space-xs);
}

.ee4v-ui-section-header__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ee4v-ui-item-row {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-item-row__leading,
.ee4v-ui-item-row__trailing {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ee4v-ui-item-row__icon {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-ui-item-row__text {
    min-width: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-item-row--stacked .ee4v-ui-item-row__text {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-ui-item-row__title {
    min-width: 0;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-ui-item-row__description {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-md);
}

.ee4v-ui-item-row--stacked .ee4v-ui-item-row__description {
    margin-left: 0;
    margin-top: var(--ee4v-space-xs);
}

.ee4v-ui-form-input {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    align-self: stretch;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-form-input__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-md);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-form-input__input {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
}

.ee4v-ui-form-input__input.ee4v-ui-input-field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-ui-form-input__input.unity-base-field > .unity-base-field__label,
.ee4v-ui-form-input__input.unity-base-field > .unity-text-field__label {
    display: none;
}

.ee4v-ui-form-input__button {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-md);
}

.ee4v-ui-input-group {
    position: relative;
    min-width: 0;
    min-height: 42px;
    align-self: stretch;
    flex-shrink: 1;
    margin-top: var(--ee4v-space-md);
    padding: var(--ee4v-space-xl) var(--ee4v-space-lg) var(--ee4v-space-md);
    border-width: 2px;
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-transparent);
    overflow: visible;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-input-group:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-input-group--focused,
.ee4v-ui-input-group--focused:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-input-group__label {
    position: absolute;
    left: var(--ee4v-space-lg);
    top: -9px;
    flex-shrink: 0;
    margin: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    background-color: var(--ee4v-color-surface-raised);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-input-group__content {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: stretch;
}

.ee4v-ui-standard-input.unity-base-field {
    min-height: var(--ee4v-control-height-default);
    justify-content: center;
}

.ee4v-ui-standard-input.unity-base-text-field > .unity-base-field__input,
.ee4v-ui-standard-input.unity-toggle > .unity-base-field__input,
.ee4v-ui-standard-input.unity-object-field > .unity-base-field__input {
    width: auto;
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    height: auto;
    max-height: 10000px;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-standard-input.unity-text-field > .unity-base-field__input,
.ee4v-ui-standard-input.unity-base-text-field > .unity-base-field__input {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none) var(--ee4v-space-sm);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-left;
}

.ee4v-ui-standard-input.unity-text-field:hover > .unity-base-field__input,
.ee4v-ui-standard-input.unity-base-text-field:hover > .unity-base-field__input {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-standard-input.ee4v-ui-standard-input--focused.unity-text-field > .unity-base-field__input,
.ee4v-ui-standard-input.ee4v-ui-standard-input--focused.unity-base-text-field > .unity-base-field__input {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-standard-input .unity-base-text-field__input,
.ee4v-ui-standard-input .unity-text-field__input {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-left;
}

.ee4v-ui-standard-input.unity-toggle > .unity-toggle__input {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    flex-grow: 1;
    align-items: center;
    margin: var(--ee4v-space-none);
}

.ee4v-ui-standard-input.unity-toggle .unity-toggle__checkmark {
    width: var(--ee4v-size-28);
    min-width: var(--ee4v-size-28);
    height: var(--ee4v-size-18);
    min-height: var(--ee4v-size-18);
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-xxs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-pill);
    background-color: var(--ee4v-color-surface-hover-strong);
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-standard-toggle__thumb {
    width: var(--ee4v-size-12);
    min-width: var(--ee4v-size-12);
    height: var(--ee4v-size-12);
    min-height: var(--ee4v-size-12);
    margin-left: var(--ee4v-space-none);
    border-radius: var(--ee4v-radius-pill);
    background-color: var(--ee4v-color-text-muted);
    transition-property: margin-left, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-standard-input.unity-toggle:hover .unity-toggle__checkmark {
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-ui-standard-input.unity-toggle:focus .unity-toggle__checkmark,
.ee4v-ui-standard-input.unity-toggle:active .unity-toggle__checkmark {
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-ui-standard-input.unity-toggle:checked .unity-toggle__checkmark,
.ee4v-ui-standard-input.unity-toggle:checked:focus .unity-toggle__checkmark,
.ee4v-ui-standard-input.unity-toggle:checked:active .unity-toggle__checkmark {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-focus);
}

.ee4v-ui-standard-input.unity-toggle:checked:hover .unity-toggle__checkmark {
    background-color: var(--ee4v-color-tool-active-hover);
}

.ee4v-ui-standard-input.unity-toggle:checked .ee4v-ui-standard-toggle__thumb {
    margin-left: var(--ee4v-size-10);
    background-color: var(--ee4v-color-control-highlight);
}

.ee4v-ui-standard-input.unity-object-field > .unity-base-field__input {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    padding-left: var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-standard-input.unity-object-field:hover > .unity-base-field__input {
    border-color: var(--ee4v-color-focus);
}

.ee4v-ui-standard-input.ee4v-ui-standard-input--focused.unity-object-field > .unity-base-field__input {
    border-color: var(--ee4v-color-focus);
}

.ee4v-ui-standard-input .unity-base-popup-field__input,
.ee4v-ui-standard-input .unity-popup-field__input,
.ee4v-ui-standard-input .unity-enum-field__input {
    width: auto;
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    align-items: center;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none) var(--ee4v-space-sm);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-standard-input:hover .unity-base-popup-field__input,
.ee4v-ui-standard-input:hover .unity-popup-field__input,
.ee4v-ui-standard-input:hover .unity-enum-field__input,
.ee4v-ui-standard-input.ee4v-ui-standard-input--focused .unity-base-popup-field__input,
.ee4v-ui-standard-input.ee4v-ui-standard-input--focused .unity-popup-field__input,
.ee4v-ui-standard-input.ee4v-ui-standard-input--focused .unity-enum-field__input {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-standard-input .unity-base-popup-field__text,
.ee4v-ui-standard-input .unity-popup-field__text,
.ee4v-ui-standard-input .unity-enum-field__text {
    min-width: 0;
    flex-grow: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-left;
}

.ee4v-ui-standard-input .unity-base-popup-field__arrow,
.ee4v-ui-standard-input .unity-popup-field__arrow,
.ee4v-ui-standard-input .unity-enum-field__arrow {
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    min-height: var(--ee4v-size-16);
    align-self: center;
    margin: var(--ee4v-space-none);
    margin-left: var(--ee4v-space-sm);
    border-width: 0;
    background-color: var(--ee4v-color-transparent);
    -unity-background-image-tint-color: var(--ee4v-color-text-secondary);
}

.ee4v-ui-standard-input:hover .unity-base-popup-field__arrow,
.ee4v-ui-standard-input:hover .unity-popup-field__arrow,
.ee4v-ui-standard-input:hover .unity-enum-field__arrow {
    background-color: var(--ee4v-color-transparent);
    -unity-background-image-tint-color: var(--ee4v-color-text-primary);
}

.ee4v-ui-standard-input.unity-object-field .unity-object-field-display {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    height: auto;
    flex-grow: 1;
    align-items: center;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-standard-input.unity-object-field .unity-object-field-display__icon {
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    min-height: var(--ee4v-size-16);
    align-self: center;
    margin: var(--ee4v-space-none) var(--ee4v-space-sm) var(--ee4v-space-none) var(--ee4v-space-none);
}

.ee4v-ui-standard-input.unity-object-field .unity-object-field-display__label {
    min-width: 0;
    flex-grow: 1;
    align-self: stretch;
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    -unity-text-align: middle-left;
}

.ee4v-ui-standard-input.unity-object-field .unity-object-field-selector {
    width: var(--ee4v-size-22);
    min-width: var(--ee4v-size-22);
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    align-self: center;
    margin: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-ui-standard-input.unity-object-field .unity-object-field-selector:hover {
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-ui-inline-message {
    min-width: 0;
    flex-direction: row;
    align-items: flex-start;
}

.ee4v-ui-inline-message__icon {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-ui-inline-message__text {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-ui-inline-message--failed .ee4v-ui-inline-message__text {
    color: var(--ee4v-color-status-failed-text);
}

.ee4v-ui-inline-message--passed .ee4v-ui-inline-message__text {
    color: var(--ee4v-color-status-passed-text);
}

.ee4v-ui-inline-message--running .ee4v-ui-inline-message__text {
    color: var(--ee4v-color-status-running-text);
}

.ee4v-ui-preview-container {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.ee4v-ui-preview-container__content,
.ee4v-ui-preview-container__placeholder {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-ui-preview-container__placeholder {
    align-items: center;
    justify-content: center;
}

.ee4v-ui-preview-container__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-ui-action-bar {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-action-bar__leading {
    min-width: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-action-bar__center {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ee4v-ui-action-bar__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ee4v-ui-navigation-item {
    min-width: 0;
    margin: 0;
    padding: var(--ee4v-space-sm) var(--ee4v-space-md);
    border-width: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-navigation-item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-navigation-item--selected {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-ui-navigation-item__row {
    flex-grow: 1;
}

.ee4v-ui-disclosure-section__header.ee4v-ui-button {
    width: 100%;
    justify-content: flex-start;
}

.ee4v-ui-disclosure-section__header .ee4v-ui-button__content {
    justify-content: flex-start;
}

.ee4v-ui-disclosure-section__body {
    min-width: 0;
}

.ee4v-ui-badge {
    flex-shrink: 0;
    padding: 1px var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-pill);
    background-color: var(--ee4v-color-surface-soft);
    white-space: nowrap;
    -unity-text-align: middle-center;
    align-self: flex-start;
}

.ee4v-ui-badge--status {
    min-height: var(--ee4v-size-20);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
}

.ee4v-ui-badge--idle {
    background-color: var(--ee4v-color-status-idle);
}

.ee4v-ui-badge--running {
    background-color: var(--ee4v-color-status-running);
}

.ee4v-ui-badge--passed {
    background-color: var(--ee4v-color-status-passed);
}

.ee4v-ui-badge--failed {
    background-color: var(--ee4v-color-status-failed);
}

.ee4v-ui-badge--skipped {
    background-color: var(--ee4v-color-status-skipped);
}

.ee4v-ui-badge--inconclusive {
    background-color: var(--ee4v-color-status-inconclusive);
}

.ee4v-ui .unity-scroll-view__vertical-scroller,
.ee4v-ui-thin-vertical-scrollbar .unity-scroll-view__vertical-scroller {
    width: var(--ee4v-size-8);
    min-width: var(--ee4v-size-8);
    flex-shrink: 0;
    align-self: stretch;
    margin-left: auto;
    margin-right: 0;
    background-color: var(--ee4v-color-transparent);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ee4v-ui .unity-scroll-view__horizontal-scroller {
    height: var(--ee4v-size-8);
    min-height: var(--ee4v-size-8);
    background-color: var(--ee4v-color-transparent);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ee4v-ui .unity-scroller > .unity-scroller__low-button,
.ee4v-ui .unity-scroller > .unity-scroller__high-button,
.ee4v-ui-thin-vertical-scrollbar .unity-scroller__low-button,
.ee4v-ui-thin-vertical-scrollbar .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    width: 0;
    min-width: 0;
    max-width: 0;
    height: 0;
    min-height: 0;
    max-height: 0;
}

.ee4v-ui .unity-scroller > .unity-scroller__slider,
.ee4v-ui .unity-scroller > .unity-scroller__slider .unity-base-slider__tracker,
.ee4v-ui-thin-vertical-scrollbar .unity-scroller__slider,
.ee4v-ui-thin-vertical-scrollbar .unity-base-slider__tracker {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: var(--ee4v-color-transparent);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
