.ee4v-ui-diff-confirmation {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.ee4v-ui-diff-confirmation__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ee4v-color-overlay-border);
}

.ee4v-ui-diff-confirmation__panel {
    width: 82%;
    max-width: 820px;
    height: 78%;
    min-height: 320px;
    max-height: 620px;
    border-width: 1px;
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-panel);
}

.ee4v-ui-diff-confirmation__header {
    padding: var(--ee4v-space-2xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-ui-diff-confirmation__title {
    font-size: var(--ee4v-font-size-title);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.ee4v-ui-diff-confirmation__message,
.ee4v-ui-diff-confirmation__item-meta {
    color: var(--ee4v-color-text-secondary);
}

.ee4v-ui-diff-confirmation__column-header,
.ee4v-ui-diff-confirmation__row {
    flex-direction: row;
    align-items: stretch;
}

.ee4v-ui-diff-confirmation__column-header {
    min-height: 34px;
    margin-bottom: var(--ee4v-space-lg);
    background-color: var(--ee4v-color-surface-subtle);
    border-width: 1px;
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-md);
}

.ee4v-ui-diff-confirmation__scroll {
    flex-grow: 1;
    padding: var(--ee4v-space-xl);
}

.ee4v-ui-diff-confirmation__item {
    margin-bottom: var(--ee4v-space-lg);
    border-width: 1px;
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-diff-confirmation__item-header {
    flex-direction: row;
    align-items: center;
    padding: 9px var(--ee4v-space-lg);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-ui-diff-confirmation__thumbnail {
    margin-right: var(--ee4v-space-lg);
}

.ee4v-ui-diff-confirmation__item-heading {
    flex-grow: 1;
    flex-shrink: 1;
}

.ee4v-ui-diff-confirmation__item-title {
    -unity-font-style: bold;
    margin-bottom: var(--ee4v-space-xxs);
}

.ee4v-ui-diff-confirmation__row {
    min-height: 42px;
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-ui-diff-confirmation__row--last {
    border-bottom-width: 0;
}

.ee4v-ui-diff-confirmation__value {
    flex-grow: 1;
    flex-basis: 0;
    padding: var(--ee4v-space-md) var(--ee4v-space-lg);
    border-left-width: 0;
}

.ee4v-ui-diff-confirmation__value--incoming {
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-border-subtle);
}

.ee4v-ui-diff-confirmation__actions {
    flex-direction: row;
    justify-content: flex-end;
    padding: var(--ee4v-space-lg) var(--ee4v-space-2xl);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
}

.ee4v-ui-diff-confirmation__button {
    min-width: 100px;
    height: var(--ee4v-size-28);
    margin-left: var(--ee4v-space-md);
}

.ee4v-ui-diff-confirmation__button--primary {
    background-color: var(--ee4v-color-selection);
    color: var(--ee4v-color-text-on-state);
    border-color: var(--ee4v-color-focus);
}

.ee4v-ui-diff-confirmation__button--primary:hover {
    background-color: var(--ee4v-color-focus);
}
