.ee4v-ui-context-menu {
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-overlay-border);
    border-right-color: var(--ee4v-color-overlay-border);
    border-bottom-color: var(--ee4v-color-overlay-border);
    border-left-color: var(--ee4v-color-overlay-border);
    border-top-left-radius: var(--ee4v-radius-2xl);
    border-top-right-radius: var(--ee4v-radius-2xl);
    border-bottom-left-radius: var(--ee4v-radius-2xl);
    border-bottom-right-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-raised);
    flex-grow: 1;
}

.ee4v-ui-context-menu__item {
    height: var(--ee4v-size-26);
    min-height: var(--ee4v-size-26);
    max-height: var(--ee4v-size-26);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: var(--ee4v-radius-md);
    border-top-right-radius: var(--ee4v-radius-md);
    border-bottom-left-radius: var(--ee4v-radius-md);
    border-bottom-right-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-transparent);
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-context-menu__item:hover {
    background-color: var(--ee4v-color-selection);
}

.ee4v-ui-context-menu__item:active {
    background-color: var(--ee4v-color-selection-pressed);
}

.ee4v-ui-context-menu__item--disabled,
.ee4v-ui-context-menu__item--disabled:hover,
.ee4v-ui-context-menu__item--disabled:active {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-context-menu__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.ee4v-ui-context-menu__label Label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-ui-context-menu__shortcut {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-2xl);
}

.ee4v-ui-context-menu__separator {
    height: var(--ee4v-size-1);
    min-height: var(--ee4v-size-1);
    margin-left: var(--ee4v-space-negative-xs);
    margin-right: var(--ee4v-space-negative-xs);
    margin-top: var(--ee4v-space-xs);
    margin-bottom: 3px;
    background-color: var(--ee4v-color-border-default);
}
