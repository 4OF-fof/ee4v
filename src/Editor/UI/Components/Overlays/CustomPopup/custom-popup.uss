.ee4v-ui-custom-popup {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-panel);
    overflow: hidden;
}

.ee4v-ui-custom-popup__header {
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-ui-custom-popup__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-ui-custom-popup__close.ee4v-ui-button {
    width: var(--ee4v-size-24);
    min-width: var(--ee4v-size-24);
    max-width: var(--ee4v-size-24);
    height: var(--ee4v-size-24);
    min-height: var(--ee4v-size-24);
    max-height: var(--ee4v-size-24);
    margin: var(--ee4v-space-none);
    padding: var(--ee4v-space-none);
    border-width: 0;
    background-color: var(--ee4v-color-transparent);
    align-items: center;
    justify-content: center;
}

.ee4v-ui-custom-popup__close.ee4v-ui-button:hover,
.ee4v-ui Button.ee4v-ui-button.ee4v-ui-custom-popup__close:focus {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-ui-custom-popup__footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-lg);
    padding-bottom: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-custom-popup__footer > * {
    margin-left: var(--ee4v-space-md);
}

.ee4v-ui-custom-popup__footer--hidden {
    display: none;
}
