.ee4v-ui-custom-popup {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-ui-custom-popup__header {
    height: var(--ee4v-control-height-toolbar);
    min-height: var(--ee4v-control-height-toolbar);
    max-height: var(--ee4v-control-height-toolbar);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-md);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-tab-idle);
}

.ee4v-ui-custom-popup__title {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-ui-custom-popup__header-actions {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-custom-popup__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-ui-custom-popup__footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-lg);
    padding-bottom: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-ui-custom-popup__footer > * {
    margin-left: var(--ee4v-space-md);
}

.ee4v-ui-custom-popup__footer--hidden {
    display: none;
}
