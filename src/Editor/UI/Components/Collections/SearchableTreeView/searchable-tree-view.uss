.ee4v-ui-searchable-tree-view {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: 5px;
    padding-bottom: var(--ee4v-space-sm);
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-top-left-radius: var(--ee4v-radius-2xl);
    border-top-right-radius: var(--ee4v-radius-2xl);
    border-bottom-left-radius: var(--ee4v-radius-2xl);
    border-bottom-right-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-searchable-tree-view__search {
    min-height: var(--ee4v-size-24);
    height: var(--ee4v-size-24);
}

.ee4v-ui-searchable-tree-view__tree {
    flex-grow: 1;
    min-height: 0;
    margin-top: 5px;
    padding-top: var(--ee4v-space-xs);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-transparent);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.ee4v-ui-searchable-tree-view__tree .unity-collection-view__scroll-view,
.ee4v-ui-searchable-tree-view__tree .unity-scroll-view {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-searchable-tree-view__tree .unity-scroll-view__content-container,
.ee4v-ui-searchable-tree-view__tree .unity-collection-view__content-container {
    min-width: 0;
    max-width: 100%;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-searchable-tree-view__tree .unity-collection-view__item,
.ee4v-ui-searchable-tree-view__tree .unity-tree-view__item,
.ee4v-ui-searchable-tree-view__tree .unity-list-view__item {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.ee4v-ui-searchable-tree-view__tree .unity-collection-view__item:hover,
.ee4v-ui-searchable-tree-view__tree .unity-tree-view__item:hover,
.ee4v-ui-searchable-tree-view__tree .unity-list-view__item:hover {
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-ui-searchable-tree-view__tree .unity-collection-view__item--selected,
.ee4v-ui-searchable-tree-view__tree .unity-collection-view__item--selected:hover,
.ee4v-ui-searchable-tree-view__tree .unity-tree-view__item--selected,
.ee4v-ui-searchable-tree-view__tree .unity-tree-view__item--selected:hover,
.ee4v-ui-searchable-tree-view__tree .unity-list-view__item--selected,
.ee4v-ui-searchable-tree-view__tree .unity-list-view__item--selected:hover {
    background-color: var(--ee4v-color-selection);
}

.ee4v-ui-searchable-tree-view__empty {
    margin-top: 5px;
    padding-top: var(--ee4v-space-sm);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    color: var(--ee4v-color-text-muted);
    white-space: normal;
}
