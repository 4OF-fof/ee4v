.ee4v-ui-scene-preview-viewport,
.ee4v-ui-scene-preview-viewport__surface,
.ee4v-ui-scene-preview-viewport__render {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
}

.ee4v-ui-scene-preview-viewport {
    position: relative;
    overflow: hidden;
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-ui-scene-preview-viewport__feature-overlay,
.ee4v-ui-scene-preview-viewport__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-ui-scene-preview-viewport__placeholder {
    align-items: center;
    justify-content: center;
}

.ee4v-ui-scene-preview-viewport__actions {
    position: absolute;
    top: var(--ee4v-space-lg);
    right: var(--ee4v-space-lg);
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-scene-preview-viewport__action.ee4v-ui-button {
    width: 32px;
    min-width: 32px;
    height: 32px;
    min-height: 32px;
    padding: var(--ee4v-space-none);
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-scene-preview-viewport__reset.ee4v-ui-button {
    margin-left: var(--ee4v-space-sm);
}

.ee4v-ui-scene-preview-viewport__action.ee4v-ui-button:hover,
.ee4v-ui-scene-preview-viewport__action.ee4v-ui-button:active,
.ee4v-ui-scene-preview-viewport__background--light.ee4v-ui-button {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}
