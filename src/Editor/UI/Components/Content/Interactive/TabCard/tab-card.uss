.ee4v-ui-tab-card {
    flex-direction: column;
}

.ee4v-ui-tab-card__tabs {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-sm);
    margin-bottom: -1px;
    justify-content: flex-start;
}

.ee4v-ui-tab-card__tab {
    margin-right: var(--ee4v-space-xxs);
    margin-bottom: var(--ee4v-space-none);
    min-height: 0;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: 3px;
    padding-bottom: var(--ee4v-space-xs);
    border-top-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-tab-idle);
    color: var(--ee4v-color-text-muted);
    align-self: flex-end;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-tab-card__tab:hover {
    background-color: var(--ee4v-color-surface-hover);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-tab-card__tab--selected,
.ee4v-ui-tab-card__tab--selected:hover {
    background-color: var(--ee4v-color-panel);
    border-top-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-panel);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-tab-card__panel {
    flex-grow: 1;
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-lg);
    padding-bottom: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-panel);
    border-top-left-radius: var(--ee4v-radius-2xl);
    border-top-right-radius: var(--ee4v-radius-2xl);
    border-bottom-left-radius: var(--ee4v-radius-2xl);
    border-bottom-right-radius: var(--ee4v-radius-2xl);
}

.ee4v-ui-tab-card__content {
    flex-grow: 1;
    flex-direction: column;
}
