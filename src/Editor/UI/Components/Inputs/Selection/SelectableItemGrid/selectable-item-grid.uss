.ee4v-ui-selectable-item-grid .ee4v-ui-item-grid__row-slot {
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-transparent);
    border-right-color: var(--ee4v-color-transparent);
    border-bottom-color: var(--ee4v-color-transparent);
    border-left-color: var(--ee4v-color-transparent);
    border-top-left-radius: var(--ee4v-radius-2xl);
    border-top-right-radius: var(--ee4v-radius-2xl);
    border-bottom-left-radius: var(--ee4v-radius-2xl);
    border-bottom-right-radius: var(--ee4v-radius-2xl);
    overflow: hidden;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-selectable-item-grid .ee4v-ui-item-grid__row-slot:hover {
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-selectable-item-grid .ee4v-ui-item-grid__row-slot.ee4v-ui-selectable-item-grid__row-slot--selected {
    border-top-color: var(--ee4v-color-focus);
    border-right-color: var(--ee4v-color-focus);
    border-bottom-color: var(--ee4v-color-focus);
    border-left-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection);
}

.ee4v-ui-selectable-item-grid__row-slot--selected .ee4v-ui-item-card__name {
    color: var(--ee4v-color-text-on-state);
}
