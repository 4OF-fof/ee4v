.ee4v-ui-draggable-toggle-group {
    flex-direction: column;
}

.ee4v-ui-draggable-toggle-group--disabled {
    opacity: 0.55;
}

.ee4v-ui-draggable-toggle-group__toggle {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 0;
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-xxs);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-draggable-toggle-group__toggle--disabled {
    opacity: 0.45;
}

.ee4v-ui-draggable-toggle-group__label {
    flex-grow: 0;
    min-width: 0;
}

.ee4v-ui-draggable-toggle-group__standard-toggle {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-md);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
}
