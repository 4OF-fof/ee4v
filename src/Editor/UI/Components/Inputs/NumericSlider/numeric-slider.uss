.ee4v-ui-numeric-slider {
    flex-direction: row;
    align-items: center;
    width: 162px;
    min-width: 72px;
    height: var(--ee4v-size-31);
    min-height: var(--ee4v-size-31);
    max-height: var(--ee4v-size-31);
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
}

.ee4v-ui-numeric-slider__endpoint {
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    max-width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    min-height: var(--ee4v-size-16);
    max-height: var(--ee4v-size-16);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-transparent);
    border-right-color: var(--ee4v-color-transparent);
    border-bottom-color: var(--ee4v-color-transparent);
    border-left-color: var(--ee4v-color-transparent);
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-numeric-slider__endpoint:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-numeric-slider__endpoint:active {
    background-color: var(--ee4v-color-surface-pressed);
}

.ee4v-ui-numeric-slider__track-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: var(--ee4v-size-24);
    height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-md);
    margin-right: var(--ee4v-space-md);
    justify-content: center;
}

.ee4v-ui-numeric-slider__track {
    position: relative;
    height: var(--ee4v-size-2);
    min-height: var(--ee4v-size-2);
    max-height: var(--ee4v-size-2);
    align-self: stretch;
    background-color: var(--ee4v-color-slider-track);
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-numeric-slider__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ee4v-color-slider-fill);
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-numeric-slider__knob {
    position: absolute;
    top: -5px;
    width: var(--ee4v-size-11);
    min-width: var(--ee4v-size-11);
    max-width: var(--ee4v-size-11);
    height: var(--ee4v-size-11);
    min-height: var(--ee4v-size-11);
    max-height: var(--ee4v-size-11);
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-control-highlight);
    transition-property: background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.ee4v-ui-numeric-slider:hover .ee4v-ui-numeric-slider__track,
.ee4v-ui-numeric-slider--dragging .ee4v-ui-numeric-slider__track {
    background-color: var(--ee4v-color-slider-track-hover);
}

.ee4v-ui-numeric-slider:hover .ee4v-ui-numeric-slider__fill,
.ee4v-ui-numeric-slider--dragging .ee4v-ui-numeric-slider__fill {
    background-color: var(--ee4v-color-slider-fill-hover);
}

.ee4v-ui-numeric-slider:hover .ee4v-ui-numeric-slider__knob,
.ee4v-ui-numeric-slider--dragging .ee4v-ui-numeric-slider__knob {
    background-color: var(--ee4v-color-slider-knob-hover);
}

.ee4v-ui-numeric-slider--disabled {
    opacity: 0.45;
}
