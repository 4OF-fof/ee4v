.ee4v-ui-prefab-selector {
    width: 100%;
    min-height: var(--ee4v-control-height-default);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-ui-prefab-selector:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-ui-prefab-selector > .ee4v-ui-navigation-item__row {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-ui-prefab-picker__body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-xl);
}

.ee4v-ui-prefab-picker__search {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-ui-prefab-picker__content {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-ui-prefab-picker__options {
    min-width: 0;
}

.ee4v-ui-prefab-picker__options--grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.ee4v-ui-prefab-picker__option {
    flex-shrink: 0;
    width: 100%;
    margin-bottom: var(--ee4v-space-xxs);
}

.ee4v-ui-prefab-picker__option--grid.ee4v-ui-navigation-item {
    width: 46%;
    min-width: 190px;
    min-height: 154px;
    flex-grow: 1;
    margin-right: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-prefab-picker__option--grid.ee4v-ui-navigation-item:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-prefab-picker__option--grid > .ee4v-ui-navigation-item__row {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-ui-prefab-picker__option--grid .ee4v-ui-item-row__leading {
    width: 100%;
}

.ee4v-ui-prefab-picker__preview--grid.ee4v-ui-prefab-thumbnail {
    width: 100%;
    min-width: 0;
    height: 104px;
    min-height: 104px;
    margin-right: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-ui-prefab-picker__option--grid .ee4v-ui-item-row__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.ee4v-ui-prefab-picker__empty {
    margin-top: var(--ee4v-size-20);
    color: var(--ee4v-color-text-muted);
}
