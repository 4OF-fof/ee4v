.ee4v-ui-string-list-field {
    align-self: stretch;
    min-width: 0;
}

.ee4v-ui-string-list-field__list {
    min-width: 0;
    max-height: 156px;
}

.ee4v-ui-string-list-field__list > .unity-scroll-view__content-viewport,
.ee4v-ui-string-list-field__list .unity-scroll-view__content-container {
    min-width: 0;
}

.ee4v-ui-string-list-field__row {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-ui-string-list-field__editor {
    align-self: stretch;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-ui-string-list-field__add-button.ee4v-ui-button {
    align-self: stretch;
    width: auto;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    height: var(--ee4v-control-height-default);
    min-height: var(--ee4v-control-height-default);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-string-list-field__add-button.ee4v-ui-button:hover {
    border-bottom-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-string-list-field__action-spacer {
    width: var(--ee4v-size-22);
    min-width: var(--ee4v-size-22);
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
}

.ee4v-ui-string-list-field__remove-button.ee4v-ui-button {
    width: var(--ee4v-size-22);
    min-width: var(--ee4v-size-22);
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
}
