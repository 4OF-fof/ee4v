:root {
    /* Unity Editor 2022.3 Dark palette measured in DESIGN.md. */
    --ee4v-color-chrome-deep: #191919;
    --ee4v-color-tab-idle: #282828;
    --ee4v-color-field: #2A2A2A;
    --ee4v-color-panel: #383838;
    --ee4v-color-surface-raised: #3C3C3C;
    --ee4v-color-control: #585858;
    --ee4v-color-tool-active: #46607C;
    --ee4v-color-selection: #2C5D87;
    --ee4v-color-focus: #3A79BB;
    --ee4v-color-text-primary: #C2C2C2;
    --ee4v-color-menu-native: #F9F9F9;

    /* Shared derived roles. Keep component USS free of raw color values. */
    --ee4v-color-transparent: rgba(0, 0, 0, 0);
    --ee4v-color-surface-subtle: rgba(255, 255, 255, 0.025);
    --ee4v-color-surface-soft: rgba(255, 255, 255, 0.035);
    --ee4v-color-surface-hover: rgba(255, 255, 255, 0.05);
    --ee4v-color-surface-hover-opaque: #424242;
    --ee4v-color-surface-hover-strong: rgba(255, 255, 255, 0.08);
    --ee4v-color-surface-pressed: rgba(255, 255, 255, 0.13);
    --ee4v-color-border-subtle: rgba(255, 255, 255, 0.06);
    --ee4v-color-border-default: rgba(255, 255, 255, 0.08);
    --ee4v-color-border-strong: rgba(255, 255, 255, 0.10);
    --ee4v-color-border-active: rgba(255, 255, 255, 0.14);
    --ee4v-color-text-secondary: rgba(194, 194, 194, 0.82);
    --ee4v-color-text-muted: rgba(194, 194, 194, 0.72);
    --ee4v-color-text-soft: rgba(194, 194, 194, 0.78);
    --ee4v-color-text-disabled: rgba(194, 194, 194, 0.36);
    --ee4v-color-control-highlight: #F9F9F9;
    --ee4v-color-selection-soft: rgba(44, 93, 135, 0.42);
    --ee4v-color-selection-soft-opaque: #334859;
    --ee4v-color-selection-pressed: #254F73;
    --ee4v-color-overlay-border: rgba(0, 0, 0, 0.45);
    --ee4v-color-scroll-thumb: rgba(194, 194, 194, 0.44);
    --ee4v-color-slider-track: rgba(194, 194, 194, 0.26);
    --ee4v-color-slider-track-hover: rgba(194, 194, 194, 0.40);
    --ee4v-color-slider-fill: rgba(194, 194, 194, 0.62);
    --ee4v-color-slider-fill-hover: rgba(194, 194, 194, 0.85);
    --ee4v-color-slider-knob-hover: #FFFFFF;

    /* Interaction states for solid controls and active tools. */
    --ee4v-color-control-hover: #646464;
    --ee4v-color-control-pressed: #4E4E4E;
    --ee4v-color-tool-active-hover: #547394;

    /* Asset tag picker colors retained from the master UI. */
    --ee4v-color-tag-pill: #4D4D4D;
    --ee4v-color-tag-pill-hover: #666666;
    --ee4v-color-tag-create: #2E7D32;
    --ee4v-color-tag-create-hover: #388E3C;

    /* Semantic colors stay centralized because Unity has no success token. */
    --ee4v-color-info: #3A79BB;
    --ee4v-color-success: #70B460;
    --ee4v-color-warning: #DCB448;
    --ee4v-color-error: #DC5C5C;
    --ee4v-color-info-surface-soft: rgba(58, 121, 187, 0.10);
    --ee4v-color-info-surface-strong: rgba(58, 121, 187, 0.22);
    --ee4v-color-warning-surface-soft: rgba(220, 180, 72, 0.10);
    --ee4v-color-error-surface-soft: rgba(220, 92, 92, 0.10);
    --ee4v-color-status-idle: rgba(128, 128, 128, 0.35);
    --ee4v-color-status-running: rgba(220, 180, 72, 0.35);
    --ee4v-color-status-passed: rgba(96, 184, 126, 0.35);
    --ee4v-color-status-failed: rgba(220, 92, 92, 0.35);
    --ee4v-color-status-skipped: rgba(122, 148, 214, 0.35);
    --ee4v-color-status-inconclusive: rgba(167, 125, 214, 0.35);
    --ee4v-color-status-idle-text: #D0D0D0;
    --ee4v-color-status-running-text: #EAC96C;
    --ee4v-color-status-passed-text: #8BD7A4;
    --ee4v-color-status-failed-text: #E78A8A;
    --ee4v-color-status-skipped-text: #A6B9EE;
    --ee4v-color-status-inconclusive-text: #C6A2EC;
    --ee4v-color-success-border-soft: rgba(112, 180, 96, 0.34);
    --ee4v-color-success-surface-soft: rgba(112, 180, 96, 0.16);
    --ee4v-color-success-surface-hover: rgba(112, 180, 96, 0.20);
    --ee4v-color-success-text: rgba(226, 245, 222, 0.96);

}

.ee4v-ui--light {
    /* Unity Editor Light palette. Keep names aligned with UiColorPalettes.UnityLight. */
    --ee4v-color-chrome-deep: #A5A5A5;
    --ee4v-color-tab-idle: #B7B7B7;
    --ee4v-color-field: #F0F0F0;
    --ee4v-color-panel: #C8C8C8;
    --ee4v-color-surface-raised: #D2D2D2;
    --ee4v-color-control: #B3B3B3;
    --ee4v-color-tool-active: #96B9D7;
    --ee4v-color-selection: #3A79BB;
    --ee4v-color-focus: #3A79BB;
    --ee4v-color-text-primary: #383838;
    --ee4v-color-menu-native: #383838;

    --ee4v-color-surface-subtle: rgba(0, 0, 0, 0.025);
    --ee4v-color-surface-soft: rgba(0, 0, 0, 0.035);
    --ee4v-color-surface-hover: rgba(0, 0, 0, 0.05);
    --ee4v-color-surface-hover-opaque: #C2C2C2;
    --ee4v-color-surface-hover-strong: rgba(0, 0, 0, 0.08);
    --ee4v-color-surface-pressed: rgba(0, 0, 0, 0.13);
    --ee4v-color-border-subtle: rgba(0, 0, 0, 0.06);
    --ee4v-color-border-default: rgba(0, 0, 0, 0.08);
    --ee4v-color-border-strong: rgba(0, 0, 0, 0.10);
    --ee4v-color-border-active: rgba(0, 0, 0, 0.14);
    --ee4v-color-text-secondary: rgba(56, 56, 56, 0.82);
    --ee4v-color-text-muted: rgba(56, 56, 56, 0.72);
    --ee4v-color-text-soft: rgba(56, 56, 56, 0.78);
    --ee4v-color-text-disabled: rgba(56, 56, 56, 0.36);
    --ee4v-color-control-highlight: #383838;
    --ee4v-color-selection-soft: rgba(58, 121, 187, 0.42);
    --ee4v-color-selection-soft-opaque: #8FAECE;
    --ee4v-color-selection-pressed: #31679F;
    --ee4v-color-overlay-border: rgba(0, 0, 0, 0.25);
    --ee4v-color-scroll-thumb: rgba(56, 56, 56, 0.44);
    --ee4v-color-slider-track: rgba(56, 56, 56, 0.26);
    --ee4v-color-slider-track-hover: rgba(56, 56, 56, 0.40);
    --ee4v-color-slider-fill: rgba(56, 56, 56, 0.62);
    --ee4v-color-slider-fill-hover: rgba(56, 56, 56, 0.85);
    --ee4v-color-slider-knob-hover: #383838;

    --ee4v-color-control-hover: #A8A8A8;
    --ee4v-color-control-pressed: #9D9D9D;
    --ee4v-color-tool-active-hover: #85ADCF;

    --ee4v-color-tag-pill: #B8B8B8;
    --ee4v-color-tag-pill-hover: #A8A8A8;
    --ee4v-color-tag-create: #3F8F38;
    --ee4v-color-tag-create-hover: #347B2F;

    --ee4v-color-info: #2F6FAE;
    --ee4v-color-success: #3F8F38;
    --ee4v-color-warning: #A77C18;
    --ee4v-color-error: #B73737;
    --ee4v-color-info-surface-soft: rgba(47, 111, 174, 0.10);
    --ee4v-color-info-surface-strong: rgba(47, 111, 174, 0.22);
    --ee4v-color-warning-surface-soft: rgba(167, 124, 24, 0.10);
    --ee4v-color-error-surface-soft: rgba(183, 55, 55, 0.10);
    --ee4v-color-status-idle: rgba(128, 128, 128, 0.25);
    --ee4v-color-status-running: rgba(167, 124, 24, 0.25);
    --ee4v-color-status-passed: rgba(63, 143, 56, 0.25);
    --ee4v-color-status-failed: rgba(183, 55, 55, 0.25);
    --ee4v-color-status-skipped: rgba(65, 85, 150, 0.25);
    --ee4v-color-status-inconclusive: rgba(110, 65, 160, 0.25);
    --ee4v-color-status-idle-text: #464646;
    --ee4v-color-status-running-text: #8C6900;
    --ee4v-color-status-passed-text: #2D7841;
    --ee4v-color-status-failed-text: #AA3737;
    --ee4v-color-status-skipped-text: #415596;
    --ee4v-color-status-inconclusive-text: #6E41A0;
    --ee4v-color-success-border-soft: rgba(63, 143, 56, 0.34);
    --ee4v-color-success-surface-soft: rgba(63, 143, 56, 0.16);
    --ee4v-color-success-surface-hover: rgba(63, 143, 56, 0.20);
    --ee4v-color-success-text: #245E22;
}
