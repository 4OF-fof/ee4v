:root {
    --ee4v-border-hairline: 1px;
    --ee4v-border-emphasis: 2px;
    --ee4v-border-strong: 3px;

    --ee4v-radius-xs: 2px;
    --ee4v-radius-sm: 3px;
    --ee4v-radius-md: 4px;
    --ee4v-radius-lg: 4px;
    --ee4v-radius-xl: 5px;
    --ee4v-radius-2xl: 6px;
    --ee4v-radius-3xl: 8px;
    --ee4v-radius-pill: 12px;
}
