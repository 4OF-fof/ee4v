.ee4v-ui-catalog-shell {
    flex-direction: row;
    flex-grow: 1;
}

.ee4v-ui-catalog-shell__navigator {
    width: 220px;
    min-width: 220px;
    max-width: 220px;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    border-right-width: var(--ee4v-border-hairline);
    border-right-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-catalog-shell__navigator-title {
    font-size: var(--ee4v-font-size-title);
    width: 100%;
    margin-bottom: var(--ee4v-space-lg);
    -unity-text-align: middle-center;
}

.ee4v-ui-catalog-tree-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-grow: 1;
    min-height: var(--ee4v-size-20);
}

.ee4v-ui-catalog-tree-item__title {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.ee4v-ui-catalog-tree-item__implementation {
    margin-left: var(--ee4v-space-md);
    color: var(--ee4v-color-text-muted);
    font-size: var(--ee4v-font-size-caption);
    -unity-text-align: middle-right;
}

.ee4v-ui-catalog-tree-item__implementation--hidden {
    display: none;
}

.ee4v-ui-catalog-shell__content {
    flex-grow: 1;
}

.ee4v-ui-catalog-page {
    flex-grow: 1;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: var(--ee4v-space-xl);
    padding-bottom: 14px;
}

.ee4v-ui-catalog-page__header {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-ui-catalog-page__body {
    flex-grow: 1;
    padding-right: var(--ee4v-space-sm);
}

.ee4v-ui-catalog-controls .unity-base-field {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-ui-catalog-controls .ee4v-ui-input-field__field {
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-ui-catalog-control-label {
    margin-bottom: var(--ee4v-space-xs);
    color: var(--ee4v-color-text-soft);
    font-size: var(--ee4v-font-size-body);
}

.ee4v-ui-catalog-detail-item {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-ui-catalog-preview-surface {
    min-height: 220px;
    padding-left: var(--ee4v-space-xl);
    padding-right: var(--ee4v-space-xl);
    padding-top: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-subtle);
    border-bottom-color: var(--ee4v-color-border-subtle);
    border-left-color: var(--ee4v-color-border-subtle);
    border-right-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-surface-subtle);
    border-top-left-radius: var(--ee4v-radius-2xl);
    border-top-right-radius: var(--ee4v-radius-2xl);
    border-bottom-left-radius: var(--ee4v-radius-2xl);
    border-bottom-right-radius: var(--ee4v-radius-2xl);
}

.ee4v-ui-catalog-preview-surface--compact {
    min-height: 0;
}

.ee4v-ui-catalog-preview-card--flush {
    margin-bottom: var(--ee4v-space-none);
}
