.ee4v-settings {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-settings__content {
    align-self: stretch;
    min-width: 0;
}

.ee4v-settings__section {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-lg);
    min-width: 0;
}

.ee4v-settings__section > .unity-foldout__toggle {
    min-height: var(--ee4v-control-height-default);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-settings__section-label {
    align-self: center;
    flex-shrink: 1;
    min-width: 0;
}

.ee4v-settings__row {
    flex-shrink: 0;
    min-height: var(--ee4v-control-height-compact);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
}

.ee4v-settings__field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    min-width: 0;
}

.ee4v-settings__field-layout {
    flex-direction: row;
    align-items: flex-start;
    align-self: stretch;
    width: 100%;
    min-width: 0;
    min-height: var(--ee4v-control-height-compact);
}

.ee4v-settings__label {
    flex-grow: 0;
    flex-shrink: 0;
    width: 24%;
    min-width: 0;
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xxs);
    color: var(--ee4v-color-text-primary);
}

.ee4v-settings__field .unity-base-field__label {
    display: none;
}

.ee4v-settings__field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
}

.ee4v-settings__row > .unity-help-box {
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-xs);
}
