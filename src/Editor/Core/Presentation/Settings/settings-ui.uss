.ee4v-settings {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-settings__content {
    align-self: stretch;
    min-width: 0;
}

.ee4v-settings__section {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-lg);
    min-width: 0;
}

.ee4v-settings__error {
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-xs);
}

.ee4v-settings__field {
    align-self: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: auto;
    min-width: 0;
}

.ee4v-settings__field-layout {
    align-items: flex-start;
    align-self: stretch;
    width: 100%;
    min-width: 0;
    min-height: var(--ee4v-control-height-compact);
}

.ee4v-settings__field.ee4v-ui-input-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-settings__label {
    color: var(--ee4v-color-text-primary);
}

.ee4v-settings__field .unity-base-field__label {
    display: none;
}

.ee4v-settings__field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 0;
}
