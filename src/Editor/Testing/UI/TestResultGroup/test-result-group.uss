/* Testing UI module. */
.ee4v-ui-test-result-group__summary-alert {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-ui-test-result-group__summary-alert .ee4v-ui-banner__message {
    white-space: nowrap;
    overflow: hidden;
}

.ee4v-ui-test-result-group__run-button {
    margin-left: var(--ee4v-space-sm);
    min-width: 72px;
    height: var(--ee4v-size-24);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-control);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-center;
    align-self: center;
}

.ee4v-ui-test-result-group__run-button:hover {
    border-top-color: var(--ee4v-color-border-active);
    border-right-color: var(--ee4v-color-border-active);
    border-bottom-color: var(--ee4v-color-border-active);
    border-left-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-control-hover);
}

.ee4v-ui-test-result-group__run-button:active {
    background-color: var(--ee4v-color-control-pressed);
}

.ee4v-ui-test-result-group__run-button:disabled {
    opacity: 0.45;
}

.ee4v-ui-test-result-group__cases-panel {
    margin-top: var(--ee4v-space-md);
    flex-direction: column;
    align-self: stretch;
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-test-result-group__cases-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: 7px;
    padding-bottom: 7px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-left;
}

.ee4v-ui-test-result-group__cases-toggle:hover {
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-ui-test-result-group__cases-chevron {
    width: var(--ee4v-size-18);
    min-width: var(--ee4v-size-18);
    max-width: var(--ee4v-size-18);
    height: var(--ee4v-size-18);
    margin-right: var(--ee4v-space-md);
    align-items: center;
    justify-content: center;
}

.ee4v-ui-test-result-group__cases-body {
    margin-top: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-lg);
    padding-bottom: var(--ee4v-space-lg);
    flex-direction: column;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: var(--ee4v-color-transparent);
    align-self: stretch;
}

.ee4v-ui-test-result-group--expanded .ee4v-ui-test-result-group__cases-toggle {
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-ui-test-result-group--expanded .ee4v-ui-test-result-group__cases-body {
    margin-top: var(--ee4v-space-none);
}

.ee4v-ui-test-result-group__case-card {
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-none);
    background-color: var(--ee4v-color-surface-subtle);
    align-self: stretch;
}

.ee4v-ui-test-result-group__case-details-panel {
    margin-top: var(--ee4v-space-md);
    flex-direction: column;
    align-self: stretch;
}

.ee4v-ui-test-result-group__case-details-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-top: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-left;
}

.ee4v-ui-test-result-group__case-details-toggle:hover {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-test-result-group__case-details-chevron {
    width: var(--ee4v-size-14);
    min-width: var(--ee4v-size-14);
    max-width: var(--ee4v-size-14);
    height: var(--ee4v-size-14);
    margin-right: var(--ee4v-space-xs);
    align-items: center;
    justify-content: center;
}

.ee4v-ui-test-result-group__case-details-title {
    font-size: var(--ee4v-font-size-small);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-test-result-group__case-details-body {
    margin-top: var(--ee4v-space-sm);
    flex-direction: column;
    align-self: stretch;
}

.ee4v-ui-test-result-group__case-details-field {
    align-self: stretch;
}
