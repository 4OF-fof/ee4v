.ee4v-expression-menu { flex-grow: 1; min-width: 0; min-height: 0; padding: 0; }
.ee4v-expression-menu__processing { position: absolute; top: 0; right: 0; bottom: 0; left: 0; min-width: 0; min-height: 0; align-items: center; justify-content: center; padding: var(--ee4v-space-2xl); background-color: var(--ee4v-color-panel); }
.ee4v-expression-menu__processing > .ee4v-ui-status-overlay { min-width: 0; max-width: 100%; flex-shrink: 1; }
.ee4v-expression-menu__scroll { flex-grow: 1; min-height: 0; min-width: 0; }
.ee4v-expression-menu__scroll .unity-scroll-view__content-container { min-width: 100%; align-items: center; }
.ee4v-expression-menu__editor { width: 100%; min-width: 0; padding: 8px; }
.ee4v-expression-menu__preview-column { flex-grow: 1; flex-shrink: 1; flex-basis: 320px; min-width: 0; min-height: 0; margin-right: 8px; }
.ee4v-expression-menu__preview.ee4v-ui-game-object-preview { flex-grow: 1; flex-shrink: 1; width: 100%; min-width: 0; min-height: 0; margin-bottom: 0; }
.ee4v-expression-menu__preview-back { position: absolute; left: var(--ee4v-space-lg); top: var(--ee4v-space-lg); }
.ee4v-expression-menu__preview-control-overlay { position: absolute; left: 0; right: 0; bottom: var(--ee4v-space-lg); align-items: center; }
.ee4v-expression-menu__preview-controls { flex-shrink: 0; min-width: 0; max-width: 90%; padding: var(--ee4v-space-xxs); border-width: var(--ee4v-border-hairline); border-color: var(--ee4v-color-border-default); border-radius: var(--ee4v-radius-xl); background-color: var(--ee4v-color-panel); }
.ee4v-expression-menu__preview-controls--sliders { width: 320px; padding: var(--ee4v-space-sm); }
.ee4v-expression-menu__preview-toggle { flex-direction: row; }
.ee4v-expression-menu__preview-controls > .unity-slider { min-width: 0; margin-top: 4px; margin-bottom: 4px; }
.ee4v-expression-menu__preview-controls > .unity-slider > .unity-base-field__label { min-width: 0; width: 100px; }
.ee4v-expression-menu__preview-controls .unity-base-slider__text-field { width: 32px; min-width: 0; flex-grow: 0; flex-shrink: 0; margin-left: 6px; margin-right: 0; }
.ee4v-expression-menu__preview-controls .unity-base-slider__text-field .unity-base-text-field__input { -unity-text-align: middle-right; }
.ee4v-expression-menu__preview-execute.ee4v-ui-button { border-width: 0; }
.ee4v-expression-menu__preview-puppet-pad { width: 108px; height: 108px; }
.ee4v-expression-menu__preview-puppet-input { position: absolute; left: 8px; right: 8px; top: 8px; bottom: 8px; }
.ee4v-expression-menu__preview-puppet-horizontal { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background-color: var(--ee4v-color-border-default); }
.ee4v-expression-menu__preview-puppet-vertical { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background-color: var(--ee4v-color-border-default); }
.ee4v-expression-menu__preview-puppet-indicator { position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; margin-left: -6px; margin-top: -6px; border-radius: 6px; background-color: var(--ee4v-color-text-secondary); }
.ee4v-expression-menu__preview-puppet-input--active .ee4v-expression-menu__preview-puppet-indicator,
.ee4v-expression-menu__preview-puppet-input:focus .ee4v-expression-menu__preview-puppet-indicator { background-color: var(--ee4v-color-focus); }
.ee4v-expression-menu__preview-parameters { white-space: normal; margin-top: 8px; }
.ee4v-expression-menu__browser-toolbar { min-height: 32px; flex-shrink: 0; margin-bottom: var(--ee4v-space-md); }
.ee4v-expression-menu__browser-layout { flex-grow: 1; flex-direction: row; min-width: 0; min-height: 0; }
.ee4v-expression-menu__browser { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: var(--ee4v-space-xl); }
.ee4v-expression-menu__browser-scroll { flex-grow: 1; min-width: 0; min-height: 0; }
.ee4v-expression-menu__browser--preview { padding: 0; }
.ee4v-expression-menu__browser--preview > .ee4v-expression-menu__preview-column { flex-basis: 0; min-height: 240px; margin-right: 0; }
.ee4v-expression-menu__inspector { width: 460px; min-width: 420px; flex-shrink: 0; min-height: 0; padding: var(--ee4v-space-2xl); border-left-width: var(--ee4v-border-hairline); border-left-color: var(--ee4v-color-border-default); background-color: var(--ee4v-color-surface-subtle); }
.ee4v-expression-menu__standalone-host .ee4v-expression-menu__inspector { width: 380px; min-width: 300px; }
.ee4v-expression-menu--narrow > .ee4v-expression-menu__browser-layout { flex-direction: column; }
.ee4v-expression-menu--narrow .ee4v-expression-menu__browser { min-height: 220px; }
.ee4v-expression-menu--narrow .ee4v-expression-menu__inspector { width: auto; min-width: 0; flex-grow: 1; min-height: 240px; border-left-width: 0; border-top-width: var(--ee4v-border-hairline); border-top-color: var(--ee4v-color-border-default); }
.ee4v-expression-menu__inspector .ee4v-expression-menu__editor { padding: 0; }
.ee4v-expression-menu__inspector .ee4v-menu-template__identity { border-width: 0; padding: 0; }
.ee4v-expression-menu__inspector .ee4v-menu-template__icon-host { width: 64px; margin-right: var(--ee4v-space-xl); }
.ee4v-expression-menu__inspector .ee4v-menu-template__icon-preview { height: 64px; }
.ee4v-expression-menu__quick-icon { margin: 0; min-width: 0; }
.ee4v-expression-menu__quick-icon > .unity-base-field__label { display: none; }
.ee4v-expression-menu__quick-details { flex-grow: 1; min-width: 0; }
.ee4v-expression-menu__card-read-only { align-self: flex-end; margin-bottom: 8px; }
.ee4v-expression-menu__quick-actions { flex-direction: row; flex-wrap: wrap; margin-left: var(--ee4v-space-xs); }
.ee4v-expression-menu__quick-actions > .ee4v-ui-button { width: 28px; height: 28px; min-height: 28px; padding: 0; margin-right: 4px; }
.ee4v-expression-menu__location { flex-direction: row; align-items: center; padding: 0 8px 16px 8px; margin-bottom: 16px; border-bottom-width: 1px; border-bottom-color: var(--ee4v-color-border-default); }
.ee4v-expression-menu__location-icon-host { width: 80px; flex-shrink: 0; margin-right: 16px; }
.ee4v-expression-menu__location-icon-preview { height: 80px; }
.ee4v-expression-menu__tree { min-width: 0; flex-shrink: 0; }
.ee4v-expression-menu__tree-link .ee4v-expression-menu__tree-read-only { align-self: center; flex-shrink: 0; margin-left: 8px; }
.ee4v-expression-menu__tree-row { flex-direction: row; align-items: center; min-height: 48px; min-width: 0; flex-shrink: 0; padding: var(--ee4v-space-xxs); margin-bottom: var(--ee4v-space-xs); border-width: var(--ee4v-border-hairline); border-color: var(--ee4v-color-transparent); border-radius: var(--ee4v-radius-lg); }
.ee4v-expression-menu__tree-row:hover { background-color: var(--ee4v-color-surface-hover); }
.ee4v-expression-menu__tree-row--current,
.ee4v-expression-menu__tree-row--current:hover { background-color: var(--ee4v-color-selection-soft); border-color: var(--ee4v-color-focus); }
.ee4v-expression-menu__tree-drop--inside,
.ee4v-expression-menu__tree-drop--inside:hover { background-color: var(--ee4v-color-selection-soft); border-color: var(--ee4v-color-focus); }
.ee4v-expression-menu__tree-drop--invalid,
.ee4v-expression-menu__tree-drop--invalid:hover { background-color: var(--ee4v-color-error-surface-soft); }
.ee4v-expression-menu__tree-row .ee4v-ui-button,
.ee4v-expression-menu__tree-row .ee4v-ui-button:hover { border-color: var(--ee4v-color-transparent); background-color: var(--ee4v-color-transparent); }
.ee4v-ui .ee4v-expression-menu__tree-row .ee4v-ui-button:focus { border-color: var(--ee4v-color-focus); background-color: var(--ee4v-color-transparent); }
.ee4v-expression-menu__tree-row .ee4v-ui-button:active { background-color: var(--ee4v-color-surface-pressed); }
.ee4v-expression-menu__tree-row > .ee4v-ui-button.ee4v-expression-menu__tree-link,
.ee4v-expression-menu__tree-row > .ee4v-ui-button.ee4v-expression-menu__tree-link:hover,
.ee4v-expression-menu__tree-row > .ee4v-ui-button.ee4v-expression-menu__tree-link:active,
.ee4v-ui .ee4v-expression-menu__tree-row > .ee4v-ui-button.ee4v-expression-menu__tree-link:focus { border-color: var(--ee4v-color-transparent); background-color: var(--ee4v-color-transparent); background-image: none; }
.ee4v-expression-menu__tree-row--focused { border-color: var(--ee4v-color-focus); }
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-remove,
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-remove:hover,
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-remove:active,
.ee4v-ui .ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-remove:focus { border-width: 0; background-color: var(--ee4v-color-transparent); }
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-toggle,
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-toggle:hover,
.ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-toggle:active,
.ee4v-ui .ee4v-expression-menu__tree-row .ee4v-ui-button.ee4v-expression-menu__tree-toggle:focus { border-width: 0; background-color: var(--ee4v-color-transparent); background-image: none; }
.ee4v-expression-menu__tree-insertion-line { position: absolute; height: var(--ee4v-border-hairline); background-color: var(--ee4v-color-focus); display: none; }
.ee4v-expression-menu__tree-row > .ee4v-expression-menu__tree-toggle { width: 24px; height: 40px; min-height: 40px; flex-shrink: 0; }
.ee4v-expression-menu__tree-spacer { width: 24px; flex-shrink: 0; }
.ee4v-expression-menu__tree-row > .ee4v-expression-menu__tree-link { flex-grow: 1; min-width: 0; height: 40px; min-height: 40px; padding: 2px 8px; }
.ee4v-expression-menu__tree-link > .ee4v-ui-button__content { width: 100%; }
.ee4v-expression-menu__tree-link .ee4v-ui-secondary-text { flex-shrink: 0; margin-left: var(--ee4v-space-sm); }
.ee4v-expression-menu__tree-link .ee4v-ui-button__label { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.ee4v-expression-menu__tree-icon { width: 28px; height: 28px; flex-shrink: 0; margin-right: 8px; }
.ee4v-expression-menu__tree-icon--root { width: 20px; height: 20px; margin-left: 4px; margin-right: 12px; }
.ee4v-expression-menu__tree-children { margin-left: 12px; padding-left: 11px; border-left-width: 1px; border-left-color: var(--ee4v-color-border-default); }
.ee4v-expression-menu__tree-add-row { border-color: var(--ee4v-color-transparent); }
.ee4v-expression-menu__tree-add .ee4v-ui-button__icon { width: 28px; height: 28px; margin-right: 8px; }
.ee4v-expression-menu__standalone-host > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { height: 100%; flex-grow: 1; }
.ee4v-menu-template { margin-top: 6px; margin-bottom: 6px; max-width: 680px; width: 100%; align-self: center; }
.ee4v-menu-template__identity { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 16px; padding: 12px; border-width: 1px; border-color: var(--ee4v-color-border-default); border-radius: 4px; }
.ee4v-menu-template__icon-host { width: 144px; flex-shrink: 0; margin-right: 16px; border-width: 1px; border-color: var(--ee4v-color-border-default); border-radius: 4px; overflow: hidden; }
.ee4v-menu-template__icon-preview { width: 100%; height: 142px; flex-shrink: 0; }
.ee4v-menu-template__icon { height: 22px; min-height: 22px; flex-shrink: 0; margin: 0; }
.ee4v-menu-template__icon > .unity-base-field__label { display: none; }
.ee4v-menu-template__icon > .unity-base-field__input { min-width: 0; border-radius: 0; }
.ee4v-menu-template__details { flex-grow: 1; flex-basis: 128px; min-width: 128px; }
.ee4v-menu-template__name { min-width: 0; margin-bottom: 12px; }
.ee4v-menu-template__settings { min-width: 0; }
.ee4v-menu-template__settings > * { margin-bottom: 8px; }
.ee4v-menu-template__settings .unity-popup-field > .unity-base-field__label { display: none; }
.ee4v-menu-template__settings .unity-popup-field,
.ee4v-menu-template__settings .unity-float-field { flex-direction: column; align-items: stretch; }
.ee4v-menu-template__settings .unity-popup-field > .unity-base-field__label,
.ee4v-menu-template__settings .unity-float-field > .unity-base-field__label { width: auto; min-width: 0; margin-bottom: 4px; }
.ee4v-menu-template__change { margin-top: 8px; margin-bottom: 8px; padding: 12px; border-width: 1px; border-color: var(--ee4v-color-border-default); border-radius: 4px; }
.ee4v-menu-template__change > * { margin-bottom: 6px; }
.ee4v-menu-template__change > .ee4v-ui-section-header { padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: var(--ee4v-color-border-default); }
.ee4v-menu-template__remove-action.ee4v-ui-button,
.ee4v-menu-template__remove-entry.ee4v-ui-button { width: 24px; height: 24px; min-height: 24px; flex-shrink: 0; }
.ee4v-menu-template__entry { margin-top: 8px; padding: 8px; border-width: 1px; border-color: var(--ee4v-color-border-default); border-radius: 4px; background-color: var(--ee4v-color-surface-soft); }
.ee4v-menu-template__entry > * { margin-bottom: 6px; }
.ee4v-menu-template__entry-header { align-items: center; }
.ee4v-menu-template__entry-header .ee4v-ui-section-header__title { font-size: 12px; }
.ee4v-menu-template__change > .ee4v-menu-template__add-entry.ee4v-ui-button { align-self: stretch; margin-top: 8px; margin-bottom: 0; }
.ee4v-menu-template__range-row > .ee4v-ui-form-input__label { width: 120px; }
.ee4v-menu-template__range { flex-direction: row; align-items: center; max-width: 240px; }
.ee4v-menu-template__range-value { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; }
.ee4v-menu-template__range-value > .unity-base-field__label { display: none; }
.ee4v-menu-template__range-separator { flex-shrink: 0; margin-left: 6px; margin-right: 6px; }
.ee4v-menu-template__vector { flex-direction: row; flex-wrap: wrap; min-width: 0; }
.ee4v-menu-template__vector-value { flex-grow: 1; flex-basis: 48px; min-width: 48px; margin: 0; }
.ee4v-menu-template__vector-value > .unity-base-field__label { min-width: 12px; width: 12px; margin-right: 3px; }
.ee4v-menu-template__transition { flex-direction: row; align-items: flex-end; min-width: 0; }
.ee4v-menu-template__transition-column { flex-grow: 1; flex-basis: 0; min-width: 0; }
.ee4v-menu-template__transition-column > .ee4v-ui-secondary-text { margin-bottom: 4px; }
.ee4v-menu-template__transition-column > .unity-base-field { min-width: 0; margin: 0; }
.ee4v-menu-template__transition-column > .unity-base-field > .unity-base-field__label { display: none; }
.ee4v-menu-template__transition-arrow { flex-shrink: 0; margin-left: 8px; margin-right: 8px; margin-bottom: 2px; }
.ee4v-menu-template__change .ee4v-ui-button { align-self: flex-start; }
.ee4v-menu-template__hidden { display: none; }
.ee4v-expression-menu__ring { width: 300px; height: 300px; align-self: center; margin-top: 8px; margin-bottom: 8px; flex-shrink: 0; }
.ee4v-expression-menu__slice { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.ee4v-expression-menu__slice-visual { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ee4v-expression-menu__line-holder { position: absolute; left: 50%; top: 50%; }
.ee4v-expression-menu__labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: visible; }
.ee4v-expression-menu .ee4v-expression-menu__slot,
.ee4v-expression-menu .ee4v-expression-menu__slot:hover,
.ee4v-ui .ee4v-expression-menu .ee4v-expression-menu__slot:focus,
.ee4v-expression-menu .ee4v-expression-menu__slot:active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
.ee4v-expression-menu__slot-content {
    position: absolute;
    width: 100px;
    height: 100px;
    margin-left: -50px;
    margin-top: -50px;
    flex-direction: column;
}
.ee4v-expression-menu__slot:disabled { opacity: 1; }
.ee4v-expression-menu__slot-content Image { width: 50px; height: 50px; flex-shrink: 0; }
.ee4v-expression-menu__slot-content .ee4v-ui-button__label { width: 100px; min-height: 18px; flex-shrink: 0; overflow: visible; }
.ee4v-expression-menu__sub-icon { position: absolute; left: 60px; top: 43px; width: 25px; height: 25px; background-color: rgb(56, 61, 69); border-radius: 15px; align-items: center; justify-content: center; }
.ee4v-expression-menu__sub-icon Image { width: 20px; height: 20px; }
.ee4v-expression-menu__running-indicator { position: absolute; left: 0; top: 0; width: 50px; height: 50px; }
.ee4v-expression-menu__center {
    position: absolute;
    left: 100px;
    top: 100px;
}
