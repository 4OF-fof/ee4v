    padding: 0 var(--ee4v-space-md);
}

.ee4v-avatar-info__details-constraint-group--collapsible .ee4v-avatar-info__details-constraint-card {
    margin: 0;
    padding: var(--ee4v-space-md) 0;
    border-width: 0;
    border-radius: 0;
}

.ee4v-avatar-info__details-constraint-group--collapsible .ee4v-avatar-info__details-constraint-card--separated {
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
}

.ee4v-avatar-info__constraint-graph {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    min-width: 0;
    min-height: 500px;
    margin-top: var(--ee4v-space-md);
}

.ee4v-avatar-info__constraint-graph-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-avatar-info__constraint-graph-toolbar > .ee4v-ui-secondary-text {
    margin: 0 var(--ee4v-space-sm);
}

.ee4v-avatar-info__constraint-graph-viewport {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 220px;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-soft);
    overflow: hidden;
}

.ee4v-avatar-info__constraint-graph-node.ee4v-ui-button {
    position: absolute;
    margin: 0;
    min-width: 0;
    padding: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-avatar-info__constraint-graph-node > .ee4v-ui-button__content {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    min-width: 0;
}

.ee4v-avatar-info__constraint-graph-node-name,
.ee4v-avatar-info__constraint-graph-node-type {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-avatar-info__constraint-graph-node-type {
    margin-top: var(--ee4v-space-sm);
    font-size: 11px;
}

.ee4v-avatar-info__constraint-graph-node--ancestor.ee4v-ui-button {
    border-color: var(--ee4v-color-focus);
}

.ee4v-avatar-info__constraint-graph-node--selected.ee4v-ui-button,
.ee4v-avatar-info__constraint-graph-node.ee4v-ui-button:hover,
.ee4v-avatar-info__constraint-graph-node.ee4v-ui-button:focus {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft-opaque);
}

.ee4v-avatar-info__constraint-graph-selection {
    height: 220px;
    min-height: 0;
    flex-shrink: 0;
}

.ee4v-avatar-info__constraint-graph-selection > .ee4v-avatar-info__details-children {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-height: 0;
    max-height: none;
}

.ee4v-avatar-info__details-selection--fill > .ee4v-avatar-info__details-children {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    max-height: none;
}

.ee4v-avatar-info__details-bone-tree.ee4v-ui-searchable-tree-view {
    flex-basis: 0;
    min-width: 0;
    min-height: 64px;
    margin-top: var(--ee4v-space-sm);
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}

.ee4v-avatar-info__details-bone-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.ee4v-avatar-info__details-bone-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ee4v-avatar-info__details-bone-name > .unity-label {
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-avatar-info__details-bone-count {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
    padding: var(--ee4v-space-xs) var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-avatar-info__details-bone-attachment {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
    padding: var(--ee4v-space-xs) var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-selection-soft);
}
