.ee4v-avatar-info__controls-content {
    min-width: 0;
    padding: var(--ee4v-space-2xl);
}

.ee4v-avatar-info__overview-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-avatar-info__overview-section-title {
    margin-top: var(--ee4v-space-2xl);
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-avatar-info__overview-warning {
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-avatar-info__overview-warning > .ee4v-ui-button {
    align-self: flex-end;
    margin-top: var(--ee4v-space-sm);
}

.ee4v-avatar-info__overview > .ee4v-ui-form-input {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}

.ee4v-avatar-info__performance-header > .ee4v-ui-button {
    margin-left: var(--ee4v-space-md);
}

.ee4v-avatar-info__overview .ee4v-ui-form-input__label {
    width: 100px;
}

.ee4v-avatar-info__captured-at-footer {
    margin-top: var(--ee4v-space-xl);
}

.ee4v-avatar-info__captured-at {
    margin-top: var(--ee4v-space-xs);
}

.ee4v-avatar-info__performance-summary,
.ee4v-avatar-info__performance-card {
    min-width: 0;
    border-width: var(--ee4v-border-hairline);
    border-left-width: 3px;
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-avatar-info__performance-summary {
    padding: var(--ee4v-space-xl);
    margin-top: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-summary-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-summary-title {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    margin-right: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-summary-help {
    min-width: 0;
    margin-top: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-aao {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-platform-switch {
    flex-direction: row;
    flex-shrink: 0;
    padding: var(--ee4v-space-xs);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-avatar-info__performance-platform-button.ee4v-ui-button {
    min-width: 34px;
    min-height: 24px;
    padding: var(--ee4v-space-xs) var(--ee4v-space-md);
    font-size: 11px;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-avatar-info__performance-platform-button--active.ee4v-ui-button,
.ee4v-avatar-info__performance-platform-button--active.ee4v-ui-button:hover {
    background-color: var(--ee4v-color-selection-soft);
    border-color: var(--ee4v-color-focus);
}

.ee4v-avatar-info__performance-scale {
    flex-direction: row;
    margin-top: var(--ee4v-space-lg);
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-avatar-info__performance-scale-step {
    height: 6px;
    flex-grow: 1;
    margin-right: var(--ee4v-space-xs);
    border-radius: var(--ee4v-radius-sm);
    opacity: 0.25;
}

.ee4v-avatar-info__performance-scale-step--active {
    opacity: 1;
}

.ee4v-avatar-info__performance-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -4px;
    margin-right: -4px;
}

.ee4v-avatar-info__performance-card {
    flex-basis: 45%;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 4px;
    padding: var(--ee4v-space-lg);
}

.ee4v-avatar-info__information-grid {
    margin-top: var(--ee4v-space-md);
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-avatar-info__information-card {
    min-width: 145px;
}

.ee4v-avatar-info__parameter-card {
    flex-basis: 100%;
}

.ee4v-avatar-info__parameter-items {
    margin-top: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-sm);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
}

.ee4v-avatar-info__parameter-budget {
    height: 10px;
}

.ee4v-avatar-info__parameter-budget-used {
    height: 100%;
    flex-direction: row;
}

.ee4v-avatar-info__parameter-budget-segment {
    height: 100%;
    flex-shrink: 0;
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-surface-raised);
}

.ee4v-avatar-info__parameter-items-help {
    white-space: normal;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-avatar-info__parameter-item {
    flex-direction: row;
    align-items: center;
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
}

.ee4v-avatar-info__parameter-item-name {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--ee4v-space-md);
}

.ee4v-avatar-info__parameter-item-color {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
}

.ee4v-avatar-info__parameter-item-value {
    flex-shrink: 0;
}

.ee4v-avatar-info__performance-card-label {
    min-height: 28px;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-avatar-info__performance-card-values {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-avatar-info__performance-card-value {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-avatar-info__performance-card-rating {
    padding: var(--ee4v-space-xs) var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-md);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-avatar-info__performance-budget {
    height: 5px;
    overflow: hidden;
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-avatar-info__performance-budget-fill {
    height: 100%;
    border-radius: var(--ee4v-radius-sm);
}

.ee4v-avatar-info__performance-card-budget-label {
    margin-top: var(--ee4v-space-sm);
}

.ee4v-avatar-info__performance--warning {
    background-color: var(--ee4v-color-warning-surface-soft);
}

.ee4v-avatar-info__performance--critical {
    background-color: var(--ee4v-color-error-surface-soft);
}
