.ee4v-physbone-collider {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-lg);
}

.ee4v-physbone-collider__toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-physbone-collider__avatar {
    flex-grow: 1;
    min-width: 200px;
}

.ee4v-physbone-collider__avatar > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__status {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__workspace {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    margin-top: var(--ee4v-space-md);
}

.ee4v-physbone-collider__preview-pane,
.ee4v-physbone-collider__editor-pane {
    min-height: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-physbone-collider__preview-pane {
    flex-grow: 1;
    min-width: 320px;
    position: relative;
    margin-right: var(--ee4v-space-lg);
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-physbone-collider__preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-physbone-collider__reset-view {
    position: absolute;
    top: var(--ee4v-space-md);
    right: var(--ee4v-space-md);
}

.ee4v-physbone-collider__preview-layers {
    position: absolute;
    top: var(--ee4v-space-md);
    left: var(--ee4v-space-md);
    padding: var(--ee4v-space-xs) var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-physbone-collider__preview-layers > .unity-toggle {
    margin-top: 1px;
    margin-bottom: 1px;
}

.ee4v-physbone-collider__preview-help {
    position: absolute;
    left: var(--ee4v-space-md);
    right: var(--ee4v-space-md);
    bottom: var(--ee4v-space-sm);
    color: var(--ee4v-color-text-secondary);
    -unity-text-align: middle-center;
}

.ee4v-physbone-collider__editor-pane {
    width: 400px;
    min-width: 360px;
    flex-shrink: 0;
    padding: var(--ee4v-space-md);
}

.ee4v-physbone-collider__editor-content {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-physbone-collider__layout-controls,
.ee4v-physbone-collider__detail-group {
    flex-shrink: 0;
    padding: var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-soft);
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-physbone-collider__preset {
    margin-top: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__preset > .unity-base-field__label,
.ee4v-physbone-collider__minimum-length > .unity-base-field__label {
    width: 74px;
    min-width: 74px;
}

.ee4v-physbone-collider__scan-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__minimum-length {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__scan {
    flex-shrink: 0;
}

.ee4v-physbone-collider__candidates {
    height: 155px;
    min-height: 155px;
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
}

.ee4v-physbone-collider__selection-row {
    height: 28px;
    min-height: 28px;
    flex-shrink: 0;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__candidate {
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-physbone-collider__selection-row--selected {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-physbone-collider__selection-toggle {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__selection-row .ee4v-ui-item-row__title {
    height: 24px;
    -unity-text-align: middle-left;
}

.ee4v-physbone-collider__detail {
    flex-shrink: 0;
}

.ee4v-physbone-collider__selected-bone {
    min-height: 20px;
    overflow: hidden;
    white-space: nowrap;
    -unity-font-style: bold;
    margin-top: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__detail-group > .unity-base-field {
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__detail-group > .unity-base-field > .unity-base-field__label {
    width: 80px;
    min-width: 80px;
}

.ee4v-physbone-collider__size {
    flex-direction: row;
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__size > .unity-base-field {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__size > .unity-base-field > .unity-base-field__label {
    width: 48px;
    min-width: 48px;
}

.ee4v-physbone-collider__position,
.ee4v-physbone-collider__rotation {
    flex-direction: row;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__position > .unity-base-field,
.ee4v-physbone-collider__rotation > .unity-base-field {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__position > .unity-base-field > .unity-base-field__label,
.ee4v-physbone-collider__rotation > .unity-base-field > .unity-base-field__label {
    width: 14px;
    min-width: 14px;
}

.ee4v-physbone-collider__physbone-title {
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__physbone-root-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__physbone-root {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-physbone-collider__physbone-root > .unity-base-field__label {
    width: 80px;
    min-width: 80px;
}

.ee4v-physbone-collider__remove-physbone-root {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__add-physbone-root,
.ee4v-physbone-collider__detect-physbones {
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__physbone-target {
    min-height: 26px;
    height: 26px;
}

.ee4v-physbone-collider__target-actions {
    flex-direction: row;
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__target-actions > .unity-button {
    flex-grow: 1;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__physbones {
    height: 110px;
    flex-shrink: 0;
    margin-top: var(--ee4v-space-xs);
    margin-bottom: var(--ee4v-space-sm);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    padding: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__empty-physbones {
    color: var(--ee4v-color-text-secondary);
}

.ee4v-physbone-collider__apply {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
}
