.ee4v-physbone-collider {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-lg);
}

.ee4v-physbone-collider__toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-physbone-collider__avatar {
    flex-grow: 1;
    min-width: 200px;
    margin-right: var(--ee4v-space-md);
}

.ee4v-physbone-collider__minimum-length {
    width: 190px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__avatar > .unity-base-field__label,
.ee4v-physbone-collider__minimum-length > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__status {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__workspace {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    margin-top: var(--ee4v-space-md);
}

.ee4v-physbone-collider__preview-pane,
.ee4v-physbone-collider__editor-pane {
    min-height: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-physbone-collider__preview-pane {
    flex-grow: 1;
    min-width: 320px;
    position: relative;
    margin-right: var(--ee4v-space-lg);
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-physbone-collider__preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-physbone-collider__reset-view {
    position: absolute;
    top: var(--ee4v-space-md);
    right: var(--ee4v-space-md);
}

.ee4v-physbone-collider__preview-help {
    position: absolute;
    left: var(--ee4v-space-md);
    right: var(--ee4v-space-md);
    bottom: var(--ee4v-space-sm);
    color: var(--ee4v-color-text-secondary);
    -unity-text-align: middle-center;
}

.ee4v-physbone-collider__editor-pane {
    width: 340px;
    min-width: 300px;
    flex-shrink: 0;
    padding: var(--ee4v-space-md);
}

.ee4v-physbone-collider__candidates {
    height: 180px;
    min-height: 100px;
    flex-shrink: 1;
    margin-top: var(--ee4v-space-sm);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
}

.ee4v-physbone-collider__candidate {
    height: 28px;
    min-height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__branch-children {
    margin-left: var(--ee4v-space-lg);
    border-left-width: var(--ee4v-border-hairline);
    border-left-color: var(--ee4v-color-border-default);
}

.ee4v-physbone-collider__candidate--selected {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-physbone-collider__candidate--group {
    color: var(--ee4v-color-text-secondary);
}

.ee4v-physbone-collider__group-name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-physbone-collider__candidate > .unity-toggle {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__candidate > .unity-button {
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    border-width: 0;
    background-color: var(--ee4v-color-transparent);
    -unity-text-align: middle-left;
}

.ee4v-physbone-collider__detail {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-md);
}

.ee4v-physbone-collider__selected-bone {
    min-height: 20px;
    overflow: hidden;
    white-space: nowrap;
    -unity-font-style: bold;
}

.ee4v-physbone-collider__detail > .unity-base-field {
    margin-top: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__detail > .unity-base-field > .unity-base-field__label {
    width: 80px;
    min-width: 80px;
}

.ee4v-physbone-collider__position {
    flex-direction: row;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__position > .unity-base-field {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-physbone-collider__position > .unity-base-field > .unity-base-field__label {
    width: 14px;
    min-width: 14px;
}

.ee4v-physbone-collider__assign {
    flex-shrink: 0;
    margin-top: auto;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-physbone-collider__apply {
    flex-shrink: 0;
}
