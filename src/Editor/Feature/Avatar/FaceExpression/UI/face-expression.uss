.ee4v-face-expression {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: var(--ee4v-space-lg);
}

.ee4v-face-expression__toolbar {
    min-height: var(--ee4v-control-height-default);
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-face-expression__asset-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--ee4v-space-md);
}

.ee4v-face-expression__clip-field {
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: 0;
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-face-expression__asset-field > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-face-expression__asset-field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-face-expression__content {
    flex-grow: 1;
    min-height: 280px;
    flex-direction: row;
}

.ee4v-face-expression__preview-pane,
.ee4v-face-expression__editor-pane {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
    padding: var(--ee4v-space-md);
}

.ee4v-face-expression__preview-pane {
    margin-right: var(--ee4v-space-lg);
    position: relative;
}

.ee4v-face-expression__preview {
    flex-grow: 1;
}

.ee4v-face-expression__reset-view {
    width: var(--ee4v-size-28);
    min-width: var(--ee4v-size-28);
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    padding: var(--ee4v-space-none);
    position: absolute;
    top: var(--ee4v-space-xl);
    right: var(--ee4v-space-xl);
}

.ee4v-face-expression__editor-pane > .ee4v-ui-search-field {
    margin-top: var(--ee4v-space-md);
    margin-left: var(--ee4v-space-xs);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__section-header {
    min-height: var(--ee4v-control-height-default);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__section-header .ee4v-ui-section-title {
    flex-grow: 1;
    min-width: 0;
    margin-right: var(--ee4v-space-md);
    position: relative;
    top: 2px;
}

.ee4v-face-expression__clip-only {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-md);
}

.ee4v-face-expression__clip-only > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__clip-only > .unity-base-field__input {
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-face-expression__blend-shapes {
    flex-grow: 1;
    margin-top: var(--ee4v-space-lg);
    margin-left: var(--ee4v-space-xs);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__empty {
    flex-grow: 1;
    margin-top: var(--ee4v-space-sm);
    -unity-text-align: middle-center;
}

.ee4v-face-expression-row {
    height: 28px;
    min-width: 0;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-face-expression__validation {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-face-expression-row:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-face-expression-row__animation-toggle {
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression-row__name {
    width: 112px;
    min-width: 64px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-face-expression__back-to-library {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
    padding: var(--ee4v-space-none);
}

.ee4v-face-expression__library {
    flex-grow: 1;
    min-height: 0;
    margin-top: var(--ee4v-space-sm);
    margin-left: var(--ee4v-space-xs);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__library-content {
    flex-direction: column;
}

.ee4v-face-expression__library-row {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-face-expression__library-slot {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-face-expression__library-item {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;
    flex-direction: column;
    padding: 0;
    margin: 0;
    overflow: hidden;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-face-expression__library-item:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-face-expression__library-item > .ee4v-ui-button__content {
    width: 100%;
    align-self: stretch;
    flex-direction: column;
}

.ee4v-face-expression__library-preview {
    width: 100%;
    flex-shrink: 0;
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-face-expression__library-preview--icon {
    align-items: center;
    justify-content: center;
}

.ee4v-face-expression__library-name {
    width: 100%;
    height: 30px;
    min-width: 0;
    flex-shrink: 0;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.ee4v-face-expression-row__controls {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.ee4v-face-expression__animation-controls {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-md);
    margin-left: var(--ee4v-space-xs);
    margin-right: var(--ee4v-space-xs);
    padding: var(--ee4v-space-xs);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-xl);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-face-expression__sequence-header,
.ee4v-face-expression__playback-row {
    min-width: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-face-expression__sequence-header {
    justify-content: space-between;
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-face-expression__sequence-title {
    flex-grow: 1;
}

.ee4v-face-expression__add-pose {
    flex-shrink: 0;
    min-height: var(--ee4v-size-24);
    margin-left: var(--ee4v-space-sm);
}

.ee4v-face-expression__pose-sequence {
    height: 150px;
    min-height: 150px;
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-face-expression__pose-sequence-content {
    flex-direction: row;
    align-items: center;
    padding-bottom: var(--ee4v-space-xs);
}

.ee4v-face-expression__pose-card {
    position: relative;
    width: 112px;
    min-width: 112px;
    height: 128px;
    min-height: 128px;
    flex-shrink: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-raised);
    overflow: hidden;
}

.ee4v-face-expression__pose-card--referenced {
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-face-expression__pose-card--selected {
    border-width: var(--ee4v-border-emphasis);
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft-opaque);
}

.ee4v-face-expression__pose-select {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    padding: 0;
    border-radius: 0;
}

.ee4v-face-expression__pose-select > .ee4v-ui-button__content {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    align-items: stretch;
}

.ee4v-face-expression__pose-preview-area {
    width: 100%;
    min-height: 0;
    flex-grow: 1;
    position: relative;
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-face-expression__pose-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-face-expression__pose-caption {
    position: absolute;
    left: var(--ee4v-space-xs);
    bottom: var(--ee4v-space-xs);
    max-width: 100px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-chrome-deep);
    color: var(--ee4v-color-text-primary);
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-face-expression__pose-rename {
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin: 0;
}

.ee4v-face-expression__pose-rename > .ee4v-ui-input-field__field-container {
    height: 22px;
    min-height: 22px;
}

.ee4v-face-expression__pose-source {
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin: 0;
}

.ee4v-face-expression__pose-source > .unity-base-field__label {
    display: none;
}

.ee4v-face-expression__pose-source > .unity-base-field__input {
    min-width: 0;
    border-radius: 0;
}

.ee4v-face-expression__move-pose,
.ee4v-face-expression__remove-pose {
    position: absolute;
    top: 1px;
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    padding: var(--ee4v-space-none);
}

.ee4v-face-expression__move-pose--earlier {
    left: 1px;
}

.ee4v-face-expression__move-pose--later {
    left: 22px;
}

.ee4v-face-expression__move-pose--later-only {
    left: 1px;
}

.ee4v-face-expression__remove-pose {
    right: 1px;
}

.ee4v-face-expression__pose-transition {
    width: 92px;
    min-width: 92px;
    flex-shrink: 0;
    align-items: center;
    margin-left: var(--ee4v-space-xs);
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__insert-pose {
    width: var(--ee4v-size-24);
    min-width: var(--ee4v-size-24);
    height: var(--ee4v-size-24);
    min-height: var(--ee4v-size-24);
    margin-bottom: 2px;
    padding: var(--ee4v-space-none);
}

.ee4v-face-expression__transition-label {
    margin-bottom: 2px;
}

.ee4v-face-expression__transition-duration {
    width: 82px;
    min-width: 82px;
}

.ee4v-face-expression__transition-duration > .unity-base-field__label {
    display: none;
}

.ee4v-face-expression__transition-duration > .unity-base-field__input {
    min-width: 36px;
}

.ee4v-face-expression__playback-row {
    padding-top: var(--ee4v-space-xs);
    border-top-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-default);
}

.ee4v-face-expression__playback {
    width: var(--ee4v-size-28);
    min-width: var(--ee4v-size-28);
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    flex-shrink: 0;
    margin-right: var(--ee4v-space-sm);
    padding: var(--ee4v-space-none);
}

.ee4v-face-expression__timeline-stack {
    min-width: 72px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.ee4v-face-expression__timeline {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;
}

.ee4v-face-expression__loop > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-face-expression__loop {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-sm);
}

.ee4v-face-expression__loop > .unity-base-field__input {
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-face-expression-row--child {
    padding-left: var(--ee4v-space-3xl);
}

.ee4v-face-expression-row__slider {
    width: auto;
    min-width: 70px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: var(--ee4v-space-sm);
    margin-right: var(--ee4v-space-sm);
}

.ee4v-face-expression-row__value {
    flex-shrink: 0;
    width: 64px;
    min-width: 64px;
}

.ee4v-face-expression-row__value > .unity-base-field__label {
    display: none;
}

.ee4v-face-expression-row__value > .unity-base-field__input {
    min-width: 0;
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: var(--ee4v-border-emphasis);
    border-left-width: 0;
    border-bottom-color: var(--ee4v-color-border-active);
    border-radius: 0;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-face-expression-row__value:hover > .unity-base-field__input,
.ee4v-face-expression-row__value:focus > .unity-base-field__input {
    border-bottom-color: var(--ee4v-color-focus);
}

.ee4v-face-expression-row--header {
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-soft);
}

.ee4v-face-expression-row--header > .ee4v-face-expression-row__name {
    width: auto;
    flex-grow: 1;
    color: var(--ee4v-color-text-primary);
    -unity-font-style: bold;
}

.ee4v-gesture-assignment {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-lg);
}

.ee4v-gesture-assignment__toolbar {
    min-height: var(--ee4v-control-height-default);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-gesture-assignment__avatar {
    flex-grow: 1;
    min-width: 0;
    height: var(--ee4v-control-height-default);
    min-height: var(--ee4v-control-height-default);
    align-items: center;
    margin-right: var(--ee4v-space-md);
}

.ee4v-gesture-assignment__avatar > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-gesture-assignment__avatar > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    height: var(--ee4v-control-height-default);
    min-height: var(--ee4v-control-height-default);
    align-items: center;
}

.ee4v-gesture-assignment__avatar .unity-object-field-display {
    height: var(--ee4v-control-height-default);
    min-height: var(--ee4v-control-height-default);
    flex-direction: row;
    align-items: center;
}

.ee4v-gesture-assignment__avatar .unity-object-field-display__icon {
    width: var(--ee4v-size-16);
    min-width: var(--ee4v-size-16);
    height: var(--ee4v-size-16);
    min-height: var(--ee4v-size-16);
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: var(--ee4v-space-xs);
}

.ee4v-gesture-assignment__avatar .unity-object-field-display__label {
    flex-grow: 1;
    min-width: 0;
    align-self: stretch;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.ee4v-gesture-assignment__avatar .unity-object-field-selector {
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.ee4v-gesture-assignment__apply {
    flex-shrink: 0;
}

.ee4v-gesture-assignment__matrix {
    flex-grow: 1;
    min-width: 0;
    min-height: 220px;
    margin-top: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
    overflow: hidden;
}

.ee4v-gesture-assignment__matrix .unity-scroll-view__content-container {
    min-width: 100%;
}

.ee4v-gesture-assignment__matrix-row {
    flex-direction: row;
    flex-shrink: 0;
    width: 100%;
    min-width: 1008px;
}

.ee4v-gesture-assignment__extra-row {
    flex-shrink: 0;
    width: 100%;
    min-width: 1008px;
    border-top-width: 4px;
    border-top-color: var(--ee4v-color-border-active);
}

.ee4v-gesture-assignment__matrix-header,
.ee4v-gesture-assignment__cell {
    width: 112px;
    min-width: 112px;
    flex-grow: 1;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 0;
}

.ee4v-gesture-assignment__matrix-header {
    height: 32px;
    min-height: 32px;
    background-color: var(--ee4v-color-surface-subtle);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
}

.ee4v-gesture-assignment__matrix-header--row,
.ee4v-gesture-assignment__matrix-header--corner {
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    flex-grow: 0;
}

.ee4v-gesture-assignment__matrix-header--row {
    height: 100%;
    min-height: 128px;
}

.ee4v-gesture-assignment__cell {
    height: 100%;
    min-height: 128px;
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
}

.ee4v-gesture-assignment__cell-preview-area {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    background-color: var(--ee4v-color-chrome-deep);
}

.ee4v-gesture-assignment__cell-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-gesture-assignment__cell-empty {
    position: absolute;
    left: var(--ee4v-space-xs);
    right: var(--ee4v-space-xs);
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
}

.ee4v-gesture-assignment__cell-input {
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin: 0;
}

.ee4v-gesture-assignment__cell-input > .unity-base-field__label {
    display: none;
}

.ee4v-gesture-assignment__cell-input > .unity-base-field__input {
    min-width: 0;
    border-radius: 0;
}

.ee4v-gesture-assignment__cell--configured {
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-gesture-assignment__cell--selected {
    border-color: var(--ee4v-color-focus);
    border-width: 2px;
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-gesture-assignment__cell.ee4v-gesture-assignment__extra-add {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
    align-items: center;
    justify-content: center;
}

.ee4v-gesture-assignment__cell.ee4v-gesture-assignment__extra-add:hover {
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-gesture-assignment__cell.ee4v-gesture-assignment__extra-add:active {
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-gesture-assignment__extra-placeholder {
    border-color: var(--ee4v-color-transparent);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-gesture-assignment-settings {
    flex-grow: 1;
    min-width: 0;
    padding: var(--ee4v-space-lg);
}

.ee4v-gesture-assignment__selection {
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-gesture-assignment__controls {
    flex-direction: column;
    align-items: stretch;
}

.ee4v-gesture-assignment__settings-section {
    margin-top: var(--ee4v-space-md);
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-gesture-assignment__extra-controls {
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-gesture-assignment__extra-name {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-gesture-assignment__extra-remove {
    flex-shrink: 0;
}

.ee4v-gesture-assignment__toggle {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-xs);
}

.ee4v-face-expression-groups {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-lg);
}

.ee4v-face-expression-groups__header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-face-expression-groups__title {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-face-expression-groups__add-mesh {
    flex-shrink: 0;
}

.ee4v-face-expression-groups__list {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-face-expression-group-row {
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-face-expression-group-row:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-face-expression-group-row__name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-face-expression-group-row--section {
    border-top-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-soft);
    border-radius: 0;
}

.ee4v-face-expression-group-row--section > .ee4v-face-expression-group-row__name {
    color: var(--ee4v-color-text-primary);
    -unity-font-style: bold;
}

.ee4v-face-expression-group-row__count {
    flex-shrink: 0;
    min-width: 32px;
    -unity-text-align: middle-right;
}

.ee4v-blend-shape-preset {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: var(--ee4v-space-lg);
}

.ee4v-blend-shape-preset__avatar-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.ee4v-blend-shape-preset__avatar-field {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-blend-shape-preset__avatar-field > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    margin-right: var(--ee4v-space-sm);
}

.ee4v-blend-shape-preset__avatar-field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-blend-shape-preset__toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: var(--ee4v-control-height-default);
    margin-top: var(--ee4v-space-sm);
}

.ee4v-blend-shape-preset__source {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.ee4v-blend-shape-preset__action {
    flex-shrink: 0;
    margin-left: var(--ee4v-space-xs);
}

.ee4v-blend-shape-preset__status {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
}

.ee4v-blend-shape-preset__workspace {
    flex-grow: 1;
    min-height: 280px;
    min-width: 0;
    flex-direction: row;
    margin-top: var(--ee4v-space-lg);
}

.ee4v-blend-shape-preset__navigation,
.ee4v-blend-shape-preset__detail {
    min-height: 0;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
    padding: var(--ee4v-space-md);
}

.ee4v-blend-shape-preset__navigation {
    width: 300px;
    min-width: 220px;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-lg);
}

.ee4v-blend-shape-preset__detail {
    flex-grow: 1;
    min-width: 0;
}

.ee4v-blend-shape-preset__search {
    flex-shrink: 0;
    margin-top: var(--ee4v-space-sm);
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-blend-shape-preset__role-list,
.ee4v-blend-shape-preset__mapping-list {
    flex-grow: 1;
    min-height: 0;
}

.ee4v-blend-shape-preset__role-row {
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-sm);
}

.ee4v-blend-shape-preset__role-editor {
    width: 180px;
    min-width: 120px;
}

.ee4v-blend-shape-preset-mapping-row {
    min-width: 0;
    min-height: var(--ee4v-control-height-default);
    flex-direction: row;
    align-items: center;
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-lg);
}

.ee4v-blend-shape-preset-mapping-row:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-blend-shape-preset-mapping-row__field {
    min-width: 0;
    flex-basis: 0;
    margin-right: var(--ee4v-space-xs);
}
