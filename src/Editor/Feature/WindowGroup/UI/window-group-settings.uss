.ee4v-window-group-settings {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-window-group-settings__section-description,
.ee4v-window-group-settings__empty {
    white-space: normal;
}

.ee4v-window-group-settings__body {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
}

.ee4v-window-group-settings__sidebar {
    width: 220px;
    min-width: 180px;
    padding: var(--ee4v-space-xl);
    border-right-width: var(--ee4v-border-hairline);
    border-right-color: var(--ee4v-color-border-subtle);
    background-color: var(--ee4v-color-surface-subtle);
    overflow: hidden;
}

.ee4v-window-group-settings__section-title {
    margin-bottom: var(--ee4v-space-md);
}

.ee4v-window-group-settings__section-description {
    margin-top: var(--ee4v-space-negative-xs);
    margin-bottom: var(--ee4v-space-lg);
}

.ee4v-window-group-settings__group-list,
.ee4v-window-group-settings__window-list {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.ee4v-window-group-settings__create-group {
    margin-top: var(--ee4v-space-md);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.ee4v-window-group-settings__window-list .unity-scroll-view__content-container {
    min-width: 0;
    padding-right: var(--ee4v-space-md);
}

.ee4v-window-group-settings__group {
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    align-items: center;
    justify-content: center;
    border-color: var(--ee4v-color-transparent);
    border-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-window-group-settings__group:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-window-group-settings__group.ee4v-window-group-settings__group--selected {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-window-group-settings__detail {
    min-width: 0;
    min-height: 0;
    padding: var(--ee4v-space-2xl);
    flex-grow: 1;
    overflow: hidden;
}

.ee4v-window-group-settings__group-editor {
    min-width: 0;
    margin-bottom: var(--ee4v-space-2xl);
    padding-bottom: var(--ee4v-space-xl);
    border-bottom-width: var(--ee4v-border-hairline);
    border-bottom-color: var(--ee4v-color-border-subtle);
}

.ee4v-window-group-settings__name-row {
    min-width: 0;
    min-height: 34px;
}

.ee4v-window-group-settings__name-field {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ee4v-window-group-settings__feedback {
    margin-top: var(--ee4v-space-xs);
    white-space: normal;
}

.ee4v-window-group-settings__window-row {
    min-width: 0;
    height: 34px;
    flex-shrink: 0;
    margin-bottom: var(--ee4v-space-xs);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-sm);
    padding-bottom: var(--ee4v-space-sm);
    flex-direction: row;
    align-items: center;
    border-width: var(--ee4v-border-hairline);
    border-color: var(--ee4v-color-border-default);
    border-radius: var(--ee4v-radius-2xl);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-window-group-settings__window-row > .ee4v-ui-item-row__leading,
.ee4v-window-group-settings__window-row > .ee4v-ui-item-row__text,
.ee4v-window-group-settings__window-row > .ee4v-ui-item-row__trailing {
    min-height: var(--ee4v-control-height-default);
    align-items: center;
}

.ee4v-window-group-settings__window-row:hover {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-window-group-settings__window-row.ee4v-window-group-settings__window-row--assigned {
    border-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-selection-soft);
}

.ee4v-window-group-settings__window-toggle {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    margin-right: var(--ee4v-space-sm);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    flex-shrink: 0;
}

.ee4v-window-group-settings__window-name-column {
    min-width: 0;
    flex-grow: 1;
}

.ee4v-window-group-settings__window-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-window-group-settings__window-memberships {
    min-width: 0;
    flex-shrink: 1;
    margin-top: var(--ee4v-space-none);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-window-group-settings__follower-toggle {
    min-width: 90px;
    margin-left: var(--ee4v-space-md);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    flex-shrink: 0;
}

.ee4v-window-group-settings__window-toggle,
.ee4v-window-group-settings__follower-toggle,
.ee4v-window-group-settings__window-focus {
    height: var(--ee4v-control-height-default);
    align-self: center;
}

.ee4v-window-group-settings__follower-toggle > .unity-base-field__label {
    width: auto;
    min-width: 0;
    flex-basis: auto;
    flex-shrink: 0;
    margin-right: var(--ee4v-space-xs);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
}

.ee4v-window-group-settings__follower-toggle > .unity-base-field__input {
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.ee4v-window-group-settings__window-focus {
    min-width: 0;
    margin-left: var(--ee4v-space-md);
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.ee4v-window-group-settings__empty-title {
    margin-top: var(--ee4v-space-3xl);
    margin-bottom: var(--ee4v-space-sm);
}
