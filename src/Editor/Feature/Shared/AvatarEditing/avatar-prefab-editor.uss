.ee4v-avatar-prefab-editor { flex-grow: 1; padding: 8px; }
.ee4v-avatar-prefab-editor__toolbar { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.ee4v-avatar-prefab-editor__toolbar > .ee4v-ui-standard-input { flex-grow: 1; margin-right: 8px; }
.ee4v-avatar-prefab-editor__body { flex-grow: 1; flex-direction: row; min-height: 0; }
.ee4v-avatar-prefab-editor__preview { flex-grow: 1; flex-basis: 0; min-width: 320px; margin-right: 8px; }
.ee4v-avatar-prefab-editor__sidebar { width: 380px; min-width: 300px; flex-shrink: 0; min-height: 0; }
.ee4v-avatar-prefab-editor--without-preview .ee4v-avatar-prefab-editor__sidebar { flex-grow: 1; width: auto; }
.ee4v-avatar-prefab-editor__controls { flex-grow: 1; min-height: 0; }
