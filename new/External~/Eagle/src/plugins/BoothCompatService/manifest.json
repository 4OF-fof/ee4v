{
  "id": "dev.4of.ee4v.eagle.boothcompat.service",
  "version": "0.1.0",
  "platform": "all",
  "arch": "all",
  "name": "{{manifest.app.name}}",
  "fallbackLanguage": "en",
  "languages": [
    "en",
    "ja_JP"
  ],
  "logo": "/logo.png",
  "keywords": [
    "ee4v",
    "eagle",
    "boothmeta",
    "vrcasset"
  ],
  "devTools": true,
  "main": {
    "serviceMode": true,
    "frame": false,
    "url": "index.html",
    "width": 480,
    "height": 320,
    "minWidth": 480,
    "minHeight": 320,
    "maxWidth": 480,
    "maxHeight": 320,
    "resizable": false,
    "alwaysOnTop": false,
    "maximizable": false,
    "minimizable": false,
    "fullscreenable": false,
    "multiple": false,
    "backgroundColor": "#3a3c42"
  }
}
