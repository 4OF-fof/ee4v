.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--infomation {
    padding-top: 0;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.ee4v-asset-manager-panel__infomation-preview {
    width: 100%;
    max-width: 360px;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.ee4v-asset-manager-panel__infomation-selection-mode {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    margin-top: 4px;
}

.ee4v-asset-manager-panel__infomation-preview-text {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ee4v-asset-manager-panel__infomation-selection-count-suffix {
    margin-left: 2px;
}

.ee4v-asset-manager-panel__infomation-detail-content {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    margin-top: 10px;
    overflow: hidden;
}

.ee4v-asset-manager-file-tree {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    min-height: 20px;
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row--primary {
    padding-left: 4px;
    padding-right: 4px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgba(255, 196, 76, 0.13);
}

.ee4v-asset-manager-file-tree__title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    color: rgba(225, 225, 225, 0.92);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__title Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta {
    flex-shrink: 0;
    max-width: 36px;
    margin-left: 8px;
    color: rgba(185, 185, 185, 0.68);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta--empty {
    display: none;
}
