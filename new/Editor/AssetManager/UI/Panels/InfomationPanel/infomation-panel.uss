.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--infomation {
    padding-top: 0;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.ee4v-asset-manager-panel__infomation-preview {
    width: 100%;
    max-width: 360px;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.ee4v-asset-manager-panel__infomation-selection-mode {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    margin-top: 4px;
}

.ee4v-asset-manager-panel__infomation-preview-text {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ee4v-asset-manager-panel__infomation-selection-count-suffix {
    margin-left: 2px;
}
