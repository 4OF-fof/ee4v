.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--infomation {
    padding-top: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-xl);
    padding-bottom: var(--ee4v-space-xl);
    padding-left: var(--ee4v-space-xl);
}

.ee4v-asset-manager-panel__infomation-preview {
    width: 100%;
    max-width: 360px;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-asset-manager-panel__infomation-selection-mode {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: var(--ee4v-size-24);
    margin-top: var(--ee4v-space-xs);
}

.ee4v-asset-manager-panel__infomation-preview-text {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ee4v-asset-manager-panel__infomation-selection-count-suffix {
    margin-left: var(--ee4v-space-xxs);
}

.ee4v-asset-manager-panel__infomation-detail-content {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    margin-top: var(--ee4v-space-md);
    overflow: hidden;
}

.ee4v-asset-manager-file-tree {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    min-height: var(--ee4v-size-20);
    overflow: hidden;
}

.ee4v-asset-manager-file-tree__row--import-target,
.ee4v-asset-manager-file-tree__row--primary-file {
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-xs);
    border-left-width: var(--ee4v-border-emphasis);
    border-left-color: var(--ee4v-color-import-target);
    border-top-left-radius: var(--ee4v-radius-xs);
    border-top-right-radius: var(--ee4v-radius-xs);
    border-bottom-left-radius: var(--ee4v-radius-xs);
    border-bottom-right-radius: var(--ee4v-radius-xs);
    background-color: var(--ee4v-color-import-target-surface);
}

.ee4v-asset-manager-file-tree__row--group {
    padding-left: var(--ee4v-space-xs);
    padding-right: var(--ee4v-space-xs);
    border-left-width: var(--ee4v-border-emphasis);
}

.ee4v-asset-manager-file-tree__row--variant-group {
    border-left-color: var(--ee4v-color-info);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-file-tree__row--version-group {
    border-left-color: var(--ee4v-color-file-group);
    background-color: var(--ee4v-color-file-group-surface);
}

.ee4v-asset-manager-file-tree__title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    color: var(--ee4v-color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__title Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__row--import-target .ee4v-asset-manager-file-tree__title,
.ee4v-asset-manager-file-tree__row--primary-file .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-import-target-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--variant-group .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-status-skipped-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--version-group .ee4v-asset-manager-file-tree__title {
    color: var(--ee4v-color-file-group-text);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__meta {
    flex-shrink: 0;
    max-width: 88px;
    margin-left: var(--ee4v-space-md);
    color: var(--ee4v-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__meta Label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.ee4v-asset-manager-file-tree__row--import-target .ee4v-asset-manager-file-tree__meta,
.ee4v-asset-manager-file-tree__row--primary-file .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-import-target-meta);
}

.ee4v-asset-manager-file-tree__meta--group {
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: var(--ee4v-radius-xl);
    border-top-right-radius: var(--ee4v-radius-xl);
    border-bottom-left-radius: var(--ee4v-radius-xl);
    border-bottom-right-radius: var(--ee4v-radius-xl);
    -unity-font-style: bold;
}

.ee4v-asset-manager-file-tree__row--variant-group .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-status-skipped-text);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-asset-manager-file-tree__row--version-group .ee4v-asset-manager-file-tree__meta {
    color: var(--ee4v-color-status-running-text);
    background-color: var(--ee4v-color-warning-surface-soft);
}

.ee4v-asset-manager-file-tree__meta--empty {
    display: none;
}
