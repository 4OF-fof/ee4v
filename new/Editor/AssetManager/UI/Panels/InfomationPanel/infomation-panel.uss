.ee4v-asset-manager-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ee4v-asset-manager-panel--infomation {
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

