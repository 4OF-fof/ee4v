.ee4v-ui-main-toolbar {
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.ee4v-ui-main-toolbar__content {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 20px;
    max-height: 20px;
}

.ee4v-ui-history-navigation {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 20px;
}

.ee4v-ui-history-navigation__icon-button {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    margin-left: 0;
    margin-right: 2px;
    font-size: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-history-navigation__icon-button:hover {
    background-color: var(--ee4v-color-surface-hover);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-history-navigation__icon-button:disabled {
    color: var(--ee4v-color-text-disabled);
}

.ee4v-ui-history-navigation__breadcrumb {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 20px;
    margin-left: 6px;
    overflow: hidden;
}

.ee4v-ui-history-navigation__breadcrumb-item {
    min-width: 0;
    min-height: 0;
    height: 20px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-history-navigation__breadcrumb-item--current:hover {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item-label {
    -unity-text-align: middle-left;
    color: var(--ee4v-color-text-primary);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-ui-history-navigation__breadcrumb-item-label--current {
    color: var(--ee4v-color-text-soft);
}

.ee4v-ui-history-navigation__breadcrumb-separator {
    -unity-text-align: middle-left;
    color: var(--ee4v-color-text-muted);
    font-size: 12px;
    margin-left: 3px;
    margin-right: 3px;
}
