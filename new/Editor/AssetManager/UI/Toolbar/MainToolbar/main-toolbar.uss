.ee4v-ui-main-toolbar {
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.ee4v-ui-main-toolbar__content {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 20px;
    max-height: 20px;
}

.ee4v-ui-main-toolbar__leading {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 20px;
}

.ee4v-ui-main-toolbar__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 20px;
}

.ee4v-ui-main-toolbar .ee4v-ui-main-toolbar__slider {
    flex-shrink: 0;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
}

.ee4v-ui-main-toolbar__icon-button {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin-left: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-main-toolbar__icon-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-main-toolbar__search {
    flex-shrink: 1;
    width: 200px;
    min-width: 100px;
    margin-left: 2px;
}

.ee4v-ui-history-navigation {
    position: relative;
    top: 2px;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex-shrink: 1;
    height: 20px;
}

.ee4v-ui-history-navigation__icon-button {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 5px;
    margin-left: 0;
    margin-right: 2px;
    font-size: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-center;
}

.ee4v-ui-history-navigation__icon-button:hover {
    background-color: var(--ee4v-color-surface-hover);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-history-navigation__icon-button:disabled {
    color: var(--ee4v-color-text-disabled);
}

.ee4v-ui-history-navigation__breadcrumb {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 20px;
    margin-left: 6px;
    overflow: hidden;
}

.ee4v-ui-history-navigation__breadcrumb-item {
    min-width: 0;
    min-height: 0;
    height: 20px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-history-navigation__breadcrumb-item--current:hover {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item-label {
    -unity-text-align: middle-left;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-ui-history-navigation-overlay {
    position: absolute;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-overlay-border);
    border-right-color: var(--ee4v-color-overlay-border);
    border-bottom-color: var(--ee4v-color-overlay-border);
    border-left-color: var(--ee4v-color-overlay-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-ui-history-navigation-overlay--breadcrumb {
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-history-navigation-overlay__row {
    flex-grow: 1;
    min-width: 0;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    overflow: hidden;
    text-overflow: ellipsis;
    align-items: center;
    -unity-text-align: middle-left;
}

.ee4v-ui-history-navigation-overlay__row Label {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    -unity-text-align: middle-left;
}

.ee4v-ui-history-navigation-overlay__item {
    width: auto;
    height: 22px;
    min-height: 22px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    align-items: center;
}

.ee4v-ui-history-navigation-overlay__item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-history-navigation-overlay__item:disabled {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation-overlay--breadcrumb .ee4v-ui-history-navigation-overlay__item {
    width: auto;
    flex-shrink: 0;
}

.ee4v-ui-history-navigation-overlay--breadcrumb .ee4v-ui-history-navigation-overlay__row {
    flex-grow: 0;
}

.ee4v-ui-history-navigation-overlay__separator {
    flex-shrink: 0;
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    margin-left: 3px;
    margin-right: 3px;
    color: var(--ee4v-color-text-muted);
    align-items: center;
    -unity-text-align: middle-center;
}

.ee4v-ui-history-navigation-overlay__separator Label {
    width: 8px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    -unity-text-align: middle-center;
}
