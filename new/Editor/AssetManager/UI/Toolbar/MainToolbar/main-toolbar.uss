.ee4v-ui-main-toolbar {
    height: var(--ee4v-size-28);
    min-height: var(--ee4v-size-28);
    max-height: var(--ee4v-size-28);
    padding-left: var(--ee4v-space-md);
    padding-right: var(--ee4v-space-md);
    padding-top: var(--ee4v-space-xs);
    padding-bottom: var(--ee4v-space-xs);
}

.ee4v-ui-main-toolbar__content {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
}

.ee4v-ui-main-toolbar__leading {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: var(--ee4v-size-20);
}

.ee4v-ui-main-toolbar__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: var(--ee4v-size-20);
}

.ee4v-ui-main-toolbar .ee4v-ui-main-toolbar__slider {
    flex-shrink: 0;
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
}

.ee4v-ui-main-toolbar__icon-button {
    width: var(--ee4v-size-24);
    min-width: var(--ee4v-size-24);
    max-width: var(--ee4v-size-24);
    height: var(--ee4v-size-24);
    min-height: var(--ee4v-size-24);
    max-height: var(--ee4v-size-24);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-xxs);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-main-toolbar__icon-button:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-main-toolbar__search {
    flex-shrink: 1;
    width: 200px;
    min-width: 100px;
    margin-left: var(--ee4v-space-xxs);
}

.ee4v-ui-history-navigation {
    position: relative;
    top: 2px;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex-shrink: 1;
    height: var(--ee4v-size-20);
}

.ee4v-ui-history-navigation__icon-button {
    width: var(--ee4v-size-20);
    min-width: var(--ee4v-size-20);
    max-width: var(--ee4v-size-20);
    height: var(--ee4v-size-20);
    min-height: var(--ee4v-size-20);
    max-height: var(--ee4v-size-20);
    padding-left: var(--ee4v-space-none);
    padding-right: var(--ee4v-space-none);
    padding-top: var(--ee4v-space-none);
    padding-bottom: 5px;
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-xxs);
    font-size: var(--ee4v-font-size-body);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-center;
}

.ee4v-ui-history-navigation__icon-button:hover {
    background-color: var(--ee4v-color-surface-hover);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-history-navigation__icon-button:disabled {
    color: var(--ee4v-color-text-disabled);
}

.ee4v-ui-history-navigation__breadcrumb {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-sm);
    overflow: hidden;
}

.ee4v-ui-history-navigation__breadcrumb-item {
    min-width: 0;
    min-height: 0;
    height: var(--ee4v-size-20);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-history-navigation__breadcrumb-item--current:hover {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation__breadcrumb-item-label {
    -unity-text-align: middle-left;
    font-size: var(--ee4v-font-size-body);
    overflow: hidden;
    text-overflow: ellipsis;
}

.ee4v-ui-history-navigation-overlay {
    position: absolute;
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-overlay-border);
    border-right-color: var(--ee4v-color-overlay-border);
    border-bottom-color: var(--ee4v-color-overlay-border);
    border-left-color: var(--ee4v-color-overlay-border);
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-ui-history-navigation-overlay--breadcrumb {
    flex-direction: row;
    align-items: center;
}

.ee4v-ui-history-navigation-overlay__row {
    flex-grow: 1;
    min-width: 0;
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    max-height: var(--ee4v-size-22);
    overflow: hidden;
    text-overflow: ellipsis;
    align-items: center;
    -unity-text-align: middle-left;
}

.ee4v-ui-history-navigation-overlay__row Label {
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    max-height: var(--ee4v-size-22);
    -unity-text-align: middle-left;
}

.ee4v-ui-history-navigation-overlay__item {
    width: auto;
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    margin-left: var(--ee4v-space-none);
    margin-right: var(--ee4v-space-none);
    margin-top: var(--ee4v-space-none);
    margin-bottom: var(--ee4v-space-none);
    padding-left: var(--ee4v-space-sm);
    padding-right: var(--ee4v-space-sm);
    padding-top: var(--ee4v-space-none);
    padding-bottom: var(--ee4v-space-none);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: var(--ee4v-radius-sm);
    border-top-right-radius: var(--ee4v-radius-sm);
    border-bottom-right-radius: var(--ee4v-radius-sm);
    border-bottom-left-radius: var(--ee4v-radius-sm);
    background-color: var(--ee4v-color-transparent);
    align-items: center;
}

.ee4v-ui-history-navigation-overlay__item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-history-navigation-overlay__item:disabled {
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-history-navigation-overlay--breadcrumb .ee4v-ui-history-navigation-overlay__item {
    width: auto;
    flex-shrink: 0;
}

.ee4v-ui-history-navigation-overlay--breadcrumb .ee4v-ui-history-navigation-overlay__row {
    flex-grow: 0;
}

.ee4v-ui-history-navigation-overlay__separator {
    flex-shrink: 0;
    width: var(--ee4v-size-8);
    min-width: var(--ee4v-size-8);
    max-width: var(--ee4v-size-8);
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    max-height: var(--ee4v-size-22);
    margin-left: 3px;
    margin-right: 3px;
    color: var(--ee4v-color-text-muted);
    align-items: center;
    -unity-text-align: middle-center;
}

.ee4v-ui-history-navigation-overlay__separator Label {
    width: var(--ee4v-size-8);
    height: var(--ee4v-size-22);
    min-height: var(--ee4v-size-22);
    max-height: var(--ee4v-size-22);
    -unity-text-align: middle-center;
}
