.ee4v-ui-item-image {
    overflow: hidden;
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    border-top-width: var(--ee4v-border-hairline);
    border-right-width: var(--ee4v-border-hairline);
    border-bottom-width: var(--ee4v-border-hairline);
    border-left-width: var(--ee4v-border-hairline);
    border-top-color: var(--ee4v-color-border-strong);
    border-right-color: var(--ee4v-color-border-strong);
    border-bottom-color: var(--ee4v-color-border-strong);
    border-left-color: var(--ee4v-color-border-strong);
    background-color: var(--ee4v-color-tab-idle);
}

.ee4v-ui-item-image__image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ee4v-ui-item-image__placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ee4v-color-surface-soft);
}
