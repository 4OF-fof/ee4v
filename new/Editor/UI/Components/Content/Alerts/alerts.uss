.ee4v-ui-banner {
    padding-left: var(--ee4v-space-lg);
    padding-right: var(--ee4v-space-lg);
    padding-top: var(--ee4v-space-md);
    padding-bottom: var(--ee4v-space-md);
    border-left-width: var(--ee4v-border-strong);
    border-top-left-radius: var(--ee4v-radius-lg);
    border-top-right-radius: var(--ee4v-radius-lg);
    border-bottom-left-radius: var(--ee4v-radius-lg);
    border-bottom-right-radius: var(--ee4v-radius-lg);
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-banner__title {
    margin-bottom: var(--ee4v-space-xxs);
}

.ee4v-ui-banner__message {
    color: var(--ee4v-color-text-secondary);
    white-space: normal;
}

.ee4v-ui-banner--info {
    border-left-color: var(--ee4v-color-info);
    background-color: var(--ee4v-color-info-surface-soft);
}

.ee4v-ui-banner--warning {
    border-left-color: var(--ee4v-color-warning);
    background-color: var(--ee4v-color-warning-surface-soft);
}

.ee4v-ui-banner--error {
    border-left-color: var(--ee4v-color-error);
    background-color: var(--ee4v-color-error-surface-soft);
}
