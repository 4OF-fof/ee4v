.ee4v-ui-view-toggle-tabs {
    flex-direction: row;
    align-self: center;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    min-width: 0;
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: var(--ee4v-color-surface-subtle);
}

.ee4v-ui-view-toggle-tabs__tab {
    min-height: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--ee4v-color-transparent);
}

.ee4v-ui-view-toggle-tabs__tab:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-view-toggle-tabs__tab--selected {
    background-color: var(--ee4v-color-tool-active);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-view-toggle-tabs__tab--selected:hover {
    background-color: var(--ee4v-color-tool-active-hover);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-view-toggle-tabs__tab-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 0;
}

.ee4v-ui-view-toggle-tabs__label {
    min-width: 0;
}
