.ee4v-ui-input-field {
    align-self: stretch;
    min-width: 0;
    margin-bottom: 10px;
}

.ee4v-ui-input-field__label {
    margin-bottom: 4px;
    color: rgba(210, 210, 210, 0.78);
    font-size: 12px;
}

.ee4v-ui-input-field__field-container {
    align-self: stretch;
    min-width: 0;
    min-height: 24px;
    height: 24px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0.22);
}

.ee4v-ui-input-field--multiline .ee4v-ui-input-field__field-container {
    min-height: 72px;
    height: auto;
    padding-top: 5px;
    padding-bottom: 5px;
    overflow: hidden;
}

.ee4v-ui-input-field__field-container--focused {
    border-top-color: rgba(86, 156, 214, 0.6);
    border-right-color: rgba(86, 156, 214, 0.6);
    border-bottom-color: rgba(86, 156, 214, 0.6);
    border-left-color: rgba(86, 156, 214, 0.6);
    background-color: rgba(0, 0, 0, 0.30);
}

.ee4v-ui-input-field__field {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-width: 0;
    min-height: 16px;
    height: 16px;
    max-height: 16px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.ee4v-ui-input-field--multiline .ee4v-ui-input-field__field {
    min-height: 60px;
    height: auto;
    max-height: 10000px;
}

.ee4v-ui-input-field__field .unity-base-field__label,
.ee4v-ui-input-field__field .unity-text-field__label {
    display: none;
}

.ee4v-ui-input-field__field .unity-base-text-field__input,
.ee4v-ui-input-field__field .unity-text-field__input,
.ee4v-ui-input-field__field .unity-base-field__input {
    min-height: 14px;
    height: 14px;
    max-height: 14px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 4px;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(238, 238, 238, 0.92);
    font-size: 12px;
    white-space: normal;
}

.ee4v-ui-input-field--multiline .ee4v-ui-input-field__field .unity-base-text-field__input,
.ee4v-ui-input-field--multiline .ee4v-ui-input-field__field .unity-text-field__input,
.ee4v-ui-input-field--multiline .ee4v-ui-input-field__field .unity-base-field__input {
    min-height: 60px;
    height: auto;
    max-height: 10000px;
    padding-top: 0;
}

.ee4v-ui-input-field--multiline .unity-scroll-view,
.ee4v-ui-input-field--multiline .unity-scroll-view__content-container {
    background-color: rgba(0, 0, 0, 0);
}

.ee4v-ui-input-field--multiline .unity-scroll-view__vertical-scroller,
.ee4v-ui-input-field--multiline .unity-scroller {
    width: 8px;
    min-width: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ee4v-ui-input-field--multiline .unity-scroller__low-button,
.ee4v-ui-input-field--multiline .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    min-height: 0;
    max-height: 0;
}

.ee4v-ui-input-field--multiline .unity-scroller__slider,
.ee4v-ui-input-field--multiline .unity-base-slider__tracker {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.ee4v-ui-input-field--multiline .unity-base-slider__dragger,
.ee4v-ui-input-field--multiline .unity-base-slider__dragger-border,
.ee4v-ui-input-field--multiline .unity-scroller__slider .unity-dragger {
    width: 4px;
    min-width: 4px;
    margin-left: 2px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(190, 190, 190, 0.44);
}
