.ee4v-ui-url-input-field {
    position: relative;
    align-self: stretch;
    min-width: 0;
    margin-bottom: 10px;
}

.ee4v-ui-url-input-field__field-container {
    position: relative;
    align-self: stretch;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
}

.ee4v-ui-url-input-field__field {
    align-self: stretch;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
}

.ee4v-ui-url-input-field__field.unity-base-field,
.ee4v-ui-url-input-field__field.unity-text-field {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
}

.ee4v-ui-url-input-field__field .unity-base-field__label,
.ee4v-ui-url-input-field__field .unity-text-field__label {
    display: none;
}

.ee4v-ui-url-input-field__field .unity-base-text-field__input,
.ee4v-ui-url-input-field__field .unity-text-field__input,
.ee4v-ui-url-input-field__field .unity-base-field__input {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    padding-left: 4px;
    padding-right: 32px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.62);
    border-right-color: rgba(0, 0, 0, 0.62);
    border-bottom-color: rgba(0, 0, 0, 0.62);
    border-left-color: rgba(0, 0, 0, 0.62);
    color: rgba(238, 238, 238, 0.92);
    font-size: 12px;
}

.ee4v-ui-url-input-field__placeholder {
    position: absolute;
    left: 4px;
    right: 34px;
    top: 4px;
    height: 16px;
    color: rgba(185, 185, 185, 0.38);
    font-size: 12px;
    opacity: 0.38;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-ui-url-input-field__open-button {
    position: absolute;
    right: 4px;
    top: 3px;
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.62);
    border-right-color: rgba(0, 0, 0, 0.62);
    border-bottom-color: rgba(0, 0, 0, 0.62);
    border-left-color: rgba(0, 0, 0, 0.62);
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgba(230, 230, 230, 0.86);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.ee4v-ui-url-input-field__open-button:hover {
    color: rgba(255, 255, 255, 0.95);
}
