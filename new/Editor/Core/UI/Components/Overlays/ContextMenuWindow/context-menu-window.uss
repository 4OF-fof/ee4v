.ee4v-ui-context-menu {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: var(--ee4v-color-field);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--ee4v-color-border-strong);
    border-bottom-color: var(--ee4v-color-border-strong);
    border-left-color: var(--ee4v-color-border-strong);
    border-right-color: var(--ee4v-color-border-strong);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    flex-grow: 1;
}

.ee4v-ui-context-menu__item {
    height: 24px;
    min-height: 24px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
}

.ee4v-ui-context-menu__item:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-context-menu__item--disabled,
.ee4v-ui-context-menu__item--disabled:hover {
    background-color: var(--ee4v-color-transparent);
    opacity: 0.45;
}

.ee4v-ui-context-menu__label {
    flex-grow: 1;
    min-width: 0;
    color: var(--ee4v-color-text-primary);
}

.ee4v-ui-context-menu__shortcut {
    margin-left: 24px;
    color: var(--ee4v-color-text-muted);
}

.ee4v-ui-context-menu__separator {
    height: 8px;
    min-height: 8px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    border-top-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
}
