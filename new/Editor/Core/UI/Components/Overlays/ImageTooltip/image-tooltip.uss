.ee4v-ui-image-tooltip {
    flex-grow: 1;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-overlay-border);
    border-right-color: var(--ee4v-color-overlay-border);
    border-bottom-color: var(--ee4v-color-overlay-border);
    border-left-color: var(--ee4v-color-overlay-border);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: var(--ee4v-color-surface-raised);
}

.ee4v-ui-image-tooltip__image {
    flex-shrink: 0;
}

.ee4v-ui-image-tooltip__file-name {
    width: 100%;
    height: 22px;
    margin-top: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-center;
}

.ee4v-ui-image-tooltip__file-name Label {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-center;
}
