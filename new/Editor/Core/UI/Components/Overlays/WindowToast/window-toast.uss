.ee4v-ui-window-toast-host {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 320px;
    max-width: 42%;
    flex-direction: column;
    align-items: stretch;
}

.ee4v-ui-window-toast {
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--ee4v-color-overlay-border);
    border-right-color: var(--ee4v-color-overlay-border);
    border-bottom-color: var(--ee4v-color-overlay-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--ee4v-color-surface-raised);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.ee4v-ui-window-toast--dismissing {
    opacity: 0;
}

.ee4v-ui-window-toast__header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.ee4v-ui-window-toast__header-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ee4v-ui-window-toast__title {
    margin-bottom: 2px;
}

.ee4v-ui-window-toast__message {
    margin-top: 2px;
    color: var(--ee4v-color-text-secondary);
    white-space: normal;
}

.ee4v-ui-window-toast__close {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-soft);
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
}

.ee4v-ui-window-toast__close .ee4v-ui-icon {
    opacity: 0.78;
}

.ee4v-ui-window-toast__close:hover {
    background-color: var(--ee4v-color-surface-hover);
}

.ee4v-ui-window-toast__close:hover .ee4v-ui-icon {
    opacity: 1;
}

.ee4v-ui-window-toast__actions {
    margin-top: 8px;
    flex-direction: row;
    justify-content: flex-end;
}

.ee4v-ui-window-toast__action {
    min-width: 72px;
    height: 22px;
    margin-left: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--ee4v-color-control);
    color: var(--ee4v-color-text-primary);
    -unity-text-align: middle-center;
}

.ee4v-ui-window-toast__action:hover {
    border-top-color: var(--ee4v-color-border-active);
    border-right-color: var(--ee4v-color-border-active);
    border-bottom-color: var(--ee4v-color-border-active);
    border-left-color: var(--ee4v-color-border-active);
    background-color: var(--ee4v-color-control-hover);
}

.ee4v-ui-window-toast__action:active {
    background-color: var(--ee4v-color-control-pressed);
}

.ee4v-ui-window-toast--info {
    border-left-color: var(--ee4v-color-info);
}

.ee4v-ui-window-toast--success {
    border-left-color: var(--ee4v-color-success);
}

.ee4v-ui-window-toast--warning {
    border-left-color: var(--ee4v-color-warning);
}

.ee4v-ui-window-toast--error {
    border-left-color: var(--ee4v-color-error);
}
