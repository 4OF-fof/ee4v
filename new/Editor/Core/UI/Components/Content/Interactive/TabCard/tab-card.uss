.ee4v-ui-tab-card {
    flex-direction: column;
}

.ee4v-ui-tab-card__tabs {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    margin-bottom: -1px;
    justify-content: flex-start;
}

.ee4v-ui-tab-card__tab {
    margin-right: 2px;
    margin-bottom: 0;
    min-height: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-tab-idle);
    color: var(--ee4v-color-text-muted);
    align-self: flex-end;
}

.ee4v-ui-tab-card__tab--selected {
    background-color: var(--ee4v-color-surface-raised);
    border-top-color: var(--ee4v-color-border-active);
    border-left-color: var(--ee4v-color-border-active);
    border-right-color: var(--ee4v-color-border-active);
    border-bottom-color: var(--ee4v-color-surface-raised);
    color: var(--ee4v-color-text-on-state);
}

.ee4v-ui-tab-card__panel {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    background-color: var(--ee4v-color-surface-subtle);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.ee4v-ui-tab-card__content {
    flex-grow: 1;
    flex-direction: column;
}
