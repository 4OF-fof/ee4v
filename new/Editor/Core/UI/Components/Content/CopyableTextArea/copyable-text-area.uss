.ee4v-ui-copyable-text-area {
    position: relative;
    align-self: stretch;
}

.ee4v-ui-copyable-text-area__copy-button {
    position: absolute;
    top: 6px;
    right: 6px;
    min-width: 56px;
    height: 20px;
    padding-left: 7px;
    padding-right: 7px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: var(--ee4v-color-control);
    color: var(--ee4v-color-text-primary);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.ee4v-ui-copyable-text-area__copy-button:hover {
    background-color: var(--ee4v-color-surface-hover-strong);
}

.ee4v-ui-copyable-text-area__copy-button--copied {
    border-top-color: var(--ee4v-color-success-border-soft);
    border-right-color: var(--ee4v-color-success-border-soft);
    border-bottom-color: var(--ee4v-color-success-border-soft);
    border-left-color: var(--ee4v-color-success-border-soft);
    background-color: var(--ee4v-color-success-surface-soft);
    color: var(--ee4v-color-success-text);
}

.ee4v-ui-copyable-text-area__copy-button--copied:hover {
    background-color: var(--ee4v-color-success-surface-hover);
}

.ee4v-ui-copyable-text-area__copy-button:disabled {
    opacity: 0.45;
}

.ee4v-ui-copyable-text-area__field {
    min-height: 132px;
    align-self: stretch;
}

.ee4v-ui-copyable-text-area__field .unity-base-field,
.ee4v-ui-copyable-text-area__field .unity-text-field {
    background-color: var(--ee4v-color-field);
}

.ee4v-ui-copyable-text-area__field .unity-base-text-field__input,
.ee4v-ui-copyable-text-area__field .unity-text-field__input,
.ee4v-ui-copyable-text-area__field .unity-base-field__input {
    white-space: normal;
    background-color: var(--ee4v-color-field);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
