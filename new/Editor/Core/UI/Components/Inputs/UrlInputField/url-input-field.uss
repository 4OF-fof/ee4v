.ee4v-ui-url-input-field {
    position: relative;
    align-self: stretch;
    min-width: 0;
    margin-bottom: 10px;
}

.ee4v-ui-url-input-field__field-container {
    position: relative;
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    padding-left: 6px;
    padding-right: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ee4v-color-border-default);
    border-right-color: var(--ee4v-color-border-default);
    border-bottom-color: var(--ee4v-color-border-default);
    border-left-color: var(--ee4v-color-border-default);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: var(--ee4v-color-field);
}

.ee4v-ui-url-input-field__field-container--focused {
    border-top-color: var(--ee4v-color-focus);
    border-right-color: var(--ee4v-color-focus);
    border-bottom-color: var(--ee4v-color-focus);
    border-left-color: var(--ee4v-color-focus);
    background-color: var(--ee4v-color-field);
}

.ee4v-ui-url-input-field__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 16px;
    min-height: 16px;
    max-height: 16px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
}

.ee4v-ui-url-input-field__field.unity-base-field,
.ee4v-ui-url-input-field__field.unity-text-field {
    height: 16px;
    min-height: 16px;
    max-height: 16px;
}

.ee4v-ui-url-input-field__field .unity-base-field__label,
.ee4v-ui-url-input-field__field .unity-text-field__label {
    display: none;
}

.ee4v-ui-url-input-field__field .unity-base-text-field__input,
.ee4v-ui-url-input-field__field .unity-text-field__input,
.ee4v-ui-url-input-field__field .unity-base-field__input {
    height: 14px;
    min-height: 14px;
    max-height: 14px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 4px;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-primary);
    font-size: 12px;
}

.ee4v-ui-url-input-field__placeholder {
    position: absolute;
    left: 6px;
    right: 28px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    color: var(--ee4v-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ee4v-ui-url-input-field__placeholder Label {
    flex-grow: 1;
    min-height: 16px;
    -unity-text-align: middle-left;
}

.ee4v-ui-url-input-field__open-button {
    width: 18px;
    min-width: 18px;
    max-width: 18px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--ee4v-color-transparent);
    color: var(--ee4v-color-text-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    opacity: 0.86;
}

.ee4v-ui-url-input-field__open-button:hover {
    background-color: var(--ee4v-color-surface-hover-strong);
    color: var(--ee4v-color-text-on-state);
    opacity: 1;
}
