.ee4v-ui-draggable-toggle-group {
    flex-direction: column;
}

.ee4v-ui-draggable-toggle-group--disabled {
    opacity: 0.55;
}

.ee4v-ui-draggable-toggle-group__toggle {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.ee4v-ui-draggable-toggle-group__toggle--disabled {
    opacity: 0.45;
}

.ee4v-ui-draggable-toggle-group__label {
    flex-grow: 0;
    min-width: 0;
}

.ee4v-ui-draggable-toggle-group__standard-toggle {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 0;
}
